---
import type { SupportedLanguage } from "../i18n/ui";
import { ClientRouter } from "astro:transitions";
import "../styles/styles.css";

export interface PreloadImageConfig {
	href: string;
	imagesrcset?: string;
	imagesizes?: string;
	type?: string;
}

export interface Props {
	title?: string;
	description?: string;
	lang?: SupportedLanguage;
	image?: string;
	noIndex?: boolean;
	preloadImage?: string | PreloadImageConfig;
	ogType?: "website" | "article";
	articleMeta?: {
		publishedTime?: string;
		modifiedTime?: string;
		author?: string;
		section?: string;
		tags?: string[];
	};
	schemaGraph?: Record<string, unknown>[];
	showHreflangs?: boolean;
	customHreflangs?: { lang: string; href: string }[];
}

const {
	lang = "pt-BR",
	title = "Gabriel Campos — Desenvolvimento de Software & Sistemas Web",
	description = "Desenvolvimento de software, sistemas web sob medida e integrações de APIs por Gabriel Campos. Código limpo, estabilidade e arquitetura moderna para empresas.",
	image = "/images/og-image.jpg",
	noIndex = false,
	preloadImage,
	ogType = "website",
	articleMeta,
	schemaGraph = [],
	showHreflangs = false,
	customHreflangs,
} = Astro.props;

const siteUrl: string = Astro.site
	? Astro.site.toString().replace(/\/$/, "")
	: "https://gabrielcampos.dev";
const canonical: URL = new URL(Astro.url.pathname, siteUrl);
const ogImage: string | undefined = image
	? new URL(image, siteUrl).toString()
	: undefined;
const ogImageType: string = ogImage?.endsWith(".png")
	? "image/png"
	: ogImage?.endsWith(".webp")
		? "image/webp"
		: "image/jpeg";

const hreflangs = [
	{ lang: "pt-BR", href: `${siteUrl}/pt/` },
	{ lang: "en", href: `${siteUrl}/en/` },
	{ lang: "es", href: `${siteUrl}/es/` },
	{ lang: "x-default", href: `${siteUrl}/pt/` },
];

const siteDescriptions: Record<SupportedLanguage, string> = {
	"pt-BR":
		"Portfólio profissional e desenvolvimento de sistemas web sob medida.",
	en: "Professional portfolio and custom web systems development.",
	es: "Portafolio profesional y desarrollo de sistemas web a medida.",
};

const jobTitles: Record<SupportedLanguage, string> = {
	"pt-BR": "Desenvolvedor de Software",
	en: "Software Engineer",
	es: "Desarrollador de Software",
};

const personDescriptions: Record<SupportedLanguage, string> = {
	"pt-BR":
		"Desenvolvedor de software com foco em engenharia web, sistemas sob medida e integração de serviços.",
	en: "Software developer focused on web engineering, custom systems, and service integrations.",
	es: "Desarrollador de software enfocado en ingeniería web, sistemas a medida e integración de servicios.",
};

const schema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${siteUrl}/#website`,
			url: `${siteUrl}/`,
			name: "Gabriel Campos",
			description: siteDescriptions[lang] ?? siteDescriptions["pt-BR"],
			publisher: {
				"@id": `${siteUrl}/#person`,
			},
		},
		{
			"@type": "Person",
			"@id": `${siteUrl}/#person`,
			name: "Gabriel Campos",
			alternateName: "Gabriel Lopes Campos",
			url: `${siteUrl}/`,
			jobTitle: jobTitles[lang] ?? jobTitles["pt-BR"],
			description:
				personDescriptions[lang] ?? personDescriptions["pt-BR"],
			sameAs: [
				"https://github.com/gbrlcm",
				"https://www.linkedin.com/in/gabriel-lopes-campos",
				"https://x.com/Gabriel07132569",
			],
		},
		...schemaGraph,
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{
			preloadImage && (
				<link
					rel="preload"
					as="image"
					href={typeof preloadImage === "string" ? preloadImage : preloadImage.href}
					imagesrcset={typeof preloadImage === "object" ? preloadImage.imagesrcset : undefined}
					imagesizes={typeof preloadImage === "object" ? preloadImage.imagesizes : undefined}
					type={typeof preloadImage === "object" ? (preloadImage.type ?? "image/webp") : "image/webp"}
					fetchpriority="high"
				/>
			)
		}

		{
			import.meta.env.PROD && (
				<>
					<!-- CookieYes Consent Banner -->
					<script is:inline defer id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/573752ad712e81805ca1f1e5/script.js"></script>

					<!-- Google Tag Manager (GA4 e Meta Pixel ficam no container) - carregamento adiado para preservar o first paint e reduzir TBT -->
					<script is:inline>
						window.dataLayer = window.dataLayer || [];
						window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

						document.addEventListener('astro:page-load', () => {
							if (window.__gaInitialLoadDone) {
								dataLayer.push({
									event: 'pageview',
									page: window.location.pathname,
									url: window.location.href,
									title: document.title,
								});
							} else {
								window.__gaInitialLoadDone = true;
							}
						});

						function loadTracking() {
							if (window.__trackingLoaded) return;
							window.__trackingLoaded = true;

							const gtmScript = document.createElement('script');
							gtmScript.async = true;
							gtmScript.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-5JTPF3RZ';
							document.head.appendChild(gtmScript);
						}

						if ('requestIdleCallback' in window) {
							window.addEventListener('load', () => {
								requestIdleCallback(loadTracking, { timeout: 3000 });
							});
						} else {
							window.addEventListener('load', () => {
								setTimeout(loadTracking, 1500);
							});
						}
						['scroll', 'mousemove', 'touchstart', 'keydown'].forEach((evt) => {
							window.addEventListener(evt, loadTracking, { once: true, passive: true });
						});
					</script>
				</>
			)
		}

		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{!noIndex && <link rel="canonical" href={canonical.href} />}
		{noIndex && <meta name="robots" content="noindex, follow" />}

		{
			!noIndex && customHreflangs && customHreflangs.length > 0 &&
				customHreflangs.map((item) => (
					<link rel="alternate" hreflang={item.lang} href={item.href} />
				))
		}
		{
			!noIndex && !customHreflangs &&
				(showHreflangs || Astro.url.pathname === "/pt/" || Astro.url.pathname === "/en/" || Astro.url.pathname === "/es/") &&
				hreflangs.map((item) => (
					<link rel="alternate" hreflang={item.lang} href={item.href} />
				))
		}

		<meta property="og:type" content={ogType} />
		{ogType === "article" && articleMeta?.publishedTime && (
			<meta property="article:published_time" content={articleMeta.publishedTime} />
		)}
		{ogType === "article" && articleMeta?.modifiedTime && (
			<meta property="article:modified_time" content={articleMeta.modifiedTime} />
		)}
		{ogType === "article" && articleMeta?.author && (
			<meta property="article:author" content={articleMeta.author} />
		)}
		{ogType === "article" && articleMeta?.section && (
			<meta property="article:section" content={articleMeta.section} />
		)}
		{ogType === "article" && articleMeta?.tags?.map((tag) => (
			<meta property="article:tag" content={tag} />
		))}
		<meta property="og:site_name" content="Gabriel Campos" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		<meta
			property="og:locale"
			content={lang === "pt-BR" ? "pt_BR" : lang === "es" ? "es_ES" : "en_US"}
		/>
		{
			ogImage && (
				<>
					<meta property="og:image" content={ogImage} />
					<meta property="og:image:secure_url" content={ogImage} />
					<meta property="og:image:type" content={ogImageType} />
					<meta property="og:image:alt" content={title} />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
				</>
			)
		}

		<meta
			name="twitter:card"
			content={ogImage ? "summary_large_image" : "summary"}
		/>
		<meta name="twitter:creator" content="@Gabriel07132569" />
		<meta name="twitter:site" content="@Gabriel07132569" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="author" href="/humans.txt" />
		<meta name="theme-color" content="#0d1117" />

		<!-- Local Self-Hosted Fonts Preload -->
		<link
			rel="preload"
			href="/fonts/outfit-v15-latin-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/anton-v27-latin-regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		{
			!noIndex && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(schema)}
				/>
			)
		}

		<ClientRouter />
	</head>
	<body class="min-h-screen bg-task-bg text-task-dark antialiased">
		<slot />
	</body>
</html>
