---
import { Icon } from 'astro-icon/components';

export interface CarouselItem {
	id?: string | number;
	label?: string;
	title: string;
	desc?: string;
	image: string;
	href?: string;
	ctaText?: string;
	ctaTextShort?: string;
}

export interface Props {
	items: CarouselItem[];
	id?: string;
	prevBtnId?: string;
	nextBtnId?: string;
	variant?: 'multi-browse' | 'hero' | 'uncontained';
	cardHeight?: string;
	showControls?: boolean;
	showIndicators?: boolean;
	class?: string;
}

const {
	items = [],
	id = 'm3-carousel-' + Math.random().toString(36).substring(2, 9),
	prevBtnId,
	nextBtnId,
	variant = 'multi-browse',
	cardHeight = 'h-[460px] sm:h-[480px] md:h-[500px]',
	showControls = true,
	showIndicators = true,
	class: className = '',
} = Astro.props;
---

<div
	class:list={['m3-carousel-root relative w-full select-none', className]}
	id={id}
	data-total-items={items.length}
	data-variant={variant}
	data-prev-id={prevBtnId}
	data-next-id={nextBtnId}
>
	<!-- Top Controls (Optional Header Bar or Integrated Controls) -->
	{
		showControls && (
			<div class="mb-6 flex items-center justify-between gap-4">
				<div class="flex items-center gap-2">
					<span class="inline-flex items-center gap-1.5 rounded-full bg-task-yellow/15 px-3 py-1 font-outfit text-xs font-semibold text-task-yellow">
						<span class="size-1.5 rounded-full bg-task-yellow animate-pulse" />
						Material Design 3 • CarouselView
					</span>
				</div>

				<div class="flex items-center gap-2">
					<button
						type="button"
						class="m3-btn-prev flex size-12 items-center justify-center rounded-2xl bg-white/10 text-white backdrop-blur-md transition-all duration-200 hover:bg-task-yellow hover:text-task-dark active:scale-90 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-white/10 disabled:hover:text-white"
						aria-label="Item anterior"
					>
						<Icon name="lucide:arrow-left" class="size-5" />
					</button>
					<button
						type="button"
						class="m3-btn-next flex size-12 items-center justify-center rounded-2xl bg-white/10 text-white backdrop-blur-md transition-all duration-200 hover:bg-task-yellow hover:text-task-dark active:scale-90 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-white/10 disabled:hover:text-white"
						aria-label="Próximo item"
					>
						<Icon name="lucide:arrow-right" class="size-5" />
					</button>
				</div>
			</div>
		)
	}

	<!-- Carousel Viewport & Drag Canvas -->
	<div
		class="m3-carousel-viewport relative w-full cursor-grab overflow-hidden active:cursor-grabbing focus:outline-hidden"
		tabindex="0"
		role="region"
		aria-label="Carrossel Material Design 3"
	>
		<!-- Continuous Flex Track -->
		<div
			class="m3-carousel-track flex w-full items-stretch py-2 transition-none"
			style="gap: 0px;"
		>
			{
				items.map((item, index) => (
					<div
						class:list={[
							'm3-carousel-card group relative shrink-0 overflow-hidden transition-none will-change-[width,border-radius]',
							cardHeight,
						]}
						data-index={index}
						role="group"
						aria-roledescription="slide"
						aria-label={`Slide ${index + 1} de ${items.length}: ${item.title}`}
						title={item.title}
						style="width: 0px; border-radius: 32px;"
					>
						<!-- Outer Mask Container -->
						<div class="relative size-full overflow-hidden">
							<!-- Background Image with Ambient Zoom on Hover -->
							<img
								src={item.image}
								alt={item.title}
								title={item.title}
								class="pointer-events-none absolute inset-0 size-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
								loading={index === 0 ? 'eager' : 'lazy'}
								draggable="false"
							/>

							<!-- Gradient Scrim for Readability -->
							<div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/90 via-black/35 to-black/10" />

							<!-- Top Badge (Anchored, Fades smoothly) -->
							{item.label && (
								<div class="m3-card-badge pointer-events-none absolute top-5 left-5 z-10 transition-opacity duration-300">
									<span class="inline-flex rounded-full bg-white/25 px-4 py-1.5 font-outfit text-xs font-semibold tracking-wide text-white backdrop-blur-md shadow-xs">
										{item.label}
									</span>
								</div>
							)}

							<!-- Bottom Content: Title, Description & Action -->
							<div class="m3-card-content pointer-events-none absolute inset-x-0 bottom-0 z-10 flex flex-col justify-end p-6 md:p-8 transition-opacity duration-200">
								<!-- Title -->
								<h3 class="m3-card-title font-anton text-2xl leading-tight text-white sm:text-3xl lg:text-[34px] drop-shadow-sm">
									{item.title}
								</h3>

								<!-- Description -->
								{item.desc && (
									<p class="m3-card-desc mt-2.5 font-outfit text-sm leading-relaxed text-white/80 line-clamp-2">
										{item.desc}
									</p>
								)}

								<!-- Read more Pill Button -->
								<div class="m3-card-cta mt-6 pointer-events-auto">
									<a
										href={item.href || '#'}
										class="group/btn inline-flex items-center gap-3 rounded-full bg-task-yellow px-6 py-3 font-outfit text-sm font-semibold text-task-dark shadow-md transition-all duration-200 hover:brightness-105 hover:shadow-lg active:scale-95"
									>
										<span class="sm:hidden">{item.ctaTextShort || item.ctaText || 'Saiba mais'}</span>
										<span class="hidden sm:inline">{item.ctaText || 'Saiba mais'}</span>
										<Icon
											name="lucide:arrow-right"
											class="size-4.5 transition-transform duration-200 group-hover/btn:translate-x-0.5"
										/>
									</a>
								</div>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>

	<!-- Bottom Indicators (M3 Morphing Pill Pagination) -->
	{
		showIndicators && (
			<div class="m3-carousel-indicators mt-6 flex items-center justify-center gap-1" role="tablist" aria-label="Indicadores de slides">
				{items.map((_, index) => (
					<button
						type="button"
						class="m3-indicator-btn flex size-12 items-center justify-center rounded-full transition-transform focus:outline-hidden focus-visible:ring-2 focus-visible:ring-task-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-task-dark"
						data-target-index={index}
						aria-label={`Ir para o slide ${index + 1}`}
						aria-current={index === 0 ? 'true' : 'false'}
					>
						<span
							class="m3-indicator-dot pointer-events-none block h-2 rounded-full transition-all duration-300 ease-[cubic-bezier(0.2,0,0,1)]"
							style={index === 0 ? 'width: 28px; background-color: var(--color-task-yellow, #f6ed5b);' : 'width: 8px; background-color: rgba(255, 255, 255, 0.3);'}
						/>
					</button>
				))}
			</div>
		)
	}
</div>

<script>
	class Material3Carousel {
		private root: HTMLElement;
		private viewport: HTMLElement;
		private track: HTMLElement;
		private cards: HTMLElement[];
		private prevBtn: HTMLButtonElement | null;
		private nextBtn: HTMLButtonElement | null;
		private indicatorBtns: HTMLButtonElement[];
		private indicatorDots: HTMLElement[];
		private totalItems: number;

		// Scroll state: continuous float index in [0, totalItems - 1]
		private S: number = 0;
		private animationId: number | null = null;

		// Gestures
		private isPointerDown: boolean = false;
		private isDragging: boolean = false;
		private isDirectionLocked: boolean = false;
		private isVerticalScroll: boolean | null = null;
		private startX: number = 0;
		private startY: number = 0;
		private startS: number = 0;
		private lastX: number = 0;
		private lastTime: number = 0;
		private velocity: number = 0;
		private wheelTimer: any = null;

		// Dimensions cache
		private containerWidth: number = 0;
		private gap: number = 16;
		private WS: number = 70;
		private WL: number = 380;
		// How many cards fit side by side: single card on mobile,
		// hero + 2 peeks from tablet up.
		private maxVisible: number = 3;

		// Pixels of drag/wheel needed to advance one slide
		private get stepPx(): number {
			return this.WL * (this.maxVisible === 1 ? 0.5 : 0.6) + this.gap;
		}

		constructor(root: HTMLElement) {
			this.root = root;
			this.viewport = root.querySelector('.m3-carousel-viewport') as HTMLElement;
			this.track = root.querySelector('.m3-carousel-track') as HTMLElement;
			this.cards = Array.from(root.querySelectorAll('.m3-carousel-card')) as HTMLElement[];
			const prevId = root.dataset.prevId;
			const nextId = root.dataset.nextId;
			this.prevBtn = prevId
				? (document.getElementById(prevId) as HTMLButtonElement)
				: root.querySelector('.m3-btn-prev');
			this.nextBtn = nextId
				? (document.getElementById(nextId) as HTMLButtonElement)
				: root.querySelector('.m3-btn-next');
			this.indicatorBtns = Array.from(root.querySelectorAll('.m3-indicator-btn')) as HTMLButtonElement[];
			this.indicatorDots = Array.from(root.querySelectorAll('.m3-indicator-dot')) as HTMLElement[];
			this.totalItems = this.cards.length;

			if (!this.viewport || !this.track || this.totalItems === 0) return;

			this.init();
		}

		private init() {
			this.calculateSizes();
			this.render(0);

			this.bindEvents();
		}

		private calculateSizes() {
			const width = this.viewport.clientWidth || this.root.clientWidth || 360;
			this.containerWidth = width;

			// Mobile shows a single full width card, navigated by button or swipe.
			if (width < 640) {
				this.maxVisible = 1;
				this.gap = 12;
				this.WS = Math.min(Math.max(Math.round(width * 0.14), 46), 72);
			} else if (width < 1024) {
				this.maxVisible = 3;
				this.gap = 16;
				this.WS = Math.min(Math.max(Math.round(width * 0.15), 90), 130);
			} else {
				this.maxVisible = 3;
				this.gap = 20;
				this.WS = Math.min(Math.max(Math.round(width * 0.13), 110), 150);
			}

			this.WL = Math.max(
				140,
				width - (this.maxVisible - 1) * (this.gap + this.WS)
			);
		}

		/**
		 * Resting layout (width + trailing margin) of every card for the
		 * integer anchor k. The Large hero absorbs the leftover space, so
		 * widths + gaps always add up to exactly `containerWidth`.
		 */
		private restLayout(k: number): { width: number; margin: number }[] {
			const N = this.totalItems;
			const C = this.containerWidth;
			const out = Array.from({ length: N }, () => ({ width: 0, margin: 0 }));

			if (k < 0 || k >= N) return out;

			// One card on mobile, hero + peeks from tablet up
			const count = Math.min(this.maxVisible, N - k);
			const hero = C - (count - 1) * (this.gap + this.WS);

			for (let i = 0; i < count; i++) {
				out[k + i].width = i === 0 ? hero : this.WS;
				out[k + i].margin = i === count - 1 ? 0 : this.gap;
			}

			return out;
		}

		/**
		 * Material Design 3 Multi-Browse layout.
		 * S is the continuous scroll offset (0 to N - 1). A single full width
		 * card on mobile; hero plus the Small cards peeking on its right from
		 * tablet up. The row is a linear interpolation between the two
		 * surrounding resting layouts, which keeps the total width locked to
		 * `containerWidth` and the row anchored at the left edge, aligned with
		 * the surrounding content.
		 */
		private layout(S: number): { width: number; margin: number; opacity: number }[] {
			const N = this.totalItems;
			const k = Math.min(N - 1, Math.max(0, Math.floor(S)));
			const t = Math.max(0, Math.min(1, S - k));

			const from = this.restLayout(k);
			const to = this.restLayout(Math.min(k + 1, N - 1));

			return from.map((a, i) => ({
				width: a.width + (to[i].width - a.width) * t,
				margin: a.margin + (to[i].margin - a.margin) * t,
				// Outgoing hero fades out while collapsing, so it never pops away
				opacity: i === k ? Math.max(0, Math.min(1, (1 - t) / 0.4)) : 1,
			}));
		}

		/**
		 * Renders the carousel at current continuous position S.
		 * Updates widths, spacing, masks, border-radii, text fading and controls.
		 */
		private render(S: number) {
			this.S = S;
			const N = this.totalItems;
			const sizes = this.layout(S);
			// Reference width for the Small -> Large text fade: the resting hero width,
// so text stays fully revealed on the resting card and fades in as a card grows.
			const heroRef = Math.max(this.WL, ...sizes.map((s) => s.width));

			// Handle each card
			for (let i = 0; i < N; i++) {
				const card = this.cards[i];
				const { width: w, margin, opacity } = sizes[i];

				if (w <= 0.5) {
					card.style.display = 'none';
					card.style.width = '0px';
					card.style.marginRight = '0px';
					continue;
				}

				card.style.display = 'block';
				card.style.width = `${w.toFixed(1)}px`;
				card.style.marginRight = `${margin.toFixed(1)}px`;
				card.style.opacity = opacity.toFixed(2);
				card.style.pointerEvents = opacity < 0.35 ? 'none' : 'auto';

				// Dynamic M3 Corner Radius
				// Hero keeps 32px; small pills gracefully adapt to min(32, w / 2)
				const radius = w >= this.WS * 1.8 ? 32 : Math.max(16, Math.min(32, w / 2));
				card.style.borderRadius = `${radius.toFixed(1)}px`;

				// Content Masking & Text fading driven by the width progress
				// between the Small peek (0) and the Large hero (1).
				const progress = Math.max(0, Math.min(1, (w - this.WS) / (heroRef - this.WS)));

				const content = card.querySelector('.m3-card-content') as HTMLElement;
				const title = card.querySelector('.m3-card-title') as HTMLElement;
				const badge = card.querySelector('.m3-card-badge') as HTMLElement;
				const desc = card.querySelector('.m3-card-desc') as HTMLElement;
				const cta = card.querySelector('.m3-card-cta') as HTMLElement;

				if (content) {
					// Peek card keeps only the image mask
					const expanded = progress > 0.02;
					content.style.opacity = expanded ? '1' : '0';
					content.style.pointerEvents = expanded ? 'auto' : 'none';

					if (title) title.style.opacity = progress.toFixed(2);
					if (badge) badge.style.opacity = progress > 0.3 ? '1' : '0';

					// Secondary elements fade after the title
					const secondary = Math.max(0, progress * 1.6 - 0.6);
					if (desc) {
						desc.style.opacity = secondary.toFixed(2);
						desc.style.display = secondary > 0.05 ? 'block' : 'none';
					}
					if (cta) {
						cta.style.opacity = secondary.toFixed(2);
						cta.style.pointerEvents = secondary > 0.5 ? 'auto' : 'none';
					}
				}
			}

			// Update Prev / Next buttons state
			const activeIndex = Math.round(S);
			if (this.prevBtn) {
				const isAtStart = activeIndex <= 0;
				this.prevBtn.disabled = isAtStart;
				this.prevBtn.style.opacity = isAtStart ? '0.35' : '1';
				this.prevBtn.style.cursor = isAtStart ? 'not-allowed' : 'pointer';
			}
			if (this.nextBtn) {
				const isAtEnd = activeIndex >= N - 1;
				this.nextBtn.disabled = isAtEnd;
				this.nextBtn.style.opacity = isAtEnd ? '0.35' : '1';
				this.nextBtn.style.cursor = isAtEnd ? 'not-allowed' : 'pointer';
			}

			// Update M3 Indicator Dots (morphing active pill)
			if (this.indicatorDots.length > 0) {
				const activeIndex = Math.round(S);
				this.indicatorBtns.forEach((btn, index) => {
					btn.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
				});
				this.indicatorDots.forEach((dot, index) => {
					const dist = Math.abs(S - index);
					if (dist < 0.5) {
						// Active or transitioning to active
						const pillWidth = 28 - dist * 20;
						dot.style.width = `${Math.max(8, pillWidth)}px`;
						dot.style.backgroundColor = 'var(--color-task-yellow, #f6ed5b)';
					} else {
						dot.style.width = '8px';
						dot.style.backgroundColor = 'rgba(255, 255, 255, 0.3)';
					}
				});
			}
		}

		/**
		 * Smooth physics animation to target index with M3 Emphasized deceleration.
		 */
		public animateTo(target: number, duration: number = 420) {
			if (this.animationId !== null) {
				cancelAnimationFrame(this.animationId);
				this.animationId = null;
			}

			const clampedTarget = Math.max(0, Math.min(this.totalItems - 1, target));
			const startS = this.S;
			const deltaS = clampedTarget - startS;

			if (Math.abs(deltaS) < 0.005) {
				this.render(clampedTarget);
				return;
			}

			const startTime = performance.now();

			const step = (now: number) => {
				const elapsed = now - startTime;
				const p = Math.min(1, elapsed / duration);

				// Material 3 Emphasized Decelerate cubic easing: f(p) = 1 - (1 - p)^3.5
				const eased = 1 - Math.pow(1 - p, 3.5);
				const current = startS + deltaS * eased;

				this.render(current);

				if (p < 1) {
					this.animationId = requestAnimationFrame(step);
				} else {
					this.animationId = null;
					this.render(clampedTarget);
				}
			};

			this.animationId = requestAnimationFrame(step);
		}

		private bindEvents() {
			// Window resize
			const onResize = () => {
				this.calculateSizes();
				this.render(this.S);
			};
			window.addEventListener('resize', onResize);

			// Prev / Next Buttons
			this.prevBtn?.addEventListener('click', () => {
				this.animateTo(Math.round(this.S) - 1);
			});
			this.nextBtn?.addEventListener('click', () => {
				this.animateTo(Math.round(this.S) + 1);
			});

			// Indicator Buttons Click
			this.indicatorBtns.forEach((btn, index) => {
				btn.addEventListener('click', () => {
					this.animateTo(index);
				});
			});

			// Card Click (focus clicked card)
			this.cards.forEach((card, index) => {
				card.addEventListener('click', (e) => {
					// Ignore if clicking an active button/link or if was dragging
					if (this.isDragging) return;
					const target = e.target as HTMLElement;
					if (target.closest('a') || target.closest('button')) return;
					if (Math.round(this.S) !== index) {
						this.animateTo(index);
					}
				});
			});

			// Keyboard Navigation
			this.viewport.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') {
					e.preventDefault();
					this.animateTo(Math.round(this.S) - 1);
				} else if (e.key === 'ArrowRight') {
					e.preventDefault();
					this.animateTo(Math.round(this.S) + 1);
				} else if (e.key === 'Home') {
					e.preventDefault();
					this.animateTo(0);
				} else if (e.key === 'End') {
					e.preventDefault();
					this.animateTo(this.totalItems - 1);
				}
			});

			// Wheel / Trackpad horizontal scroll
			this.viewport.addEventListener(
				'wheel',
				(e) => {
					const absX = Math.abs(e.deltaX);
					const absY = Math.abs(e.deltaY);

					if (absX > absY) {
						e.preventDefault();
						if (this.animationId) {
							cancelAnimationFrame(this.animationId);
							this.animationId = null;
						}

let deltaS = e.deltaX / this.stepPx;
						let newS = this.S + deltaS;

						// Clamp with damping
						if (newS < 0) newS = newS * 0.2;
						else if (newS > this.totalItems - 1)
							newS = this.totalItems - 1 + (newS - (this.totalItems - 1)) * 0.2;

						this.render(newS);

						clearTimeout(this.wheelTimer);
						this.wheelTimer = setTimeout(() => {
							this.animateTo(Math.round(this.S));
						}, 120);
					}
				},
				{ passive: false }
			);

			// Pointer (Mouse drag & Touch swipe)
			const onPointerDown = (clientX: number, clientY: number) => {
				if (this.animationId) {
					cancelAnimationFrame(this.animationId);
					this.animationId = null;
				}
				this.isPointerDown = true;
				this.isDragging = false;
				this.isDirectionLocked = false;
				this.isVerticalScroll = null;
				this.startX = clientX;
				this.startY = clientY;
				this.startS = this.S;
				this.lastX = clientX;
				this.lastTime = performance.now();
				this.velocity = 0;
			};

			const onPointerMove = (clientX: number, clientY: number, e: Event) => {
				if (!this.isPointerDown) return;

				const dx = clientX - this.startX;
				const dy = clientY - this.startY;

				if (!this.isDirectionLocked) {
					if (Math.abs(dx) > 6 || Math.abs(dy) > 6) {
						this.isDirectionLocked = true;
						this.isVerticalScroll = Math.abs(dy) > Math.abs(dx);
					}
				}

				if (this.isDirectionLocked && !this.isVerticalScroll) {
					if (e.cancelable) e.preventDefault();
					this.isDragging = true;

					const now = performance.now();
					const dt = now - this.lastTime;
					if (dt > 10) {
						this.velocity = (clientX - this.lastX) / dt;
						this.lastX = clientX;
						this.lastTime = now;
					}

					let targetS = this.startS - dx / this.stepPx;

					// Overscroll rubber-band resistance
					if (targetS < 0) {
						targetS = targetS * 0.25;
					} else if (targetS > this.totalItems - 1) {
						targetS = this.totalItems - 1 + (targetS - (this.totalItems - 1)) * 0.25;
					}

					this.render(targetS);
				}
			};

			const onPointerUp = () => {
				if (!this.isPointerDown) return;
				this.isPointerDown = false;

				if (this.isDragging) {
					let snapTarget = Math.round(this.S);

					// Velocity snap (flick gesture)
					if (Math.abs(this.velocity) > 0.3) {
						if (this.velocity < -0.3) {
							snapTarget = Math.ceil(this.S);
						} else if (this.velocity > 0.3) {
							snapTarget = Math.floor(this.S);
						}
					}

					this.animateTo(snapTarget);
					setTimeout(() => {
						this.isDragging = false;
					}, 50);
				}
			};

			// Touch Events
			this.viewport.addEventListener(
				'touchstart',
				(e: TouchEvent) => {
					if (e.touches.length === 1) {
						onPointerDown(e.touches[0].clientX, e.touches[0].clientY);
					}
				},
				{ passive: true }
			);

			this.viewport.addEventListener(
				'touchmove',
				(e: TouchEvent) => {
					if (e.touches.length === 1) {
						onPointerMove(e.touches[0].clientX, e.touches[0].clientY, e);
					}
				},
				{ passive: false }
			);

			this.viewport.addEventListener('touchend', onPointerUp, { passive: true });
			this.viewport.addEventListener('touchcancel', onPointerUp, { passive: true });

			// Mouse Drag
			this.viewport.addEventListener('mousedown', (e: MouseEvent) => {
				if (e.button !== 0) return;
				onPointerDown(e.clientX, e.clientY);
			});

			window.addEventListener('mousemove', (e: MouseEvent) => {
				if (this.isPointerDown) {
					onPointerMove(e.clientX, e.clientY, e);
				}
			});

			window.addEventListener('mouseup', () => {
				if (this.isPointerDown) {
					onPointerUp();
				}
			});
		}
	}

	function setupM3Carousels() {
		const roots = document.querySelectorAll<HTMLElement>('.m3-carousel-root');
		if (!roots.length) return;

		const init = () => {
			roots.forEach((root) => {
				if (!(root as any).__m3_carousel_initialized) {
					(root as any).__m3_carousel_initialized = true;
					new Material3Carousel(root);
				}
			});
		};

		if ('requestIdleCallback' in window) {
			(window as any).requestIdleCallback(init, { timeout: 1500 });
		} else {
			setTimeout(init, 50);
		}
	}

	setupM3Carousels();
	document.addEventListener('astro:page-load', setupM3Carousels);
</script>

<style>
	.m3-carousel-viewport {
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}

	.m3-carousel-card {
		transform: translateZ(0);
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}
</style>
