---
import { Icon } from 'astro-icon/components';
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
	lang: SupportedLanguage;
	align?: 'left' | 'center';
	class?: string;
}

const { lang, align = 'left', class: className = '' } = Astro.props;
const t = useTranslations(lang)();

const coreLanguages = [
	{
		name: 'TypeScript',
		icon: 'simple-icons:typescript',
		hoverText: 'group-hover:text-[#3178c6]',
		hoverBorder: 'hover:border-[#3178c6]/40',
	},
	{
		name: 'Go',
		icon: 'simple-icons:go',
		hoverText: 'group-hover:text-[#00add8]',
		hoverBorder: 'hover:border-[#00add8]/40',
	},
	{
		name: 'Java',
		icon: 'java',
		hoverText: 'group-hover:text-[#ed8b00]',
		hoverBorder: 'hover:border-[#ed8b00]/40',
	},
	{
		name: 'C#',
		icon: 'simple-icons:csharp',
		hoverText: 'group-hover:text-[#9b4993]',
		hoverBorder: 'hover:border-[#9b4993]/40',
	},
	{
		name: 'PHP',
		icon: 'simple-icons:php',
		hoverText: 'group-hover:text-[#777bb4]',
		hoverBorder: 'hover:border-[#777bb4]/40',
	},
	{
		name: 'Python',
		icon: 'simple-icons:python',
		hoverText: '',
		hoverBorder: 'hover:border-[#3776ab]/40',
	},
];
---

<div
	class={`mt-6 w-full pt-5 border-t border-task-border/70 flex flex-col gap-3 ${
		align === 'center' ? 'items-center text-center' : 'items-start text-left'
	} ${className}`}
>
	<span class="font-outfit text-xs font-semibold uppercase tracking-wider text-task-gray">
		{t.hero.languagesLabel}
	</span>
	<div
		class={`flex flex-wrap items-center gap-2.5 sm:gap-3 ${
			align === 'center' ? 'justify-center' : 'justify-start'
		}`}
	>
		{
			coreLanguages.map((tech) => (
				<div
					class={`group relative flex size-10 sm:size-13 items-center justify-center rounded-2xl border border-task-border bg-white shadow-2xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xs ${tech.hoverBorder}`}
					title={tech.name}
					role="img"
					aria-label={tech.name}
				>
					{tech.name === 'Python' ? (
						<svg
							viewBox="0 0 128 128"
							class="size-5 sm:size-5.5 transition-transform duration-200 group-hover:scale-115"
							aria-hidden="true"
						>
							<path
								fill="currentColor"
								class="text-task-dark/75 transition-colors duration-200 group-hover:text-[#3776ab]"
								d="M63.391 1.988c-4.222.02-8.252.379-11.8 1.007-10.45 1.846-12.346 5.71-12.346 12.837v9.411h24.693v3.137H29.977c-7.176 0-13.46 4.313-15.426 12.521-2.268 9.405-2.368 15.275 0 25.096 1.755 7.311 5.947 12.519 13.124 12.519h8.491V67.234c0-8.151 7.051-15.34 15.426-15.34h24.665c6.866 0 12.346-5.654 12.346-12.548V15.833c0-6.693-5.646-11.72-12.346-12.837-4.244-.706-8.645-1.027-12.866-1.008zM50.037 9.557c2.55 0 4.634 2.117 4.634 4.721 0 2.593-2.083 4.69-4.634 4.69-2.56 0-4.633-2.097-4.633-4.69-.001-2.604 2.073-4.721 4.633-4.721z"
								transform="translate(0 10.26)"
							/>
							<path
								fill="currentColor"
								class="text-task-dark/75 transition-colors duration-200 group-hover:text-[#ffd43b]"
								d="M91.682 28.38v10.966c0 8.5-7.208 15.655-15.426 15.655H51.591c-6.756 0-12.346 5.783-12.346 12.549v23.515c0 6.691 5.818 10.628 12.346 12.547 7.816 2.297 15.312 2.713 24.665 0 6.216-1.801 12.346-5.423 12.346-12.547v-9.412H63.938v-3.138h37.012c7.176 0 9.852-5.005 12.348-12.519 2.578-7.735 2.467-15.174 0-25.096-1.774-7.145-5.161-12.521-12.348-12.521h-9.268zM77.809 87.927c2.561 0 4.634 2.097 4.634 4.692 0 2.602-2.074 4.719-4.634 4.719-2.55 0-4.633-2.117-4.633-4.719 0-2.595 2.083-4.692 4.633-4.692z"
								transform="translate(0 10.26)"
							/>
						</svg>
					) : (
						<Icon
							name={tech.icon}
							class={`size-5 sm:size-5.5 text-task-dark/75 transition-all duration-200 group-hover:scale-115 ${tech.hoverText}`}
						/>
					)}
				</div>
			))
		}
	</div>
</div>
