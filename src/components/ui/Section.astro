---
export interface Props {
	id?: string;
	label: string;
	title?: string;
	lede?: string;
	flush?: boolean;
	class?: string;
}

const { id, label, title, lede, flush = false, class: className = '' } = Astro.props;
---

<section id={id} class:list={['scroll-mt-28', flush ? 'py-0' : 'py-20 md:py-28', className]}>
	<div class="flex flex-col gap-4 border-b border-(--line) pb-8 md:flex-row md:items-end md:justify-between">
		<div class="flex flex-col gap-3">
			<p class="label">{label}</p>
			{title && <h2 class="font-display text-(--text-title) leading-[1.05] tracking-tight">{title}</h2>}
		</div>
		{lede && <p class="max-w-sm text-(--text-title) leading-snug text-(--fg-muted)">{lede}</p>}
	</div>

	<div class="pt-10">
		<slot />
	</div>
</section>
