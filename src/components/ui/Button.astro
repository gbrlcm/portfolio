---
export type Variant = 'primary' | 'outline' | 'ghost';
export type Size = 'sm' | 'md' | 'lg';

export interface Props {
	href?: string;
	variant?: Variant;
	size?: Size;
	external?: boolean;
	class?: string;
	id?: string;
}

const {
	href,
	variant = 'primary',
	size = 'md',
	external = false,
	class: className = '',
	id,
} = Astro.props;

const variants: Record<Variant, string> = {
	primary:
		'bg-(--accent) text-(--accent-fg) hover:bg-(--accent-dim) border border-transparent',
	outline:
		'border border-(--line-strong) text-(--fg) hover:border-(--accent) hover:text-(--accent)',
	ghost: 'border border-transparent text-(--fg-muted) hover:text-(--fg)',
};

const sizes: Record<Size, string> = {
	sm: 'px-4 py-2 text-xs tracking-wide',
	md: 'px-6 py-3 text-sm',
	lg: 'px-8 py-4 text-sm tracking-wide',
};

const classes = [
	'inline-flex items-center justify-center gap-2 rounded-full font-medium uppercase',
	'transition-all duration-300 ease-(--ease-out-expo)',
	'hover:-translate-y-0.5 active:translate-y-0',
	variants[variant],
	sizes[size],
	className,
];

const Tag = href ? 'a' : 'button';
---

<Tag
	id={id}
	class:list={[classes]}
	{...(href ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) } : { type: 'button' })}
>
	<slot />
</Tag>
