---
import { Icon } from 'astro-icon/components';

interface PaymentItem {
	name: string;
	icon: string;
}

const paymentMethods: PaymentItem[] = [
	{ name: 'Pix', icon: 'simple-icons:pix' },
	{ name: 'Boleto', icon: 'boleto' },
	{ name: 'Visa', icon: 'simple-icons:visa' },
	{ name: 'Mastercard', icon: 'simple-icons:mastercard' },
	{ name: 'Elo', icon: 'elo' },
	{ name: 'American Express', icon: 'simple-icons:americanexpress' },
	{ name: 'Bitcoin', icon: 'simple-icons:bitcoin' },
	{ name: 'Ethereum', icon: 'simple-icons:ethereum' },
	{ name: 'Solana', icon: 'simple-icons:solana' },
	{ name: 'TRON', icon: 'tron' },
];

// Duplicamos a lista para garantir comprimento suficiente mesmo em telas ultrawide
const items = [...paymentMethods, ...paymentMethods];

export interface Props {
	class?: string;
	ariaLabel?: string;
}

const {
	class: className = '',
	ariaLabel = 'Métodos de pagamento aceitos: Pix, Boleto, Cartões de Crédito e Criptomoedas',
} = Astro.props;
---

<div
	class={`relative w-full overflow-hidden select-none [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] ${className}`}
	role="group"
	aria-label={ariaLabel}
>
	<div class="animate-marquee flex w-max items-center py-2">
		<!-- Primeira faixa -->
		<div class="flex shrink-0 items-center gap-10 sm:gap-14 pr-10 sm:pr-14">
			{
				items.map((item) => (
					<div
						class="group flex items-center gap-2.5 sm:gap-3 transition-transform duration-200 hover:scale-110"
						title={item.name}
					>
						<Icon
							name={item.icon}
							class="size-7 sm:size-8 text-[#9ea8a3] transition-colors duration-200 group-hover:text-task-dark shrink-0"
						/>
						<span class="font-outfit text-sm sm:text-base font-semibold tracking-tight text-[#9ea8a3] transition-colors duration-200 group-hover:text-task-dark whitespace-nowrap">
							{item.name}
						</span>
					</div>
				))
			}
		</div>

		<!-- Segunda faixa (duplicada para loop infinito 100% contínuo) -->
		<div class="flex shrink-0 items-center gap-10 sm:gap-14 pr-10 sm:pr-14" aria-hidden="true">
			{
				items.map((item) => (
					<div
						class="group flex items-center gap-2.5 sm:gap-3 transition-transform duration-200 hover:scale-110"
						title={item.name}
					>
						<Icon
							name={item.icon}
							class="size-7 sm:size-8 text-[#9ea8a3] transition-colors duration-200 group-hover:text-task-dark shrink-0"
						/>
						<span class="font-outfit text-sm sm:text-base font-semibold tracking-tight text-[#9ea8a3] transition-colors duration-200 group-hover:text-task-dark whitespace-nowrap">
							{item.name}
						</span>
					</div>
				))
			}
		</div>
	</div>
</div>
