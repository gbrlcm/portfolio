				<ol class="flex flex-col gap-2.5 font-outfit text-xs text-task-gray leading-relaxed list-decimal pl-4">
					{t.preview.outlookSteps.map((step) => (
						<li>{step}</li>
					))}
				</ol>
			</div>

			<!-- Apple Mail -->
			<div class="flex flex-col rounded-2xl border border-task-border bg-white p-5 shadow-xs">
				<div class="mb-3.5 flex items-center gap-2.5">
					<Icon name="simple-icons:apple" class="size-6.5 shrink-0 text-task-dark" />
					<h3 class="font-anton text-base text-task-dark">{t.preview.appleTitle}</h3>
				</div>
				<ol class="flex flex-col gap-2.5 font-outfit text-xs text-task-gray leading-relaxed list-decimal pl-4">
					{t.preview.appleSteps.map((step) => (
						<li>{step}</li>
					))}
				</ol>
			</div>
		</div>

		<!-- Dica de Hospedagem de Imagens -->
		<div class="mt-8 rounded-2xl border border-task-border bg-white p-5">
			<div class="flex items-start gap-3">
				<Icon name="lucide:info" class="size-5 shrink-0 text-task-olive mt-0.5" />
				<div>
					<h4 class="font-anton text-sm uppercase tracking-wide text-task-dark">
						{t.preview.imageHostTitle}
					</h4>
					<p class="mt-1 font-outfit text-xs text-task-gray leading-relaxed">
						{t.preview.imageHostDesc}
					</p>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	#email-signature-app button,
	#email-signature-app [role="button"],
	#email-signature-app [role="tab"],
	#email-signature-app select,
	#email-signature-app .template-card,
	#email-signature-app .font-size-option,
	#email-signature-app .color-preset-btn {
		cursor: pointer;
	}

	#email-signature-app button:disabled,
	#email-signature-app [disabled] {
		cursor: not-allowed;
	}
</style>

<script>
	import { execCopy } from '../../../lib/clipboard';
	import type { SignatureData, TemplateId, TextSize } from '../../../lib/email-signature/types';
	import type { SupportedLanguage } from '../../../i18n/ui';
	import { generateSignatureHtml, generateExportDocument } from '../../../lib/email-signature/generator';

	const appRoot = document.getElementById('email-signature-app');
	const configData = appRoot?.dataset.config ? JSON.parse(appRoot.dataset.config) : null;
	const currentLang: SupportedLanguage = (configData?.lang as SupportedLanguage) || 'pt-BR';
	const defaultData: SignatureData = configData?.defaultData;
	const toastsI18n = configData?.toasts;
	const navigationI18n = configData?.navigation;

	// Chave de storage específica por idioma para não misturar dados
	const STORAGE_KEY = `gabrielcampos_email_sig_state_${currentLang}`;

	// Estado local inicial
	let signatureState: SignatureData = { ...defaultData };
	let currentStep = 1;

	// Carrega dados salvos se existirem
	try {
		const saved = localStorage.getItem(STORAGE_KEY);
		if (saved) {
			const parsed = JSON.parse(saved);
			if (parsed.avatarUrl === 'https://gabrielcampos.dev/images/hero.webp') {
				parsed.avatarUrl = defaultData.avatarUrl;
			}
			signatureState = { ...defaultData, ...parsed };
		}
	} catch (e) {
		console.warn('Erro ao carregar localStorage:', e);
	}

	// Elementos DOM
	const previewContainer = document.getElementById('signature-preview-container');
	const stepTabs = document.querySelectorAll<HTMLButtonElement>('.step-tab');
	const stepPanels = document.querySelectorAll<HTMLElement>('.step-panel');
	const btnPrev = document.getElementById('btn-step-prev') as HTMLButtonElement | null;
	const btnNext = document.getElementById('btn-step-next') as HTMLButtonElement | null;
	const btnNextText = document.getElementById('btn-next-text');
	const stepIndicatorText = document.getElementById('step-indicator-text');
	const toast = document.getElementById('sig-toast');
	const toastTitle = document.getElementById('toast-title');
	const toastDesc = document.getElementById('toast-desc');

	// Inputs
	const form = document.getElementById('signature-form') as HTMLFormElement | null;
	const templateCards = document.querySelectorAll<HTMLElement>('.template-card');
	const colorPresetBtns = document.querySelectorAll<HTMLButtonElement>('.color-preset-btn');
	const fontSizeLabels = document.querySelectorAll<HTMLElement>('.font-size-option');

	const colorPickerPrimary = document.getElementById('color-picker-primary') as HTMLInputElement | null;
	const inputPrimaryColor = document.getElementById('input-primaryColor') as HTMLInputElement | null;
	const colorPickerText = document.getElementById('color-picker-text') as HTMLInputElement | null;
	const inputTextColor = document.getElementById('input-textColor') as HTMLInputElement | null;
	const colorPickerLink = document.getElementById('color-picker-link') as HTMLInputElement | null;
	const inputLinkColor = document.getElementById('input-linkColor') as HTMLInputElement | null;

	// Botões de Ação
	const btnCopySig = document.getElementById('btn-copy-signature');
	const btnCopyHtml = document.getElementById('btn-copy-html');
	const btnDownloadHtml = document.getElementById('btn-download-html');
	const btnFillExample = document.getElementById('btn-fill-example');
	const btnClearFields = document.getElementById('btn-clear-fields');

	// Função de atualização da prévia
	function updatePreview() {
		if (!previewContainer) return;
		const html = generateSignatureHtml(signatureState);
		const isLocalhost = ['localhost', '127.0.0.1'].includes(window.location.hostname);
		previewContainer.innerHTML = isLocalhost
			? html.replaceAll('https://gabrielcampos.dev/', '/')
			: html;

		// Persiste em localStorage
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify(signatureState));
		} catch (e) {
			// ignora quota exceeded
		}
	}

	// Atualiza os campos do formulário para refletir o estado
	function syncFormWithState() {
		// Template selection
		templateCards.forEach((card) => {
			const id = card.dataset.template as TemplateId;
			const isSelected = id === signatureState.templateId;
			const check = card.querySelector('.template-check');
			const radio = card.querySelector('input[type="radio"]') as HTMLInputElement | null;

			if (isSelected) {
				card.classList.add('border-task-dark', 'bg-task-bg/50');
				card.classList.remove('border-task-border', 'bg-white');
				check?.classList.remove('hidden');
				if (radio) radio.checked = true;
			} else {
				card.classList.remove('border-task-dark', 'bg-task-bg/50');
				card.classList.add('border-task-border', 'bg-white');
				check?.classList.add('hidden');
				if (radio) radio.checked = false;
			}
		});

		// Inputs de texto
		const textInputs = [
			'fullName', 'jobTitle', 'department', 'email', 'phone', 'mobilePhone',
			'companyName', 'website', 'address', 'linkedin', 'instagram', 'facebook',
			'whatsapp', 'github', 'twitter', 'avatarUrl', 'logoUrl', 'ctaText', 'ctaUrl'
		] as const;

		textInputs.forEach((name) => {
			const el = document.getElementById(`input-${name}`) as HTMLInputElement | null;
			if (el) {
				el.value = (signatureState[name] as string) || '';
			}
		});

		const disclaimerEl = document.getElementById('textarea-disclaimer') as HTMLTextAreaElement | null;
		if (disclaimerEl) {
			disclaimerEl.value = signatureState.disclaimer || '';
		}

		// Cores
		if (colorPickerPrimary && inputPrimaryColor) {
			colorPickerPrimary.value = signatureState.primaryColor;
			inputPrimaryColor.value = signatureState.primaryColor;
		}
		if (colorPickerText && inputTextColor) {
			colorPickerText.value = signatureState.textColor;
			inputTextColor.value = signatureState.textColor;
		}
		if (colorPickerLink && inputLinkColor) {
			colorPickerLink.value = signatureState.linkColor;
			inputLinkColor.value = signatureState.linkColor;
		}

		// Fonte
		const fontSelect = document.getElementById('select-fontFamily') as HTMLSelectElement | null;
		if (fontSelect) {
			fontSelect.value = signatureState.fontFamily;
		}

		// Tamanho
		fontSizeLabels.forEach((label) => {
			const radio = label.querySelector('input[type="radio"]') as HTMLInputElement | null;
			if (radio) {
				const isSelected = radio.value === signatureState.fontSize;
				radio.checked = isSelected;
				if (isSelected) {
					label.classList.add('border-task-dark', 'bg-task-bg');
					label.classList.remove('border-task-border', 'bg-white');
				} else {
					label.classList.remove('border-task-dark', 'bg-task-bg');
					label.classList.add('border-task-border', 'bg-white');
				}
			}
		});
	}

	// Mudança de etapa
	function goToStep(step: number) {
		if (step < 1 || step > 4) return;
		currentStep = step;

		// Atualiza tabs
		stepTabs.forEach((tab) => {
			const tabStep = parseInt(tab.dataset.step || '1', 10);
			const badge = tab.querySelector('.step-badge');
			const isCurrent = tabStep === currentStep;
			const isDone = tabStep < currentStep;

			tab.setAttribute('aria-selected', isCurrent ? 'true' : 'false');

			if (isCurrent) {
				tab.classList.add('bg-task-bg/60');
				if (badge) {
					badge.classList.remove('bg-task-bg', 'text-task-gray', 'bg-task-olive');
					badge.classList.add('bg-task-dark', 'text-white');
				}
			} else if (isDone) {
				tab.classList.remove('bg-task-bg/60');
				if (badge) {
					badge.classList.remove('bg-task-bg', 'text-task-gray', 'bg-task-dark');
					badge.classList.add('bg-task-olive', 'text-white');
				}
			} else {
				tab.classList.remove('bg-task-bg/60');
				if (badge) {
					badge.classList.remove('bg-task-dark', 'bg-task-olive', 'text-white');
					badge.classList.add('bg-task-bg', 'text-task-gray');
				}
			}
		});

		// Exibe painel correspondente
		stepPanels.forEach((panel) => {
			const panelId = panel.id;
			if (panelId === `panel-step-${currentStep}`) {
				panel.classList.remove('hidden');
			} else {
				panel.classList.add('hidden');
			}
		});

		// Atualiza botões de navegação
		if (btnPrev) {
			btnPrev.disabled = currentStep === 1;
		}

		if (btnNext && btnNextText) {
			if (currentStep === 4) {
				btnNextText.textContent = navigationI18n?.finish || 'Concluir & Copiar';
			} else {
				btnNextText.textContent = navigationI18n?.next || 'Avançar';
			}
		}

		if (stepIndicatorText) {
			const template = navigationI18n?.stepIndicator || 'Etapa {current} de 4';
			stepIndicatorText.textContent = template.replace('{current}', String(currentStep));
		}
	}

	// Notificação Toast
	let toastTimeout: ReturnType<typeof setTimeout> | null = null;
	function showToast(title: string, desc: string) {
		if (!toast || !toastTitle || !toastDesc) return;
		toastTitle.textContent = title;
		toastDesc.textContent = desc;

		toast.classList.remove('opacity-0', 'translate-y-2');
		toast.classList.add('opacity-100', 'translate-y-0');

		if (toastTimeout) clearTimeout(toastTimeout);
		toastTimeout = setTimeout(() => {
			toast.classList.remove('opacity-100', 'translate-y-0');
			toast.classList.add('opacity-0', 'translate-y-2');
		}, 4000);
	}

	// Cópia Formatada da Assinatura (Rich HTML)
	async function copyFormattedSignature() {
		const html = generateSignatureHtml(signatureState);

		try {
			// Tenta Clipboard API com Blob text/html
			if (navigator.clipboard && window.ClipboardItem) {
				const blobHtml = new Blob([html], { type: 'text/html' });
				const blobText = new Blob([previewContainer?.innerText || ''], { type: 'text/plain' });
				await navigator.clipboard.write([
					new ClipboardItem({
						'text/html': blobHtml,
						'text/plain': blobText,
					}),
				]);
				showToast(
					toastsI18n?.copySuccess || 'Assinatura copiada com sucesso!',
					toastsI18n?.copySuccessDesc || 'Pronta para colar (Cmd+V ou Ctrl+V) no Gmail ou Outlook.'
				);
				triggerSuccessIcon();
				return;
			}
		} catch (err) {
			console.warn('Clipboard API falhou, tentando fallback por seleção DOM:', err);
		}

		// Fallback para seleção de nó no DOM
		try {
			if (previewContainer) {
				const range = document.createRange();
				range.selectNodeContents(previewContainer);
				const selection = window.getSelection();
				if (selection) {
					selection.removeAllRanges();
					selection.addRange(range);
					execCopy();
					selection.removeAllRanges();
					showToast(
						toastsI18n?.copyFallback || 'Assinatura copiada!',
						toastsI18n?.copyFallbackDesc || 'Cole diretamente nas configurações do seu cliente de e-mail.'
					);
					triggerSuccessIcon();
					return;
				}
			}
		} catch (fallbackErr) {
			console.error('Fallback de cópia falhou:', fallbackErr);
			showToast(
				toastsI18n?.copyError || 'Não foi possível copiar automaticamente',
				toastsI18n?.copyErrorDesc || 'Por favor, selecione e copie manualmente ou use "Copiar Código HTML".'
			);
		}
	}

	function triggerSuccessIcon() {
		const iconNormal = document.getElementById('icon-copy-sig');
		const iconSuccess = document.getElementById('icon-copy-sig-success');
		const textEl = document.getElementById('text-copy-sig');

		if (iconNormal && iconSuccess && textEl) {
			iconNormal.classList.add('hidden');
			iconSuccess.classList.remove('hidden');
			const originalText = textEl.textContent;
			textEl.textContent = toastsI18n?.copySuccess || 'Copiado para a área de transferência!';

			setTimeout(() => {
				iconNormal.classList.remove('hidden');
				iconSuccess.classList.add('hidden');
				textEl.textContent = originalText;
			}, 2500);
		}
	}

	// Cópia de Código HTML Puro
	async function copyHtmlCode() {
		const html = generateSignatureHtml(signatureState);
		try {
			await navigator.clipboard.writeText(html);
			showToast(
				toastsI18n?.htmlCopied || 'Código HTML copiado!',
				toastsI18n?.htmlCopiedDesc || 'Código-fonte pronto para colar em clientes com suporte a HTML direto.'
			);
		} catch (err) {
			// Fallback textarea
			const textarea = document.createElement('textarea');
			textarea.value = html;
			textarea.style.position = 'fixed';
			textarea.style.opacity = '0';
			document.body.appendChild(textarea);
			textarea.select();
			execCopy();
			document.body.removeChild(textarea);
			showToast(
				toastsI18n?.htmlCopied || 'Código HTML copiado!',
				toastsI18n?.htmlCopiedDesc || 'Código-fonte na área de transferência.'
			);
		}
	}

	// Download de Arquivo .HTML
	function downloadHtmlFile() {
		const doc = generateExportDocument(signatureState, currentLang);
		const blob = new Blob([doc], { type: 'text/html;charset=utf-8' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		const safeName = (signatureState.fullName || 'signature')
			.toLowerCase()
			.replace(/[^a-z0-9]/g, '-');
		a.href = url;
		a.download = `signature-${safeName}.html`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
		showToast(
			toastsI18n?.downloadStarted || 'Download iniciado!',
			toastsI18n?.downloadStartedDesc || 'O arquivo .html foi salvo no seu computador.'
		);
	}

	// Event Listeners: Stepper Tabs
	stepTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const step = parseInt(tab.dataset.step || '1', 10);
			goToStep(step);
		});
	});

	btnPrev?.addEventListener('click', () => {
		goToStep(currentStep - 1);
	});

	btnNext?.addEventListener('click', () => {
		if (currentStep === 4) {
			copyFormattedSignature();
		} else {
			goToStep(currentStep + 1);
		}
	});

	// Event Listeners: Seleção de Templates
	templateCards.forEach((card) => {
		card.addEventListener('click', () => {
			const templateId = card.dataset.template as TemplateId;
			if (templateId) {
				signatureState.templateId = templateId;
				syncFormWithState();
				updatePreview();
			}
		});
	});

	// Event Listeners: Inputs de Formulário em Tempo Real
	if (form) {
		form.addEventListener('input', (e) => {
			const target = e.target as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
			if (!target || !target.name) return;

			const name = target.name as keyof SignatureData;
			if (name in signatureState) {
				(signatureState as any)[name] = target.value;
				updatePreview();
			}
		});
	}

	// Event Listeners: Color Pickers e Hex
	function bindColorPair(
		picker: HTMLInputElement | null,
		textInput: HTMLInputElement | null,
		stateKey: 'primaryColor' | 'textColor' | 'linkColor'
	) {
		picker?.addEventListener('input', () => {
			if (textInput) textInput.value = picker.value;
			signatureState[stateKey] = picker.value;
			updatePreview();
		});

		textInput?.addEventListener('input', () => {
			let val = textInput.value.trim();
			if (!val.startsWith('#') && val.length > 0) val = `#${val}`;
			if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
				if (picker) picker.value = val;
				signatureState[stateKey] = val;
				updatePreview();
			}
		});
	}

	bindColorPair(colorPickerPrimary, inputPrimaryColor, 'primaryColor');
	bindColorPair(colorPickerText, inputTextColor, 'textColor');
	bindColorPair(colorPickerLink, inputLinkColor, 'linkColor');

	// Presets de Cores
	colorPresetBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			const targetKey = btn.dataset.target as 'primaryColor' | 'textColor' | 'linkColor';
			const color = btn.dataset.color;
			if (targetKey && color) {
				signatureState[targetKey] = color;
				syncFormWithState();
				updatePreview();
			}
		});
	});

	// Seleção de Fonte
	const fontSelect = document.getElementById('select-fontFamily') as HTMLSelectElement | null;
	fontSelect?.addEventListener('change', () => {
		signatureState.fontFamily = fontSelect.value;
		updatePreview();
	});

	// Seleção de Tamanho de Fonte
	fontSizeLabels.forEach((label) => {
		label.addEventListener('click', () => {
			const radio = label.querySelector('input[type="radio"]') as HTMLInputElement | null;
			if (radio) {
				signatureState.fontSize = radio.value as TextSize;
				syncFormWithState();
				updatePreview();
			}
		});
	});

	// Ações de Botões de Exportação
	btnCopySig?.addEventListener('click', copyFormattedSignature);
	btnCopyHtml?.addEventListener('click', copyHtmlCode);
	btnDownloadHtml?.addEventListener('click', downloadHtmlFile);

	// Ações Rápidas: Preencher Exemplo
	btnFillExample?.addEventListener('click', () => {
		signatureState = { ...defaultData };
		syncFormWithState();
		updatePreview();
		showToast(
			toastsI18n?.exampleLoaded || 'Exemplo carregado!',
			toastsI18n?.exampleLoadedDesc || 'Os campos foram preenchidos com dados completos para demonstração.'
		);
	});

	// Ações Rápidas: Limpar Campos
	btnClearFields?.addEventListener('click', () => {
		const confirmMsg = toastsI18n?.confirmClear || 'Deseja realmente limpar todos os campos preenchidos?';
		if (confirm(confirmMsg)) {
			signatureState = {
				...defaultData,
				fullName: '',
				jobTitle: '',
				department: '',
				email: '',
				phone: '',
				mobilePhone: '',
				companyName: '',
				website: '',
				address: '',
				linkedin: '',
				instagram: '',
				facebook: '',
				whatsapp: '',
				github: '',
				twitter: '',
				avatarUrl: '',
				logoUrl: '',
				ctaText: '',
				ctaUrl: '',
				disclaimer: '',
			};
			syncFormWithState();
			updatePreview();
			showToast(
				toastsI18n?.fieldsCleared || 'Campos limpos',
				toastsI18n?.fieldsClearedDesc || 'O formulário foi redefinido.'
			);
		}
	});

	// Inicialização
	syncFormWithState();
	updatePreview();
	goToStep(1);
</script>
