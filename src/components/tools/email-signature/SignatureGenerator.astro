								<button
									type="button"
									class="color-preset-btn flex size-8 cursor-pointer items-center justify-center rounded-full border border-task-border shadow-2xs transition-transform hover:scale-110 active:scale-95"
									data-target="primaryColor"
									data-color={preset.hex}
									style={`background-color: ${preset.hex};`}
									title={preset.label}
								/>
							))}
						</div>
						<div class="flex items-center gap-3">
							<input
								type="color"
								id="color-picker-primary"
								name="primaryColorPicker"
