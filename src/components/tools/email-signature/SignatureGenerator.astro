---
import { Icon } from 'astro-icon/components';
import type { SupportedLanguage } from '../../../i18n/ui';
import { EMAIL_SIGNATURE_I18N } from '../../../lib/email-signature/i18n';
import { generateSignatureHtml } from '../../../lib/email-signature/generator';

export interface Props {
	lang?: SupportedLanguage;
}

const { lang = 'pt-BR' } = Astro.props;
const t = EMAIL_SIGNATURE_I18N[lang] || EMAIL_SIGNATURE_I18N['pt-BR'];

// Render inicial no servidor usando os dados padrão do idioma selecionado
const initialHtml = generateSignatureHtml(t.defaultData);

// Serialização dos dados do cliente para JavaScript
const clientConfig = {
	lang,
	defaultData: t.defaultData,
	toasts: t.toasts,
	navigation: t.navigation,
	preview: t.preview,
};
---

<div id="email-signature-app" class="relative w-full" data-config={JSON.stringify(clientConfig)}>
	<!-- Top Bar com Título e Ações Rápidas -->
	<div class="mb-8 flex flex-col justify-between gap-4 pb-6 sm:flex-row sm:items-end">
		<div>
			<h1 class="font-anton text-3xl tracking-tight text-task-dark sm:text-4xl md:text-5xl uppercase">
				{t.header.title}
			</h1>
			<p class="mt-2 max-w-2xl font-outfit text-sm text-task-gray sm:text-base">
				{t.header.subtitle}
			</p>
		</div>

		<!-- Quick Actions -->
		<div class="flex items-center gap-2 self-start sm:self-end">
			<button
				type="button"
				id="btn-fill-example"
				class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-task-border bg-white px-4 py-2 font-outfit text-xs font-semibold text-task-dark shadow-2xs transition-all hover:border-task-dark hover:bg-task-bg active:scale-95"
				title={t.header.fillExampleTitle}
			>
				<Icon name="lucide:sparkles" class="size-3.5 text-task-olive" />
				{t.header.fillExample}
			</button>
			<button
				type="button"
				id="btn-clear-fields"
				class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-task-border bg-white px-4 py-2 font-outfit text-xs font-semibold text-task-gray shadow-2xs transition-all hover:border-red-300 hover:text-red-700 active:scale-95"
				title={t.header.clearTitle}
			>
				<Icon name="lucide:rotate-ccw" class="size-3.5" />
				{t.header.clear}
			</button>
		</div>
	</div>

	<!-- Container Principal de 2 Colunas no Desktop -->
	<div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-6">
		<!-- Coluna da Esquerda: Formulário e Passos (7 colunas) -->
		<div class="flex min-w-0 flex-col rounded-3xl border border-task-border bg-white p-4 shadow-xs sm:p-7 md:p-8 lg:col-span-7">
			<!-- Stepper de Navegação das 4 Etapas -->
			<div class="mb-8">
				<div class="grid grid-cols-4 gap-1 sm:gap-2.5" role="tablist" aria-label="Etapas do gerador">
					<!-- Etapa 1 -->
					<button
						type="button"
						class="step-tab group flex cursor-pointer flex-col items-center gap-1 rounded-2xl p-1.5 text-center transition-all sm:flex-row sm:gap-2.5 sm:p-2.5 sm:text-left active:scale-95"
						data-step="1"
						role="tab"
						aria-selected="true"
						aria-controls="panel-step-1"
						id="tab-step-1"
					>
						<span class="step-badge flex size-7 shrink-0 items-center justify-center rounded-xl bg-task-dark font-anton text-xs text-white transition-all sm:size-9 sm:text-sm">
							1
						</span>
						<div class="min-w-0">
							<span class="block font-outfit text-[11px] font-bold text-task-dark sm:text-xs md:text-sm">
								{t.steps.step1Title}
							</span>
							<span class="hidden font-outfit text-[11px] text-task-gray sm:block">
								{t.steps.step1Subtitle}
							</span>
						</div>
					</button>

					<!-- Etapa 2 -->
					<button
						type="button"
						class="step-tab group flex cursor-pointer flex-col items-center gap-1 rounded-2xl p-1.5 text-center transition-all sm:flex-row sm:gap-2.5 sm:p-2.5 sm:text-left active:scale-95"
						data-step="2"
						role="tab"
						aria-selected="false"
						aria-controls="panel-step-2"
						id="tab-step-2"
					>
						<span class="step-badge flex size-7 shrink-0 items-center justify-center rounded-xl bg-task-bg font-anton text-xs text-task-gray transition-all sm:size-9 sm:text-sm">
							2
						</span>
						<div class="min-w-0">
							<span class="block font-outfit text-[11px] font-bold text-task-dark sm:text-xs md:text-sm">
								{t.steps.step2Title}
							</span>
							<span class="hidden font-outfit text-[11px] text-task-gray sm:block">
								{t.steps.step2Subtitle}
							</span>
						</div>
					</button>

					<!-- Etapa 3 -->
					<button
						type="button"
						class="step-tab group flex cursor-pointer flex-col items-center gap-1 rounded-2xl p-1.5 text-center transition-all sm:flex-row sm:gap-2.5 sm:p-2.5 sm:text-left active:scale-95"
						data-step="3"
						role="tab"
						aria-selected="false"
						aria-controls="panel-step-3"
						id="tab-step-3"
					>
						<span class="step-badge flex size-7 shrink-0 items-center justify-center rounded-xl bg-task-bg font-anton text-xs text-task-gray transition-all sm:size-9 sm:text-sm">
							3
						</span>
						<div class="min-w-0">
							<span class="block font-outfit text-[11px] font-bold text-task-dark sm:text-xs md:text-sm">
								{t.steps.step3Title}
							</span>
							<span class="hidden font-outfit text-[11px] text-task-gray sm:block">
								{t.steps.step3Subtitle}
							</span>
						</div>
					</button>

					<!-- Etapa 4 -->
					<button
						type="button"
						class="step-tab group flex cursor-pointer flex-col items-center gap-1 rounded-2xl p-1.5 text-center transition-all sm:flex-row sm:gap-2.5 sm:p-2.5 sm:text-left active:scale-95"
						data-step="4"
						role="tab"
						aria-selected="false"
						aria-controls="panel-step-4"
						id="tab-step-4"
					>
						<span class="step-badge flex size-7 shrink-0 items-center justify-center rounded-xl bg-task-bg font-anton text-xs text-task-gray transition-all sm:size-9 sm:text-sm">
							4
						</span>
						<div class="min-w-0">
							<span class="block font-outfit text-[11px] font-bold text-task-dark sm:text-xs md:text-sm">
								{t.steps.step4Title}
							</span>
							<span class="hidden font-outfit text-[11px] text-task-gray sm:block">
								{t.steps.step4Subtitle}
							</span>
						</div>
					</button>
				</div>
			</div>

			<!-- Painéis de Conteúdo das Etapas -->
			<form id="signature-form" onsubmit="return false;" class="flex flex-col">
				<!-- ============================================== -->
				<!-- ETAPA 1: MODELO                                 -->
				<!-- ============================================== -->
				<div class="step-panel" id="panel-step-1" role="tabpanel" aria-labelledby="tab-step-1">
					<div class="mb-6">
						<h2 class="font-anton text-xl text-task-dark sm:text-2xl">
							{t.step1.title}
						</h2>
						<p class="font-outfit text-xs text-task-gray sm:text-sm">
							{t.step1.subtitle}
						</p>
					</div>

					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<!-- Modelo 1: Clássico -->
						<label class="template-card relative flex cursor-pointer flex-col rounded-2xl border-2 border-task-dark bg-task-bg/50 p-4 transition-all hover:border-task-dark" data-template="classic">
							<input type="radio" name="templateId" value="classic" checked class="sr-only" />
							<!-- Miniatura Visual Fiel -->
							<div class="mb-3.5 flex h-32 w-full items-center justify-center rounded-xl border border-task-border bg-white p-3">
								<div class="flex w-full items-center gap-3">
									<div class="size-12 shrink-0 rounded-lg bg-task-dark/15 flex items-center justify-center font-anton text-xs text-task-dark">
										{t.step1.photoLabel}
									</div>
									<div class="h-16 w-0.5 bg-task-dark"></div>
									<div class="flex flex-1 flex-col gap-1">
										<div class="h-2.5 w-24 rounded bg-task-dark"></div>
										<div class="h-1.5 w-16 rounded bg-task-gray/40"></div>
										<div class="mt-1 flex flex-col gap-0.5">
											<div class="h-1.5 w-28 rounded bg-task-gray/25"></div>
											<div class="h-1.5 w-20 rounded bg-task-gray/25"></div>
										</div>
										<div class="mt-1 flex gap-1">
											<div class="size-2 rounded bg-task-dark/60"></div>
											<div class="size-2 rounded bg-task-dark/60"></div>
											<div class="size-2 rounded bg-task-dark/60"></div>
										</div>
									</div>
								</div>
							</div>
							<div class="flex items-center justify-between">
								<div>
									<span class="block font-anton text-base text-task-dark">{t.step1.classicTitle}</span>
									<span class="block font-outfit text-xs text-task-gray">{t.step1.classicDesc}</span>
								</div>
								<span class="template-check flex size-5 items-center justify-center rounded-full bg-task-dark text-white">
									<Icon name="lucide:check" class="size-3" />
								</span>
							</div>
						</label>

						<!-- Modelo 2: Minimalista -->
						<label class="template-card relative flex cursor-pointer flex-col rounded-2xl border-2 border-task-border bg-white p-4 transition-all hover:border-task-gray" data-template="minimal">
							<input type="radio" name="templateId" value="minimal" class="sr-only" />
							<!-- Miniatura Visual Fiel -->
							<div class="mb-3.5 flex h-32 w-full items-center justify-center rounded-xl border border-task-border bg-white p-3">
								<div class="flex w-full items-center gap-3">
									<div class="size-10 shrink-0 rounded-full bg-task-dark/15 flex items-center justify-center font-anton text-[10px] text-task-dark">
										{t.step1.photoLabel}
									</div>
									<div class="flex flex-1 flex-col gap-1">
										<div class="h-2.5 w-20 rounded bg-task-dark"></div>
										<div class="h-1.5 w-24 rounded bg-task-gray/40"></div>
										<div class="mt-1.5 h-1.5 w-full rounded bg-task-gray/20"></div>
										<div class="mt-1 flex items-center gap-1.5">
											<div class="h-1.5 w-10 rounded bg-task-olive"></div>
											<div class="h-1.5 w-10 rounded bg-task-olive"></div>
										</div>
									</div>
								</div>
							</div>
							<div class="flex items-center justify-between">
								<div>
									<span class="block font-anton text-base text-task-dark">{t.step1.minimalTitle}</span>
									<span class="block font-outfit text-xs text-task-gray">{t.step1.minimalDesc}</span>
								</div>
								<span class="template-check hidden size-5 items-center justify-center rounded-full bg-task-dark text-white">
									<Icon name="lucide:check" class="size-3" />
								</span>
							</div>
						</label>

						<!-- Modelo 3: Corporativo -->
						<label class="template-card relative flex cursor-pointer flex-col rounded-2xl border-2 border-task-border bg-white p-4 transition-all hover:border-task-gray" data-template="corporate">
							<input type="radio" name="templateId" value="corporate" class="sr-only" />
							<!-- Miniatura Visual Fiel -->
							<div class="mb-3.5 flex h-32 w-full flex-col justify-between rounded-xl border border-task-border bg-white p-3">
								<div class="h-1 w-full rounded bg-task-dark"></div>
								<div class="flex w-full items-center justify-between gap-2">
									<div class="flex flex-col gap-1">
										<div class="h-2.5 w-20 rounded bg-task-dark"></div>
										<div class="h-1.5 w-28 rounded bg-task-gray/40"></div>
										<div class="mt-1 flex flex-col gap-0.5">
											<div class="h-1.5 w-24 rounded bg-task-gray/25"></div>
											<div class="h-1.5 w-20 rounded bg-task-gray/25"></div>
										</div>
									</div>
									<div class="size-11 shrink-0 rounded-lg bg-task-dark/15 flex items-center justify-center font-anton text-xs text-task-dark">
										{t.step1.photoLabel}
									</div>
								</div>
								<div class="flex gap-1.5 border-t border-task-border pt-1">
									<div class="size-2 rounded bg-task-dark/60"></div>
									<div class="size-2 rounded bg-task-dark/60"></div>
									<div class="size-2 rounded bg-task-dark/60"></div>
								</div>
							</div>
							<div class="flex items-center justify-between">
								<div>
									<span class="block font-anton text-base text-task-dark">{t.step1.corporateTitle}</span>
									<span class="block font-outfit text-xs text-task-gray">{t.step1.corporateDesc}</span>
								</div>
								<span class="template-check hidden size-5 items-center justify-center rounded-full bg-task-dark text-white">
									<Icon name="lucide:check" class="size-3" />
								</span>
							</div>
						</label>

						<!-- Modelo 4: Moderno Visual -->
						<label class="template-card relative flex cursor-pointer flex-col rounded-2xl border-2 border-task-border bg-white p-4 transition-all hover:border-task-gray" data-template="modern-visual">
							<input type="radio" name="templateId" value="modern-visual" class="sr-only" />
							<!-- Miniatura Visual Fiel -->
							<div class="mb-3.5 flex h-32 w-full items-center justify-center rounded-xl border border-task-border bg-[#faf9f5] p-3">
								<div class="flex w-full items-center gap-3">
									<div class="size-12 shrink-0 rounded-full border-2 border-task-dark bg-task-dark/10 flex items-center justify-center font-anton text-[10px] text-task-dark">
										{t.step1.photoLabel}
									</div>
									<div class="flex flex-1 flex-col gap-1">
										<div class="h-2.5 w-24 rounded bg-task-dark"></div>
										<div class="h-1.5 w-28 rounded bg-task-gray/50"></div>
										<div class="mt-1 flex flex-wrap gap-1">
											<div class="h-2 w-10 rounded-full bg-task-dark/15"></div>
											<div class="h-2 w-12 rounded-full bg-task-dark/15"></div>
										</div>
									</div>
								</div>
							</div>
							<div class="flex items-center justify-between">
								<div>
									<span class="block font-anton text-base text-task-dark">{t.step1.modernTitle}</span>
									<span class="block font-outfit text-xs text-task-gray">{t.step1.modernDesc}</span>
								</div>
								<span class="template-check hidden size-5 items-center justify-center rounded-full bg-task-dark text-white">
									<Icon name="lucide:check" class="size-3" />
								</span>
							</div>
						</label>
					</div>
				</div>

				<!-- ============================================== -->
				<!-- ETAPA 2: DADOS & INFORMAÇÕES                    -->
				<!-- ============================================== -->
				<div class="step-panel hidden" id="panel-step-2" role="tabpanel" aria-labelledby="tab-step-2">
					<div class="mb-6">
						<h2 class="font-anton text-xl text-task-dark sm:text-2xl">
							{t.step2.title}
						</h2>
						<p class="font-outfit text-xs text-task-gray sm:text-sm">
							{t.step2.subtitle}
						</p>
					</div>

					<div class="space-y-6">
						<!-- Grupo: Dados Principais -->
						<div class="rounded-2xl border border-task-border bg-task-bg/40 p-4 sm:p-5">
							<h3 class="mb-3 font-anton text-sm uppercase tracking-wide text-task-dark">
								{t.step2.personalData}
							</h3>
							<div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
								<div class="sm:col-span-2">
									<label for="input-fullName" class="mb-1.5 block font-outfit text-xs font-semibold text-task-dark">
										{t.step2.fullName} *
									</label>
									<input
										type="text"
										id="input-fullName"
										name="fullName"
										placeholder={t.step2.fullNamePlaceholder}
										value={t.defaultData.fullName}
										class="w-full rounded-xl border border-task-border bg-white px-3.5 py-2.5 font-outfit text-sm text-task-dark placeholder:text-task-gray/40 focus:border-task-dark focus:outline-none focus:ring-1 focus:ring-task-dark transition-all"
										required
									/>
								</div>
								<div>
									<label for="input-jobTitle" class="mb-1.5 block font-outfit text-xs font-semibold text-task-dark">
										{t.step2.jobTitle}
									</label>
									<input
										type="text"
										id="input-jobTitle"
										name="jobTitle"
										placeholder={t.step2.jobTitlePlaceholder}
										value={t.defaultData.jobTitle}
										class="w-full rounded-xl border border-task-border bg-white px-3.5 py-2.5 font-outfit text-sm text-task-dark placeholder:text-task-gray/40 focus:border-task-dark focus:outline-none focus:ring-1 focus:ring-task-dark transition-all"
									/>
								</div>
								<div>
									<label for="input-department" class="mb-1.5 block font-outfit text-xs font-semibold text-task-dark">
										{t.step2.department}
									</label>
									<input
										type="text"
										id="input-department"
										name="department"
										placeholder={t.step2.departmentPlaceholder}
										value={t.defaultData.department}
										class="w-full rounded-xl border border-task-border bg-white px-3.5 py-2.5 font-outfit text-sm text-task-dark placeholder:text-task-gray/40 focus:border-task-dark focus:outline-none focus:ring-1 focus:ring-task-dark transition-all"
									/>
								</div>
								<div class="sm:col-span-2">
									<label for="input-companyName" class="mb-1.5 block font-outfit text-xs font-semibold text-task-dark">
										{t.step2.companyName}
									</label>
									<input
										type="text"
										id="input-companyName"
										name="companyName"
										placeholder={t.step2.companyNamePlaceholder}
										value={t.defaultData.companyName}
										class="w-full rounded-xl border border-task-border bg-white px-3.5 py-2.5 font-outfit text-sm text-task-dark placeholder:text-task-gray/40 focus:border-task-dark focus:outline-none focus:ring-1 focus:ring-task-dark transition-all"
									/>
								</div>
							</div>
						</div>

						<!-- Grupo: Contatos Diretos -->
						<div class="rounded-2xl border border-task-border bg-task-bg/40 p-4 sm:p-5">
							<h3 class="mb-3 font-anton text-sm uppercase tracking-wide text-task-dark">
								{t.step2.contactChannels}
							</h3>
							<div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
								<div>
									<label for="input-email" class="mb-1.5 block font-outfit text-xs font-semibold text-task-dark">
										{t.step2.email}
									</label>
									<input
										type="email"
										id="input-email"
										name="email"
										placeholder="seu.nome@empresa.com"
										value={t.defaultData.email}
										class="w-full rounded-xl border border-task-border bg-white px-3.5 py-2.5 font-outfit text-sm text-task-dark placeholder:text-task-gray/40 focus:border-task-dark focus:outline-none focus:ring-1 focus:ring-task-dark transition-all"
									/>
								</div>
								<div>
									<label for="input-mobilePhone" class="mb-1.5 block font-outfit text-xs font-semibold text-task-dark">
										{t.step2.mobilePhone}
									</label>
									<input
										type="tel"
										id="input-mobilePhone"
										name="mobilePhone"
										placeholder="+55 11 98888-8888"
										value={t.defaultData.mobilePhone}
										class="w-full rounded-xl border border-task-border bg-white px-3.5 py-2.5 font-outfit text-sm text-task-dark placeholder:text-task-gray/40 focus:border-task-dark focus:outline-none focus:ring-1 focus:ring-task-dark transition-all"
									/>
								</div>
								<div>
									<label for="input-phone" class="mb-1.5 block font-outfit text-xs font-semibold text-task-dark">
										{t.step2.phone}
									</label>
									<input
										type="tel"
										id="input-phone"
										name="phone"
										placeholder="+55 11 3000-0000"
										value={t.defaultData.phone}
										class="w-full rounded-xl border border-task-border bg-white px-3.5 py-2.5 font-outfit text-sm text-task-dark placeholder:text-task-gray/40 focus:border-task-dark focus:outline-none focus:ring-1 focus:ring-task-dark transition-all"
									/>
								</div>
								<div>
									<label for="input-website" class="mb-1.5 block font-outfit text-xs font-semibold text-task-dark">
										{t.step2.website}
									</label>
									<input
										type="url"
										id="input-website"
										name="website"
										placeholder="https://gabrielcampos.dev"
										value={t.defaultData.website}
										class="w-full rounded-xl border border-task-border bg-white px-3.5 py-2.5 font-outfit text-sm text-task-dark placeholder:text-task-gray/40 focus:border-task-dark focus:outline-none focus:ring-1 focus:ring-task-dark transition-all"
									/>
								</div>
								<div class="sm:col-span-2">
									<label for="input-address" class="mb-1.5 block font-outfit text-xs font-semibold text-task-dark">
										{t.step2.address}
									</label>
									<input
										type="text"
										id="input-address"
										name="address"
										placeholder={t.step2.addressPlaceholder}
										value={t.defaultData.address}
										class="w-full rounded-xl border border-task-border bg-white px-3.5 py-2.5 font-outfit text-sm text-task-dark placeholder:text-task-gray/40 focus:border-task-dark focus:outline-none focus:ring-1 focus:ring-task-dark transition-all"
									/>
								</div>
							</div>
						</div>

						<!-- Grupo: Redes Sociais -->
						<div class="rounded-2xl border border-task-border bg-task-bg/40 p-4 sm:p-5">
							<h3 class="mb-3 font-anton text-sm uppercase tracking-wide text-task-dark">
								{t.step2.socialNetworks}
							</h3>
							<div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
								<div>
									<label for="input-linkedin" class="mb-1.5 block font-outfit text-xs font-semibold text-task-dark">
										LinkedIn (URL)
