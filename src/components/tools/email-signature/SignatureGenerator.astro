								</option>
							))}
						</select>
					</div>

					<!-- Tamanho da Fonte -->
					<div class="rounded-2xl border border-task-border bg-task-bg/40 p-4 sm:p-5">
						<label class="mb-2 block font-outfit text-xs font-semibold text-task-dark">
