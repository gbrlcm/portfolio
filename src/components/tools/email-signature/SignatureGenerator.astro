							/>
							<input
								type="text"
								id="input-primaryColor"
								name="primaryColor"
								value={DEFAULT_SIGNATURE_DATA.primaryColor}
								maxlength="7"
								class="w-32 rounded-xl border border-task-border bg-white px-3 py-2 font-mono text-xs text-task-dark uppercase focus:border-task-dark focus:outline-none"
							/>
							<span class="font-outfit text-xs text-task-gray">Código HEX</span>
						</div>
					</div>

					<!-- Cores de Texto e Links -->
					<div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
						<!-- Cor do Texto -->
						<div class="rounded-2xl border border-task-border bg-task-bg/40 p-4">
							<label class="mb-2 block font-outfit text-xs font-semibold text-task-dark">
								Cor do Texto
							</label>
							<div class="flex flex-wrap items-center gap-2 mb-3">
								{PRESET_TEXT_COLORS.map((preset) => (
									<button
										type="button"
										class="color-preset-btn flex size-7 cursor-pointer items-center justify-center rounded-full border border-task-border shadow-2xs hover:scale-110 transition-transform"
										data-target="textColor"
										data-color={preset.hex}
										style={`background-color: ${preset.hex};`}
										title={preset.label}
									/>
								))}
							</div>
							<div class="flex items-center gap-2">
								<input
									type="color"
									id="color-picker-text"
									name="textColorPicker"
									value={DEFAULT_SIGNATURE_DATA.textColor}
									class="size-9 cursor-pointer rounded-lg border border-task-border bg-white p-1"
								/>
								<input
									type="text"
									id="input-textColor"
									name="textColor"
									value={DEFAULT_SIGNATURE_DATA.textColor}
									maxlength="7"
									class="w-28 rounded-xl border border-task-border bg-white px-3 py-2 font-mono text-xs text-task-dark uppercase focus:border-task-dark focus:outline-none"
								/>
							</div>
						</div>

						<!-- Cor dos Links -->
						<div class="rounded-2xl border border-task-border bg-task-bg/40 p-4">
							<label class="mb-2 block font-outfit text-xs font-semibold text-task-dark">
								Cor dos Links
							</label>
							<div class="flex flex-wrap items-center gap-2 mb-3">
								{PRESET_LINK_COLORS.map((preset) => (
									<button
										type="button"
										class="color-preset-btn flex size-7 cursor-pointer items-center justify-center rounded-full border border-task-border shadow-2xs hover:scale-110 transition-transform"
										data-target="linkColor"
										data-color={preset.hex}
										style={`background-color: ${preset.hex};`}
										title={preset.label}
									/>
								))}
							</div>
							<div class="flex items-center gap-2">
								<input
									type="color"
									id="color-picker-link"
									name="linkColorPicker"
									value={DEFAULT_SIGNATURE_DATA.linkColor}
									class="size-9 cursor-pointer rounded-lg border border-task-border bg-white p-1"
								/>
								<input
									type="text"
									id="input-linkColor"
									name="linkColor"
									value={DEFAULT_SIGNATURE_DATA.linkColor}
									maxlength="7"
									class="w-28 rounded-xl border border-task-border bg-white px-3 py-2 font-mono text-xs text-task-dark uppercase focus:border-task-dark focus:outline-none"
								/>
							</div>
						</div>
					</div>

					<!-- Tipografia -->
					<div class="mb-6 rounded-2xl border border-task-border bg-task-bg/40 p-4 sm:p-5">
						<label for="select-fontFamily" class="mb-1.5 block font-outfit text-xs font-semibold text-task-dark">
							Fonte da Assinatura (Fontes universais para e-mail)
						</label>
						<p class="mb-3 font-outfit text-xs text-task-gray">
							Clientes de e-mail como Outlook e Gmail bloqueiam fontes web externas. Usamos fontes seguras que funcionam em todos os dispositivos.
						</p>
						<select
							id="select-fontFamily"
							name="fontFamily"
							class="w-full cursor-pointer rounded-xl border border-task-border bg-white px-3.5 py-2.5 font-outfit text-sm text-task-dark focus:border-task-dark focus:outline-none"
						>
							{AVAILABLE_FONTS.map((font) => (
								<option value={font.id} selected={font.id === DEFAULT_SIGNATURE_DATA.fontFamily}>
