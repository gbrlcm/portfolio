---
import { Icon } from 'astro-icon/components';

export interface Props {
	categories: string[];
	lang?: 'pt-BR' | 'en' | 'es';
	categoryLabel?: string;
	allLabel?: string;
	searchPlaceholder?: string;
	clearFiltersLabel?: string;
	resultsCountLabel?: string;
	selectedCategory?: string;
	class?: string;
}

const {
	categories = [],
	lang = 'pt-BR',
	categoryLabel = 'Categoria:',
	allLabel = 'Todas as categorias',
	searchPlaceholder = 'Buscar por título, assunto ou conteúdo...',
	clearFiltersLabel = 'Limpar filtros',
	resultsCountLabel = 'artigos encontrados',
	selectedCategory = 'all',
	class: className = '',
} = Astro.props;

// Sort categories alphabetically
const sortedCategories = [...categories].sort((a, b) => a.localeCompare(b));
---

<div class:list={['w-full', className]} data-blog-filters data-lang={lang}>
	<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
		<!-- Search Input Container -->
		<div class="relative w-full sm:max-w-md">
			<label for="blog-search-input" class="sr-only">{searchPlaceholder}</label>
			<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-task-gray">
				<Icon name="lucide:search" class="size-4" aria-hidden="true" />
			</div>
			<input
				type="search"
				id="blog-search-input"
				data-blog-search
				placeholder={searchPlaceholder}
				autocomplete="off"
				spellcheck="false"
				class="w-full rounded-xl border border-task-border bg-white py-2.5 pl-10 pr-9 font-outfit text-xs sm:text-sm text-task-dark placeholder:text-task-gray/70 shadow-2xs transition-all focus:border-task-dark focus:outline-none focus:ring-2 focus:ring-task-dark/10"
			/>
			<!-- Clear Search Button -->
			<button
				type="button"
				data-clear-search
				class="absolute inset-y-0 right-0 flex items-center pr-3 text-task-gray hover:text-task-dark focus:outline-none"
				aria-label="Limpar busca"
			>
				<Icon name="lucide:x" class="size-4" aria-hidden="true" />
			</button>
		</div>

		<!-- Category Custom Dropdown -->
		<div class="relative inline-flex items-center gap-2.5 shrink-0" data-category-dropdown>
			<span class="font-outfit text-xs font-medium text-task-gray shrink-0">{categoryLabel}</span>

			<div class="relative">
				<!-- Trigger Button -->
				<button
					type="button"
					data-dropdown-trigger
					aria-expanded="false"
					aria-haspopup="listbox"
					class="group inline-flex items-center gap-2.5 rounded-xl border border-task-border bg-white px-3.5 py-2 font-outfit text-xs sm:text-sm font-medium text-task-dark shadow-2xs transition-all hover:border-task-dark/30 hover:bg-neutral-50/80 focus:outline-none focus:ring-2 focus:ring-task-dark/10 active:scale-[0.99]"
				>
					<span data-selected-label class="max-w-45 truncate text-task-dark font-medium">
						{selectedCategory === 'all' ? allLabel : selectedCategory}
					</span>
					<Icon
						name="lucide:chevron-down"
						class="size-4 text-task-gray transition-transform duration-200 group-data-[open=true]:rotate-180"
						aria-hidden="true"
					/>
				</button>

				<!-- Dropdown Panel -->
				<div
					data-dropdown-menu
					role="listbox"
					class="invisible opacity-0 pointer-events-none absolute left-0 sm:left-auto sm:right-0 top-[calc(100%+6px)] z-30 min-w-60 max-w-[320px] max-h-80 overflow-y-auto rounded-2xl border border-task-border bg-white p-1.5 shadow-xl transition-all duration-150 ease-out origin-top-left sm:origin-top-right"
				>
					<!-- All Option -->
					<button
						type="button"
						role="option"
						data-category-option
						data-value="all"
						aria-selected={selectedCategory === 'all' ? 'true' : 'false'}
						class="group flex w-full items-center justify-between gap-2 rounded-xl px-3 py-2 text-left font-outfit text-xs sm:text-sm font-medium text-task-dark transition-colors hover:bg-task-yellow/20 aria-selected:bg-task-yellow/30 aria-selected:font-semibold"
					>
						<span class="truncate">{allLabel}</span>
						<Icon
							name="lucide:check"
							class="size-3.5 text-task-dark shrink-0 opacity-0 group-aria-selected:opacity-100"
							aria-hidden="true"
						/>
					</button>

					<div class="my-1 border-t border-task-border/60"></div>

					<!-- List of categories -->
					{
						sortedCategories.map((cat) => (
							<button
								type="button"
								role="option"
								data-category-option
								data-value={cat}
								aria-selected={selectedCategory === cat ? 'true' : 'false'}
								class="group flex w-full items-center justify-between gap-2 rounded-xl px-3 py-2 text-left font-outfit text-xs sm:text-sm text-task-dark transition-colors hover:bg-task-yellow/20 aria-selected:bg-task-yellow/30 aria-selected:font-semibold"
							>
								<span class="truncate">{cat}</span>
								<Icon
									name="lucide:check"
									class="size-3.5 text-task-dark shrink-0 opacity-0 group-aria-selected:opacity-100"
									aria-hidden="true"
								/>
							</button>
						))
					}
				</div>
			</div>
		</div>
	</div>

	<!-- Active filter status & reset bar -->
	<div data-filters-status class="mt-3 hidden items-center justify-between font-outfit text-xs text-task-gray">
		<span data-active-results-count>0 {resultsCountLabel}</span>
		<button
			type="button"
			data-reset-all-filters
			class="inline-flex items-center gap-1 font-medium text-task-dark underline underline-offset-2 hover:text-[#184a34] focus:outline-none"
		>
			<Icon name="lucide:rotate-ccw" class="size-3" aria-hidden="true" />
			{clearFiltersLabel}
		</button>
	</div>
</div>

<script>
	// Cache search index in memory so subsequent searches are instant
	let searchIndexPromise: Promise<Record<string, Array<{ slug: string; content: string }>>> | null = null;

	function fetchSearchIndex() {
		if (!searchIndexPromise) {
			searchIndexPromise = fetch('/api/blog-search-index.json')
				.then((res) => (res.ok ? res.json() : {}))
				.catch((err) => {
					console.error('Failed to load search index:', err);
					return {};
				});
		}
		return searchIndexPromise;
	}

	function setupBlogFilters() {
		const wrappers = document.querySelectorAll<HTMLElement>('[data-blog-filters]');

		wrappers.forEach((wrapper) => {
			if (wrapper.dataset.initialized === 'true') return;
			wrapper.dataset.initialized = 'true';

			const lang = wrapper.getAttribute('data-lang') || 'pt-BR';
			const searchInput = wrapper.querySelector<HTMLInputElement>('[data-blog-search]');
			const clearSearchBtn = wrapper.querySelector<HTMLButtonElement>('[data-clear-search]');
			const trigger = wrapper.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
			const menu = wrapper.querySelector<HTMLElement>('[data-dropdown-menu]');
			const selectedLabel = wrapper.querySelector<HTMLElement>('[data-selected-label]');
			const options = wrapper.querySelectorAll<HTMLButtonElement>('[data-category-option]');
			const resetAllBtn = wrapper.querySelector<HTMLButtonElement>('[data-reset-all-filters]');
			const statusContainer = wrapper.querySelector<HTMLElement>('[data-filters-status]');
			const countSpan = wrapper.querySelector<HTMLElement>('[data-active-results-count]');

			let currentCategory = 'all';
			let currentQuery = '';
			let contentMapBySlug = new Map<string, string>();

			// Preload index in background on first interaction or mouseenter
			wrapper.addEventListener('mouseenter', () => fetchSearchIndex(), { once: true });
			searchInput?.addEventListener('focus', () => fetchSearchIndex(), { once: true });

			function normalizeStr(str: string): string {
				return str
					.toLowerCase()
					.normalize('NFD')
					.replace(/[\u0300-\u036f]/g, '')
					.trim();
			}

			function openMenu() {
				menu?.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
				menu?.classList.add('visible', 'opacity-100', 'pointer-events-auto');
				trigger?.setAttribute('aria-expanded', 'true');
				trigger?.setAttribute('data-open', 'true');
			}

			function closeMenu() {
				menu?.classList.add('invisible', 'opacity-0', 'pointer-events-none');
				menu?.classList.remove('visible', 'opacity-100', 'pointer-events-auto');
				trigger?.setAttribute('aria-expanded', 'false');
				trigger?.removeAttribute('data-open');
			}

			function toggleMenu() {
				const isOpen = trigger?.getAttribute('aria-expanded') === 'true';
				if (isOpen) closeMenu();
				else openMenu();
			}

			trigger?.addEventListener('click', (e) => {
				e.stopPropagation();
				toggleMenu();
			});

			async function filterArticles() {
				const queryNorm = normalizeStr(currentQuery);
				const categoryNorm = currentCategory.toLowerCase();

				// If searching and index not ready, await index
				if (queryNorm && contentMapBySlug.size === 0) {
					try {
						const indexData = await fetchSearchIndex();
						const langItems = indexData[lang] || [];
						langItems.forEach((item: { slug: string; content: string }) => {
							contentMapBySlug.set(item.slug, item.content || '');
						});
					} catch {
						// fallback gracefully to title and description search
					}
				}

				const articles = document.querySelectorAll<HTMLElement>('article[data-category]');
				const emptyState = document.querySelector<HTMLElement>('[data-filter-empty-state]');
				const totalCards = articles.length;
				let matchedCount = 0;

				articles.forEach((card) => {
					const cardCategory = (card.getAttribute('data-category') || '').toLowerCase();
					const cardSlug = card.getAttribute('data-slug') || '';
					const cardTitle = normalizeStr(card.getAttribute('data-title') || '');
					const cardDesc = normalizeStr(card.getAttribute('data-description') || '');
					const cardContent = contentMapBySlug.get(cardSlug) || '';

					const matchesCategory =
						categoryNorm === 'all' || cardCategory === categoryNorm;

					const matchesSearch =
						!queryNorm ||
						cardTitle.includes(queryNorm) ||
						cardDesc.includes(queryNorm) ||
						cardCategory.includes(queryNorm) ||
						cardContent.includes(queryNorm);

					const isVisible = matchesCategory && matchesSearch;

					const container =
						card.closest<HTMLElement>('section[aria-label*="destaque"], section[aria-label*="featured"], section[aria-label*="destacado"], .grid > *') ||
						card;

					if (isVisible) {
						card.classList.remove('hidden');
						if (container !== card) container.classList.remove('hidden');
						matchedCount++;
					} else {
						card.classList.add('hidden');
						if (container !== card) container.classList.add('hidden');
					}
				});

				// Empty state indicator
				if (emptyState) {
					if (matchedCount === 0 && totalCards > 0) {
						emptyState.classList.remove('hidden');
					} else {
						emptyState.classList.add('hidden');
					}
				}

				// Status Bar (Active filters and count)
				const hasActiveFilter = currentCategory !== 'all' || queryNorm.length > 0;
				if (statusContainer) {
					if (hasActiveFilter) {
						statusContainer.classList.remove('hidden');
						statusContainer.classList.add('flex');
						if (countSpan) {
							const textSuffix = countSpan.textContent?.replace(/^\d+\s*/, '') || 'artigos';
							countSpan.textContent = `${matchedCount} ${textSuffix}`;
						}
					} else {
						statusContainer.classList.add('hidden');
						statusContainer.classList.remove('flex');
					}
				}

				// Clear search icon visibility
				if (clearSearchBtn) {
					if (queryNorm.length > 0) {
						clearSearchBtn.classList.remove('hidden');
					} else {
						clearSearchBtn.classList.add('hidden');
					}
				}
			}

			// Dropdown Category selection
			options.forEach((opt) => {
				opt.addEventListener('click', (e) => {
					e.stopPropagation();
					const val = opt.getAttribute('data-value') || 'all';
					const label = opt.querySelector('span')?.textContent?.trim() || val;

					currentCategory = val;
					if (selectedLabel) selectedLabel.textContent = label;

					options.forEach((o) => {
						const isSel = o.getAttribute('data-value') === val;
						o.setAttribute('aria-selected', isSel ? 'true' : 'false');
					});

					filterArticles();
					closeMenu();
				});
			});

			// Search Input handler (with debounce)
			let searchTimeout: ReturnType<typeof setTimeout> | null = null;
			searchInput?.addEventListener('input', () => {
				if (searchTimeout) clearTimeout(searchTimeout);
				searchTimeout = setTimeout(() => {
					currentQuery = searchInput.value;
					filterArticles();
				}, 150);
			});

			clearSearchBtn?.addEventListener('click', () => {
				if (searchInput) {
					searchInput.value = '';
					currentQuery = '';
					searchInput.focus();
					filterArticles();
				}
			});

			// Reset all filters button
			resetAllBtn?.addEventListener('click', () => {
				currentCategory = 'all';
				currentQuery = '';
				if (searchInput) searchInput.value = '';

				const allOpt = wrapper.querySelector<HTMLButtonElement>('[data-category-option][data-value="all"]');
				const allLabelText = allOpt?.querySelector('span')?.textContent?.trim() || 'Todas as categorias';
				if (selectedLabel) selectedLabel.textContent = allLabelText;

				options.forEach((o) => {
					o.setAttribute('aria-selected', o.getAttribute('data-value') === 'all' ? 'true' : 'false');
				});

				filterArticles();
			});

			// Close on outside click
			document.addEventListener('click', (e) => {
				if (!wrapper.contains(e.target as Node)) {
					closeMenu();
				}
			});

			// Close on escape
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					closeMenu();
				}
			});
		});
	}

	setupBlogFilters();
	document.addEventListener('astro:page-load', setupBlogFilters);
</script>
