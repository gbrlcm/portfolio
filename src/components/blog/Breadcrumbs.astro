---
import { Icon } from 'astro-icon/components';

export interface BreadcrumbItem {
	label: string;
	href?: string;
}

export interface Props {
	items: BreadcrumbItem[];
	class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumbs" class={`flex items-center text-xs sm:text-sm font-outfit text-task-gray ${className}`}>
	<ol class="flex flex-wrap items-center gap-1.5 sm:gap-2">
		{
			items.map((item, index) => {
				const isLast = index === items.length - 1;
				return (
					<li class="flex items-center gap-1.5 sm:gap-2">
						{index > 0 && (
							<Icon name="lucide:chevron-right" class="size-3.5 shrink-0 text-task-gray/60" aria-hidden="true" />
						)}
						{isLast || !item.href ? (
							<span class="font-medium text-task-dark truncate max-w-50 sm:max-w-sm md:max-w-md" aria-current="page">
								{item.label}
							</span>
						) : (
							<a
								href={item.href}
								class="transition-colors hover:text-task-dark hover:underline underline-offset-2"
							>
								{item.label}
							</a>
						)}
					</li>
				);
			})
		}
	</ol>
</nav>
