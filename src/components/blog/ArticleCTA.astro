---
import { Icon } from 'astro-icon/components';
import { getWhatsAppUrl } from '../../data/contact';

export interface Props {
	category?: string;
	class?: string;
}

const { category, class: className = '' } = Astro.props;
const waUrl = getWhatsAppUrl('pt-BR');
const badgeText = category ? `CONSULTORIA & ${category.toUpperCase()}` : 'ENGENHARIA SOB MEDIDA';
---

<div
	class:list={[
		'relative overflow-hidden rounded-3xl bg-task-dark p-7 sm:p-10 text-white shadow-xl',
		className,
	]}
>
	<!-- Background subtle pattern -->
	<div
		class="pointer-events-none absolute -right-20 -bottom-20 size-80 rounded-full bg-task-yellow/10 blur-3xl"
		aria-hidden="true"
	></div>

	<div class="relative z-10 max-w-2xl">
		<div class="inline-flex items-center gap-2 rounded-full text-xs font-semibold text-task-yellow">
			<span>{badgeText}</span>
		</div>

		<h3 class="mt-4 font-anton text-2xl uppercase tracking-tight text-white sm:text-3xl lg:text-4xl">
			Precisa de apoio técnico no seu projeto ou sistema?
		</h3>

		<p class="mt-3 font-outfit text-base text-task-cream/90 sm:text-lg leading-relaxed">
			Atuo no desenvolvimento de sistemas web sob medida, integrações de APIs e diagnóstico de performance. Atendimento direto com o desenvolvedor, sem intermediários.
		</p>

		<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
			<a
				href={waUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center justify-center gap-2 rounded-xl bg-task-yellow px-6 py-3.5 font-outfit text-sm font-semibold text-task-dark transition-all duration-200 hover:-translate-y-0.5 hover:bg-yellow-300 active:scale-95 shadow-md"
			>
				<Icon name="simple-icons:whatsapp" class="size-4 text-task-dark" />
				<span>Conversar no WhatsApp</span>
			</a>

			<a
				href="/#servicos"
				class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 font-outfit text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-white/10 active:scale-95"
			>
				<span>Ver serviços e especialidades</span>
				<Icon name="lucide:arrow-up-right" class="size-4" />
			</a>
		</div>
	</div>
</div>
