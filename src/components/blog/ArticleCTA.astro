---
import { Icon } from 'astro-icon/components';
import type { SupportedLanguage } from '../../i18n/ui';
import { getWhatsAppUrl } from '../../data/contact';

export interface Props {
	category?: string;
	class?: string;
	lang?: SupportedLanguage;
}

const { category, class: className = '', lang = 'pt-BR' } = Astro.props;
const waUrl = getWhatsAppUrl(lang);

const badgeText = category
	? lang === 'en'
		? `CONSULTING & ${category.toUpperCase()}`
		: lang === 'es'
			? `CONSULTORÍA & ${category.toUpperCase()}`
			: `CONSULTORIA & ${category.toUpperCase()}`
	: lang === 'en'
		? 'CUSTOM ENGINEERING'
		: lang === 'es'
			? 'INGENIERÍA A MEDIDA'
			: 'ENGENHARIA SOB MEDIDA';

const title =
	lang === 'en'
		? 'Need technical support for your software architecture or systems?'
		: lang === 'es'
			? '¿Necesitas apoyo técnico en tu arquitectura o sistemas de software?'
			: 'Precisa de apoio técnico no seu projeto ou sistema?';

const description =
	lang === 'en'
		? 'I build resilient custom web systems, high-throughput API integrations, and performance diagnostics. Direct collaboration with the engineer, zero intermediaries.'
		: lang === 'es'
			? 'Desarrollo sistemas web a medida, integraciones de APIs y diagnóstico de rendimiento. Comunicación directa con el desarrollador, sin intermediarios.'
			: 'Atuo no desenvolvimento de sistemas web sob medida, integrações de APIs e diagnóstico de performance. Atendimento direto com o desenvolvedor, sem intermediários.';

const ctaPrimary =
	lang === 'en' ? 'Chat on WhatsApp' : lang === 'es' ? 'Hablar por WhatsApp' : 'Conversar no WhatsApp';

const ctaSecondary =
	lang === 'en'
		? 'View services and capabilities'
		: lang === 'es'
			? 'Ver servicios y especialidades'
			: 'Ver serviços e especialidades';

const servicesHref = lang === 'pt-BR' ? '/#servicos' : `/${lang}/#services`;
---

<div
	class:list={[
		'relative overflow-hidden rounded-3xl bg-task-dark p-7 sm:p-10 text-white shadow-xl',
		className,
	]}
>
	<!-- Background subtle pattern -->
	<div
		class="pointer-events-none absolute -right-20 -bottom-20 size-80 rounded-full bg-task-yellow/10 blur-3xl"
		aria-hidden="true"
	></div>

	<div class="relative z-10 max-w-2xl">
		<div class="inline-flex items-center gap-2 rounded-full text-xs font-semibold text-task-yellow">
			<span>{badgeText}</span>
		</div>

		<h3 class="mt-4 font-anton text-2xl uppercase tracking-tight text-white sm:text-3xl lg:text-4xl">
			{title}
		</h3>

		<p class="mt-3 font-outfit text-base text-task-cream/90 sm:text-lg leading-relaxed">
			{description}
		</p>

		<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
			<a
				href={waUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center justify-center gap-2 rounded-xl bg-task-yellow px-6 py-3.5 font-outfit text-sm font-semibold text-task-dark transition-all duration-200 hover:-translate-y-0.5 hover:bg-yellow-300 active:scale-95 shadow-md"
			>
				<Icon name="simple-icons:whatsapp" class="size-4 text-task-dark" />
				<span>{ctaPrimary}</span>
			</a>

			<a
				href={servicesHref}
				class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 font-outfit text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-white/10 active:scale-95"
			>
				<span>{ctaSecondary}</span>
				<Icon name="lucide:arrow-up-right" class="size-4" />
			</a>
		</div>
	</div>
</div>
