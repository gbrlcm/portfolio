---
export interface Props {
	currentPage: number;
	totalPages: number;
	basePath?: string;
	prevLabel?: string;
	nextLabel?: string;
}

const {
	currentPage,
	totalPages,
	basePath = '/pt/blog',
	prevLabel = '← Anterior',
	nextLabel = 'Próxima →',
} = Astro.props;

function getPageUrl(p: number) {
	if (p === 1) return basePath;
	return `${basePath}/page/${p}`;
}

// Generate pagination range with ellipsis if many pages
function getPaginationItems(current: number, total: number) {
	if (total <= 7) {
		return Array.from({ length: total }, (_, i) => i + 1);
	}

	const items: (number | string)[] = [];

	// Always include first page
	items.push(1);

	if (current > 3) {
		items.push('...');
	}

	const start = Math.max(2, current - 1);
	const end = Math.min(total - 1, current + 1);

	for (let i = start; i <= end; i++) {
		items.push(i);
	}

	if (current < total - 2) {
		items.push('...');
	}

	// Always include last page
	items.push(total);

	return items;
}

const paginationItems = getPaginationItems(currentPage, totalPages);
---

{
	totalPages > 1 && (
		<nav data-blog-pagination aria-label="Paginação do blog" class="mt-12 flex flex-wrap items-center justify-center gap-2">
			{currentPage > 1 && (
				<a
					href={getPageUrl(currentPage - 1)}
					class="rounded-xl border border-task-border bg-white px-4 py-2 font-outfit text-sm font-semibold text-task-dark transition-colors hover:bg-task-border/40"
					aria-label={prevLabel}
				>
					{prevLabel}
				</a>
			)}

			{paginationItems.map((item) => {
				if (typeof item === 'string') {
					return (
						<span
							class="px-2 py-2 font-outfit text-sm font-semibold text-task-gray"
							aria-hidden="true"
						>
							{item}
						</span>
					);
				}

				const isCurrent = item === currentPage;
				if (isCurrent) {
					return (
						<span
							class="rounded-xl border border-task-border bg-task-dark px-4 py-2 font-outfit text-sm font-semibold text-white shadow-xs"
							aria-current="page"
						>
							{item}
						</span>
					);
				}

				return (
					<a
						href={getPageUrl(item)}
						class="rounded-xl border border-task-border bg-white px-4 py-2 font-outfit text-sm font-semibold text-task-dark transition-colors hover:bg-task-border/40"
					>
						{item}
					</a>
				);
			})}

			{currentPage < totalPages && (
				<a
					href={getPageUrl(currentPage + 1)}
					class="rounded-xl border border-task-border bg-white px-4 py-2 font-outfit text-sm font-semibold text-task-dark transition-colors hover:bg-task-border/40"
					aria-label={nextLabel}
				>
					{nextLabel}
				</a>
			)}
		</nav>
	)
}
