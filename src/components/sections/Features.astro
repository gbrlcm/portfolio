---
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();
---

<section class="relative w-full overflow-hidden px-4 pt-20 md:px-8 md:pt-28" id="features">
	<div class="mx-auto w-full max-w-[920px]">
		<!-- Title -->
		<div class="mb-10 text-center md:mb-14">
			<h2 class="font-anton text-3xl leading-tight text-task-dark sm:text-4xl md:text-[52px]">
				{t.features.title}
			</h2>
		</div>

		<!-- 3 Cards Grid -->
		<div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
			{
				t.features.items.map((item) => (
					<div class="flex flex-col items-start rounded-[50px] bg-white p-8 sm:p-10 transition-transform duration-300 hover:-translate-y-1 hover:shadow-md">
						<!-- Badge Number -->
						<div class="flex size-14 items-center justify-center rounded-[20px] bg-task-cream">
							<span class="font-archivo text-[15px] font-normal text-task-dark">
								{item.badge}
							</span>
						</div>

						<!-- Text Content -->
						<div class="mt-8 flex flex-col gap-4">
							<h3 class="font-anton text-2xl leading-tight text-task-dark sm:text-3xl lg:text-[34px]">
								{item.title}
							</h3>
							<p class="font-outfit text-base leading-relaxed text-task-gray">
								{item.desc}
							</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
