---
import { Icon } from 'astro-icon/components';
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { getWhatsAppUrl } from '../../data/contact';
import { heroImageConfig } from '../../data/site';
import CoreLanguages from '../ui/CoreLanguages.astro';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();
const waUrl = getWhatsAppUrl(lang);

const titlePrefix = t.hero.titlePrefix ?? 'Sou Gabriel Campos, desenvolvedor full stack ';
const typewriterPhrases = t.hero.typewriterPhrases ?? ['construindo o futuro da web.'];
const initialPhrase = typewriterPhrases[0] ?? 'construindo o futuro da web.';
---

<section class="relative w-full overflow-visible px-4 pt-10 pb-0 md:px-8 md:pt-14" id="home">
	<div class="mx-auto flex w-full max-w-270 flex-col items-center lg:max-w-300 lg:flex-row lg:items-center lg:justify-between lg:gap-12 xl:gap-16">
		<!-- Main H1 Heading & Personal Intro -->
		<div class="mb-8 w-full text-center md:mb-10 lg:mb-0 lg:w-5/12 lg:text-left xl:w-5/12 flex flex-col items-center lg:items-start">
			<!-- Main Name Heading (H1) -->
			<h1 class="font-anton text-[36px] leading-[1.08] text-task-dark sm:text-[48px] md:text-[58px] lg:text-[44px] xl:text-[54px] max-w-5xl uppercase tracking-tight">
				<span>{titlePrefix}</span><span class="inline text-task-dark"
					><span
						id="hero-typewriter-text"
						data-phrases={JSON.stringify(typewriterPhrases)}
					>{initialPhrase}</span><span
						id="hero-typewriter-cursor"
						class="hero-typewriter-cursor"
						aria-hidden="true"
					></span></span
				>
			</h1>

			<!-- Experience Statement -->
			<p class="mt-4 font-outfit text-base sm:text-lg text-task-dark/85 max-w-xl leading-relaxed">
				{t.hero.experience}
			</p>

			<!-- Core Languages (Desktop only: visible on lg+) -->
			<CoreLanguages lang={lang} align="left" class="hidden lg:flex" />
		</div>

		<!-- Hero Image Wrapper with Corner Tab Card -->
		<div class="relative w-full lg:w-7/12 xl:w-7/12">
			<!-- Banner Image -->
			<div class="relative h-70 w-full overflow-hidden rounded-[30px] sm:h-95 md:h-115 lg:h-80 xl:h-96 lg:rounded-[40px]">
				<img
					src={heroImageConfig.src}
					srcset={heroImageConfig.srcset}
					sizes={heroImageConfig.sizes}
					alt={t.hero.imageAlt}
					title={t.hero.imageTitle}
					class="size-full object-cover object-bottom"
					width={heroImageConfig.width}
					height={heroImageConfig.height}
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>

			<!-- Overlapping Bottom White Card -->
			<div class="relative z-10 -mt-16 w-full rounded-b-[40px] rounded-tr-[40px] bg-task-white px-6 pt-12 pb-10 shadow-sm md:-mt-24 md:px-10 md:pt-16 md:pb-14 lg:-mt-20 lg:px-8 lg:pt-14 lg:pb-10 xl:px-12 xl:pt-16 xl:pb-12">
				<!-- Top-Left Corner Cutout Mask -->
				<div class="pointer-events-none absolute -top-12 left-0 h-12.5 w-52.5 sm:-top-16.5 sm:h-17 sm:w-65 lg:-top-16.75 lg:w-75 xl:w-90.5" aria-hidden="true">
					<!-- SVG for Desktop -->
					<svg
						viewBox="0 0 362 68"
						class="hidden size-full lg:block"
						fill="none"
						preserveAspectRatio="none"
					>
						<path
							d="M 0 32.478 C 0 14.541 13.04 0 29.126 0 L 247.92 0 C 255.57 0 262.913 3.356 268.362 9.343 L 319.806 65.863 C 321.052 67.232 322.732 68 324.482 68 L 0 68 Z"
							fill="#fdfffe"
						></path>
					</svg>

					<!-- SVG for Tablet -->
					<svg
						viewBox="0 0 260 68"
						class="hidden size-full sm:block lg:hidden"
						fill="none"
						preserveAspectRatio="none"
					>
						<path
							d="M 0 32.478 C 0 14.541 10.449 0 23.338 0 L 198.653 0 C 204.783 0 210.666 3.356 215.033 9.343 L 256.254 65.863 C 257.252 67.232 258.598 68 260 68 L 0 68 Z"
							fill="#fdfffe"
						></path>
					</svg>

					<!-- SVG for Mobile -->
					<svg
						viewBox="0 0 210 50"
						class="block size-full sm:hidden"
						fill="none"
						preserveAspectRatio="none"
					>
						<path
							d="M 0 23.881 C 0 10.692 8.439 0 18.85 0 L 160.451 0 C 165.402 0 170.154 2.468 173.68 6.87 L 206.974 48.428 C 207.781 49.435 208.868 50 210 50 L 0 50 Z"
							fill="#fdfffe"
						></path>
					</svg>

					<!-- Corner Badge Icon -->
					<Icon
						name="lucide:code-xml"
						class="absolute top-[52%] left-5 size-4 -translate-y-1/2 text-task-dark sm:left-8 sm:size-5 lg:left-8 lg:size-5 xl:left-10 xl:size-6"
					/>
				</div>

				<!-- Card Content: Subtitle, CTAs and Trust note -->
				<div class="flex flex-col items-start gap-5 w-full text-left">
					<p class="font-outfit text-xl font-medium leading-snug text-task-dark sm:text-2xl lg:text-lg xl:text-2xl max-w-3xl">
						{t.hero.subtitle}
					</p>

					<!-- Action Buttons -->
					<div class="flex w-full flex-col gap-3.5 pt-1">
						<a
							href={waUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="group flex w-full items-center gap-2 transition-transform duration-200 active:scale-95"
							aria-label={t.hero.ctaPrimary}
						>
							<!-- Wrapper (Text Pill) -->
							<div
								class="flex flex-1 h-12 sm:h-13 items-center justify-center gap-2.5 rounded-full bg-task-yellow px-5 sm:px-8 shadow-xs transition-all duration-200 group-hover:brightness-105"
							>
								<Icon name="simple-icons:whatsapp" class="size-5 shrink-0 text-task-dark transition-transform duration-200 group-hover:scale-110" />
								<span class="font-outfit text-base sm:text-lg font-semibold tracking-tight text-task-dark">
									{t.hero.ctaPrimary}
								</span>
							</div>

							<!-- Arrow Circle -->
							<div
								class="relative flex size-12 sm:size-13 shrink-0 items-center justify-center overflow-hidden rounded-full bg-task-yellow shadow-xs transition-all duration-200 group-hover:brightness-105"
							>
								<!-- Icon 1 (slides out top-right on hover) -->
								<svg
									class="size-4.5 sm:size-5 text-task-dark transition-transform duration-300 ease-out group-hover:translate-x-6 group-hover:-translate-y-6"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M 16.167 19.217 L 19.217 7.833 L 7.833 4.783 M 4.783 16.166 L 19.217 7.833" />
								</svg>

								<!-- Icon 2 (slides in from bottom-left on hover) -->
								<svg
									class="absolute size-4.5 sm:size-5 -translate-x-6 translate-y-6 text-task-dark transition-transform duration-300 ease-out group-hover:translate-x-0 group-hover:translate-y-0"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M 16.167 19.217 L 19.217 7.833 L 7.833 4.783 M 4.783 16.166 L 19.217 7.833" />
								</svg>
							</div>
						</a>
						<a
							href="#servicos"
							class="group flex w-full items-center gap-2 transition-transform duration-200 active:scale-95"
							aria-label={t.hero.ctaSecondary}
						>
							<!-- Wrapper (Text Pill) -->
							<div
								class="flex flex-1 h-12 sm:h-13 items-center justify-center gap-2.5 rounded-full border border-task-border bg-white px-5 sm:px-8 shadow-2xs transition-all duration-200 group-hover:border-task-dark group-hover:bg-task-bg"
							>
								<Icon name="lucide:layers" class="size-5 shrink-0 text-task-dark transition-transform duration-200 group-hover:scale-110" />
								<span class="font-outfit text-sm sm:text-base font-semibold text-task-dark whitespace-nowrap">
									{t.hero.ctaSecondary}
								</span>
							</div>

							<!-- Arrow Circle -->
							<div
								class="relative flex size-12 sm:size-13 shrink-0 items-center justify-center overflow-hidden rounded-full border border-task-border bg-white shadow-2xs transition-all duration-200 group-hover:border-task-dark group-hover:bg-task-bg"
							>
								<!-- Icon 1 (slides out down on hover) -->
								<Icon
									name="lucide:arrow-down"
									class="size-4.5 sm:size-5 text-task-dark transition-all duration-300 ease-out group-hover:translate-y-9 group-hover:opacity-0"
								/>

								<!-- Icon 2 (slides in from top on hover) -->
								<Icon
									name="lucide:arrow-down"
									class="absolute size-4.5 sm:size-5 -translate-y-9 opacity-0 text-task-dark transition-all duration-300 ease-out group-hover:translate-y-0 group-hover:opacity-100"
								/>
							</div>
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Core Languages (Mobile/Tablet only: below the card on < lg screens) -->
		<CoreLanguages lang={lang} align="center" class="flex lg:hidden" />
	</div>
</section>

<style>
	.hero-typewriter-cursor {
		display: inline-block;
		width: 3px;
		height: 0.82em;
		margin-left: 0.18em;
		background-color: currentColor;
		vertical-align: baseline;
		transform: translateY(1px);
		animation: hero-cursor-blink 0.9s steps(1, start) infinite;
	}

	@media (min-width: 640px) {
		.hero-typewriter-cursor {
			width: 4px;
		}
	}

	@media (min-width: 1024px) {
		.hero-typewriter-cursor {
			width: 5px;
		}
	}

	.hero-typewriter-cursor.is-typing {
		animation: none;
		opacity: 1;
	}

	@keyframes hero-cursor-blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-typewriter-cursor {
			display: none;
		}
	}
</style>

<script>
	let typewriterTimer: ReturnType<typeof setTimeout> | undefined;

	function initTypewriter() {
		if (typewriterTimer) {
			clearTimeout(typewriterTimer);
			typewriterTimer = undefined;
		}

		const textEl = document.getElementById('hero-typewriter-text');
		const cursorEl = document.getElementById('hero-typewriter-cursor');
		if (!textEl) return;

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			return;
		}

		let phrases: string[] = [];
		try {
			phrases = JSON.parse(textEl.dataset.phrases || '[]');
		} catch {
			phrases = [];
		}

		if (!Array.isArray(phrases) || phrases.length <= 1) return;

		let phraseIndex = 0;
		let charIndex = phrases[0].length;
		let isDeleting = true;

		const TYPING_SPEED = 65;
		const DELETING_SPEED = 30;
		const PAUSE_AFTER_COMPLETE = 2400;
		const PAUSE_BEFORE_NEXT = 350;

		function setTypingState(typing: boolean) {
			if (cursorEl) {
				if (typing) {
					cursorEl.classList.add('is-typing');
				} else {
					cursorEl.classList.remove('is-typing');
				}
			}
		}

		function tick() {
			if (!textEl) return;
			const currentPhrase = phrases[phraseIndex];

			if (isDeleting) {
				setTypingState(true);
				charIndex--;
				textEl.textContent = currentPhrase.substring(0, charIndex);

				if (charIndex <= 0) {
					isDeleting = false;
					phraseIndex = (phraseIndex + 1) % phrases.length;
					setTypingState(false);
					typewriterTimer = setTimeout(tick, PAUSE_BEFORE_NEXT);
					return;
				}

				typewriterTimer = setTimeout(tick, DELETING_SPEED);
			} else {
				setTypingState(true);
				charIndex++;
				textEl.textContent = currentPhrase.substring(0, charIndex);

				if (charIndex >= currentPhrase.length) {
					isDeleting = true;
					setTypingState(false);
					typewriterTimer = setTimeout(tick, PAUSE_AFTER_COMPLETE);
					return;
				}

				typewriterTimer = setTimeout(tick, TYPING_SPEED);
			}
		}

		setTypingState(false);
		typewriterTimer = setTimeout(tick, PAUSE_AFTER_COMPLETE);
	}

	function cleanupTypewriter() {
		if (typewriterTimer) {
			clearTimeout(typewriterTimer);
			typewriterTimer = undefined;
		}
	}

	initTypewriter();
	document.addEventListener('astro:page-load', initTypewriter);
	document.addEventListener('astro:before-swap', cleanupTypewriter);
</script>
