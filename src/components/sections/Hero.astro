---
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();
---

<section class="relative w-full overflow-visible px-4 pt-10 pb-0 md:px-8 md:pt-14" id="home">
	<div class="mx-auto flex w-full max-w-270 flex-col items-center">
		<!-- Main H1 Heading -->
		<div class="mb-6 w-full text-center md:mb-10">
			<h1 class="font-anton text-[46px] leading-[1.1] text-task-dark sm:text-[64px] md:text-[76px] lg:text-[94px]">
				{t.hero.title}
			</h1>
		</div>

		<!-- Hero Image Wrapper with Corner Tab Card -->
		<div class="relative w-full">
			<!-- Banner Image -->
			<div class="relative h-70 w-full overflow-hidden rounded-[30px] sm:h-95 md:h-115 lg:h-130 lg:rounded-[50px]">
				<img
					src="/images/hero.webp"
					alt="Gabriel Campos"
					class="size-full object-cover object-bottom"
					width="1080"
					height="520"
					loading="eager"
				/>
			</div>

			<!-- Overlapping Bottom White Card (Framer yn62o9) -->
			<div class="relative z-10 -mt-16 w-full rounded-b-[40px] rounded-tr-[40px] bg-task-white px-6 pt-12 pb-10 shadow-sm md:-mt-24 md:px-10 md:pt-16 md:pb-14 lg:-mt-28 lg:px-14 lg:pt-20 lg:pb-16">
				<!-- Signature Framer Top-Left Corner Cutout Mask -->
				<div class="pointer-events-none absolute -top-12 left-0 h-12.5 w-52.5 sm:-top-16.5 sm:h-17 sm:w-65 lg:-top-16.75 lg:w-90.5">
					<!-- SVG for Desktop -->
					<svg
						viewBox="0 0 362 68"
						class="hidden size-full lg:block"
						fill="none"
						preserveAspectRatio="none"
					>
						<path
							d="M 0 32.478 C 0 14.541 13.04 0 29.126 0 L 247.92 0 C 255.57 0 262.913 3.356 268.362 9.343 L 319.806 65.863 C 321.052 67.232 322.732 68 324.482 68 L 0 68 Z"
							fill="#fdfffe"
						></path>
					</svg>

					<!-- SVG for Tablet -->
					<svg
						viewBox="0 0 260 68"
						class="hidden size-full sm:block lg:hidden"
						fill="none"
						preserveAspectRatio="none"
					>
						<path
							d="M 0 32.478 C 0 14.541 10.449 0 23.338 0 L 198.653 0 C 204.783 0 210.666 3.356 215.033 9.343 L 256.254 65.863 C 257.252 67.232 258.598 68 260 68 L 0 68 Z"
							fill="#fdfffe"
						></path>
					</svg>

					<!-- SVG for Mobile -->
					<svg
						viewBox="0 0 210 50"
						class="block size-full sm:hidden"
						fill="none"
						preserveAspectRatio="none"
					>
						<path
							d="M 0 23.881 C 0 10.692 8.439 0 18.85 0 L 160.451 0 C 165.402 0 170.154 2.468 173.68 6.87 L 206.974 48.428 C 207.781 49.435 208.868 50 210 50 L 0 50 Z"
							fill="#fdfffe"
						></path>
					</svg>

					<!-- Corner Badge Text -->
					<span class="absolute top-[52%] left-5 -translate-y-1/2 font-outfit text-sm font-medium text-task-dark sm:left-8 sm:text-base lg:left-10 lg:text-xl">
						{t.hero.badge}
					</span>
				</div>

				<!-- Card Content: Subtitle -->
				<div class="flex flex-col items-center justify-between gap-8 lg:flex-row lg:gap-14">
					<!-- Subtitle -->
					<div class="w-full text-center lg:text-left">
						<p class="font-outfit text-xl font-medium leading-snug text-task-dark sm:text-2xl lg:text-[28px]">
							{t.hero.subtitle}
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
