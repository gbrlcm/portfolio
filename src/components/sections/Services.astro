---
import { Icon } from 'astro-icon/components';
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import CarouselView, { type CarouselItem } from '../ui/CarouselView.astro';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();

const carouselItems: CarouselItem[] = t.services.items.map((service, index) => ({
	id: index,
	label: service.label,
	title: service.title,
	desc: service.desc,
	image: service.image,
	href: '#contato',
	ctaText: t.services.readMore,
	ctaTextShort: t.services.readMoreShort,
}));
---

<section class="relative w-full overflow-hidden px-4 pt-20 md:px-8 md:pt-28" id="servicos">
	<div class="mx-auto w-full max-w-270 rounded-[50px] bg-task-dark px-5 py-14 sm:px-8 sm:py-16 md:px-14 md:py-20">
		<!-- Section Header: Title + Slider Controls -->
		<div class="mb-10 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center md:mb-14">
				<h2 class="font-anton text-3xl leading-tight text-white sm:text-4xl md:text-[52px]">
					{t.services.title}
				</h2>

			<!-- Slider Pagination Buttons -->
			<div class="flex items-center gap-2.5 self-end sm:self-auto">
				<button
					type="button"
					id="services-prev"
					class="flex size-13 items-center justify-center rounded-2xl bg-task-yellow text-task-dark transition-all duration-200 hover:brightness-105 active:scale-90 disabled:cursor-not-allowed disabled:opacity-30"
					aria-label="Previous service"
				>
					<Icon name="lucide:arrow-left" class="size-7" />
				</button>
				<button
					type="button"
					id="services-next"
					class="flex size-13 items-center justify-center rounded-2xl bg-task-yellow text-task-dark transition-all duration-200 hover:brightness-105 active:scale-90 disabled:cursor-not-allowed disabled:opacity-30"
					aria-label="Next service"
				>
					<Icon name="lucide:arrow-right" class="size-7" />
				</button>
			</div>
		</div>

		<!-- Material Design 3 CarouselView -->
		<CarouselView
			items={carouselItems}
			id="services-m3-carousel"
			prevBtnId="services-prev"
			nextBtnId="services-next"
			showControls={false}
			showIndicators={true}
			cardHeight="h-[440px] sm:h-[480px] md:h-[500px]"
		/>
	</div>
</section>

