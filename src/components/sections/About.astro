---
import TechMarquee from '../ui/TechMarquee.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();
---

<section class="relative w-full overflow-hidden px-4 pt-20 md:px-8 md:pt-28" id="sobre">
	<div class="mx-auto w-full max-w-270">
		<div class="mb-10 text-center md:mb-14">
			<h2 class="text-3xl leading-tight sm:text-4xl md:text-[52px] tracking-tight font-anton uppercase">
				<span class="">
					{t.about.titlePrefix}
				</span>{' '}
				<span>
					{t.about.firstName}
				</span>{' '}
				<span>
					{t.about.lastName}
				</span>
			</h2>
		</div>
		
		<div class="rounded-[50px] bg-white p-8 sm:p-12 md:p-16 shadow-xs">

			<!-- Bio Section -->
			<div>
				<div class="mb-4">
					<span class="font-outfit text-xs font-semibold uppercase tracking-wider text-task-gray">
						{t.about.bioSubtitle}
					</span>
				</div>
				<div class="flex flex-col gap-5 font-outfit text-base sm:text-lg leading-relaxed text-task-dark/85 max-w-3xl">
					<p>{t.about.bio1}</p>
					<p>{t.about.bio2}</p>
				</div>
			</div>

			<!-- Technologies Carousel -->
			<div class="mt-10 border-t border-task-border/60 pt-6">
				<div class="mb-4">
					<span class="font-outfit text-xs font-semibold uppercase tracking-wider text-task-gray">
						{t.about.profStackTitle}
					</span>
				</div>
				<TechMarquee />
			</div>

			<!-- Profile External Links -->
			<div class="mt-8 border-t border-task-border/60 pt-6">
				<div class="mb-4">
					<span class="font-outfit text-xs font-semibold uppercase tracking-wider text-task-gray">
						{t.about.linksSubtitle}
					</span>
				</div>
				<SocialLinks lang={lang} variant="light" />
			</div>
		</div>
	</div>
</section>
