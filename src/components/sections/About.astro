---
import { Icon } from 'astro-icon/components';
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { SOCIAL_LINKS } from '../../data/contact';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();
---

<section class="relative w-full overflow-hidden px-4 pt-20 md:px-8 md:pt-28" id="sobre">
	<div class="mx-auto w-full max-w-270">
		<div class="mb-10 text-center md:mb-14">
			<h2 class="font-anton text-3xl leading-tight text-task-dark sm:text-4xl md:text-[50px] uppercase">
				{t.about.title}
			</h2>
		</div>
		
		<div class="rounded-[50px] bg-white p-8 sm:p-12 md:p-16 shadow-xs">

			<!-- Bio Paragraphs -->
			<div class="flex flex-col gap-5 font-outfit text-base sm:text-lg leading-relaxed text-task-dark/85 max-w-3xl">
				<p>{t.about.bio1}</p>
				<p>{t.about.bio2}</p>
			</div>

			<!-- Professional Stack -->
			<div class="mt-10 grid grid-cols-1 gap-6 border-t border-task-border/60 pt-8">
				<div class="flex flex-col gap-2">
					<span class="font-outfit text-xs font-semibold uppercase tracking-wider text-task-gray">
						{t.about.profStackTitle}
					</span>
					<span class="font-mono text-sm text-task-dark font-medium">
						{t.about.profStack}
					</span>
				</div>
			</div>

			<!-- Profile External Links -->
			<div class="mt-8 flex flex-wrap items-center gap-4 border-t border-task-border/60 pt-6">
				<a
					href={SOCIAL_LINKS.github}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-full border border-task-border bg-task-bg px-4 py-2 font-outfit text-xs font-semibold text-task-dark transition-colors hover:border-task-dark"
				>
					<Icon name="simple-icons:github" class="size-4" />
					<span>{t.about.githubLabel}</span>
				</a>
				<a
					href={SOCIAL_LINKS.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-full border border-task-border bg-task-bg px-4 py-2 font-outfit text-xs font-semibold text-task-dark transition-colors hover:border-task-dark"
				>
					<Icon name="simple-icons:linkedin" class="size-4" />
					<span>{t.about.linkedinLabel}</span>
				</a>
			</div>
		</div>
	</div>
</section>
