---
import Section from '../ui/Section.astro';
import { process } from '../../data/services';
---

<Section
	id="processo"
	label="— Como funciona"
	title="Do formulário ao ar em quatro passos."
>
	<ol class="grid gap-px overflow-hidden rounded-2xl border border-(--line) bg-(--line) md:grid-cols-4">
		{
			process.map((step, index) => (
				<li class="group relative flex flex-col gap-3 bg-(--bg) p-6 transition-colors duration-500 hover:bg-(--bg-elev)">
					<div class="flex items-center justify-between">
						<span class="label !text-(--accent)">{step.code}</span>
						<span class="font-mono text-[0.6875rem] text-(--fg-faint)">
							{String(index + 1).padStart(2, '0')}/{String(process.length).padStart(2, '0')}
						</span>
					</div>
					<h3 class="font-display text-xl leading-tight tracking-tight">{step.title}</h3>
					<p class="text-sm leading-relaxed text-(--fg-muted)">{step.summary}</p>
					<span class="absolute inset-x-0 bottom-0 h-px scale-x-0 bg-(--accent) transition-transform duration-700 ease-(--ease-out-expo) group-hover:scale-x-100" />
				</li>
			))
		}
	</ol>
</Section>
