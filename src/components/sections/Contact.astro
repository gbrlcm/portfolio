---
import Section from '../ui/Section.astro';
import { contacts } from '../../data/contact';
import { site } from '../../data/site';
---

<Section
	id="contato"
	label="— Contato"
	title="Quatro canais, um interlocutor."
	lede="Escolha o que preferir. Atendo em português, inglês e mandarim."
>
	<ul class="grid gap-px overflow-hidden rounded-2xl border border-(--line) bg-(--line) sm:grid-cols-2">
		{
			contacts.map((contact) => (
				<li class="group relative bg-(--bg) transition-colors duration-500 hover:bg-(--bg-elev)">
					{contact.href ? (
						<a
							href={contact.href}
							target={contact.id === 'email' ? undefined : '_blank'}
							rel="noopener noreferrer"
							class="flex items-start justify-between gap-4 p-6"
						>
							<span class="flex flex-col gap-1.5">
								<span class="flex items-center gap-2.5">
									<span class="font-medium">{contact.label}</span>
									{contact.primary && (
										<span class="rounded-full bg-(--accent) px-2 py-0.5 font-mono text-[0.625rem] tracking-wider text-(--accent-fg) uppercase">
											Principal
										</span>
									)}
								</span>
								<span class="font-mono text-sm text-(--fg-muted)">{contact.value}</span>
								{contact.note && <span class="text-xs text-(--fg-faint)">{contact.note}</span>}
							</span>
							<span class="font-mono text-xs text-(--fg-faint) transition-all duration-500 ease-(--ease-out-expo) group-hover:translate-x-0.5 group-hover:text-(--accent)">
								{contact.href ? '↗' : '⧉'}
							</span>
						</a>
					) : (
						<button
							type="button"
							data-copy={contact.value}
							class="flex w-full items-start justify-between gap-4 p-6 text-left"
						>
							<span class="flex flex-col gap-1.5">
								<span class="flex items-center gap-2.5">
									<span class="font-medium">{contact.label}</span>
								</span>
								<span class="font-mono text-sm text-(--fg-muted)">{contact.value}</span>
								{contact.note && <span class="text-xs text-(--fg-faint)">{contact.note}</span>}
							</span>
							<span class="font-mono text-xs text-(--fg-faint) transition-all duration-500 ease-(--ease-out-expo) group-hover:translate-x-0.5 group-hover:text-(--accent)">
								⧉
							</span>
						</button>
					)}
				</li>
			))
		}
	</ul>

	<p class="mt-6 font-mono text-xs text-(--fg-faint)">
		{site.location} · {site.responseTime}
	</p>
</Section>

<script>
	const toast = document.createElement('p');
	toast.setAttribute('role', 'status');
	toast.className =
		'pointer-events-none fixed bottom-6 left-1/2 z-100 -translate-x-1/2 rounded-full border border-(--line-strong) bg-(--bg-elev) px-5 py-2.5 font-mono text-xs opacity-0 transition-opacity duration-300';
	document.body.append(toast);

	let toastTimer: ReturnType<typeof setTimeout>;

	document.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) => {
		el.addEventListener('click', async () => {
			const value = el.dataset.copy;
			if (!value) return;

			try {
				await navigator.clipboard.writeText(value);
				toast.textContent = `${el.querySelector('span')?.textContent?.trim() ?? 'Valor'} copiado: ${value}`;
			} catch {
				toast.textContent = value;
			}

			toast.classList.add('opacity-100');
			clearTimeout(toastTimer);
			toastTimer = setTimeout(() => toast.classList.remove('opacity-100'), 2600);
		});
	});
</script>
