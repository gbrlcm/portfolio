---
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();
---

<section class="relative w-full overflow-hidden px-4 pt-20 md:px-8 md:pt-28" id="experiencia">
	<div class="mx-auto w-full max-w-270">
		<!-- Section Header -->
		<div class="mb-10 text-center md:mb-14">
			<h2 class="font-anton text-3xl leading-tight text-task-dark sm:text-4xl md:text-[50px] uppercase">
				{t.work.title}
			</h2>
			<p class="mx-auto mt-4 max-w-2xl font-outfit text-base text-task-gray sm:text-lg">
				{t.work.subtitle}
			</p>
		</div>

		<!-- Work Grid -->
		<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
			{
				t.work.items.map((item) => {
					const hasLink = 'linkUrl' in item && 'linkText' in item && Boolean(item.linkUrl && item.linkText);
					return (
						<article class="flex flex-col justify-between rounded-[40px] bg-white p-7 sm:p-9 shadow-xs transition-transform duration-300 hover:-translate-y-1 hover:shadow-md">
							<div>
								<!-- Category Badge -->
								<div class="inline-flex items-center rounded-full bg-task-cream/70 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-task-dark">
									{item.category}
								</div>

								<!-- Title & Description -->
								<h3 class="mt-5 font-anton text-2xl leading-snug text-task-dark">
									{item.title}
								</h3>
								<p class="mt-3 font-outfit text-sm sm:text-base leading-relaxed text-task-gray">
									{item.desc}
								</p>
							</div>

							<!-- Stack & Optional Link -->
							<div class="mt-6 flex flex-col gap-3 border-t border-task-border/60 pt-4">
								<span class="font-mono text-xs text-task-gray">
									{item.stack}
								</span>
								{hasLink && (
									<a
										href={(item as { linkUrl: string }).linkUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1.5 font-outfit text-xs font-semibold text-task-dark hover:underline"
									>
										<span>{(item as { linkText: string }).linkText}</span>
									</a>
								)}
							</div>
						</article>
					);
				})
			}
		</div>
	</div>
</section>
