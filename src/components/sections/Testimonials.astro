---
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();
const hasTestimonials = Boolean(t.testimonials?.items && t.testimonials.items.length > 0);
---

{
	hasTestimonials && (
		<section class="relative w-full overflow-hidden px-4 pt-20 md:px-8 md:pt-28" id="testimonials">
			<div class="mx-auto w-full max-w-270">
				<h2 class="font-anton text-3xl leading-tight text-task-dark sm:text-4xl md:text-[52px]">
					{t.testimonials.title}
				</h2>
				<div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
					{t.testimonials.items.map((item) => (
						<article class="flex flex-col justify-between rounded-[40px] bg-white p-8 shadow-sm">
							<p class="font-outfit text-base leading-relaxed text-task-gray">
								"{item.quote}"
							</p>
							<div class="mt-6 flex flex-col">
								<h4 class="font-anton text-lg leading-tight text-task-dark">
									{item.name}
								</h4>
								<span class="font-outfit text-sm font-medium text-task-gray">
									{item.role}
								</span>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	)
}
