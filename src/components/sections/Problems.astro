---
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();
---

<section class="relative w-full overflow-hidden px-4 pt-20 md:px-8 md:pt-28" id="problemas">
	<div class="mx-auto w-full max-w-270">
		<!-- Section Header -->
		<div class="mb-10 text-center md:mb-14">
			<h2 class="font-anton text-3xl leading-tight text-task-dark sm:text-4xl md:text-[50px] uppercase">
				{t.problems.title}
			</h2>
		</div>

		<!-- 3 Cards Grid -->
		<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
			{
				t.problems.items.map((item) => (
					<div class="flex flex-col items-start justify-between rounded-[40px] bg-white p-7 sm:p-9 shadow-xs transition-transform duration-300 hover:-translate-y-1 hover:shadow-md">
						<div>
							<span class="font-anton text-base tracking-wider text-task-gray">
								{item.badge}
							</span>
							
							<!-- Content -->
							<div class="mt-5 flex flex-col gap-3">
								<h3 class="font-anton text-xl leading-snug text-task-dark sm:text-2xl">
									{item.title}
								</h3>
								<p class="font-outfit text-sm sm:text-base leading-relaxed text-task-gray">
									{item.desc}
								</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
