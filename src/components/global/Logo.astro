---
export interface Props {
	href?: string;
	class?: string;
}

const { href = '/', class: className = '' } = Astro.props;
---

<a
	href={href}
	aria-label="Início"
	class:list={[
		'group inline-flex items-center gap-2.5 font-mono text-sm tracking-tight',
		className,
	]}
>
	<span class="hidden sm:inline">gabrielcampos<span class="text-(--accent)">.dev</span></span>
</a>
