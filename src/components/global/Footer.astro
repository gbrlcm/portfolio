---
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();
---

<footer class="w-full border-t border-task-border px-4 pt-20 pb-16 md:px-8">
	<div class="mx-auto flex w-full max-w-[1080px] flex-col justify-between gap-12 lg:flex-row lg:gap-16">
		<!-- Left Column: Community Subscription & Social Icons -->
		<div class="flex max-w-[320px] flex-col items-start gap-8">
			<h4 class="font-anton text-xl leading-tight text-task-dark sm:text-[22px]">
				{t.footer.joinTitle}
			</h4>

			<!-- Email Form -->
			<form class="relative w-full" onsubmit="event.preventDefault(); alert('Subscribed!');">
				<label class="relative block w-full">
					<input
						type="email"
						required
						placeholder={t.footer.emailPlaceholder}
						class="h-[52px] w-full rounded-full border border-black/10 bg-white px-6 pr-14 font-outfit text-sm text-task-dark placeholder:text-black/40 focus:border-task-dark focus:outline-none shadow-2xs"
					/>
					<button
						type="submit"
						class="absolute top-1.5 right-1.5 flex size-10 items-center justify-center rounded-full bg-task-yellow transition-transform hover:brightness-105 active:scale-95"
						aria-label="Submit email"
					>
						<svg width="18" height="18" viewBox="0 0 18 18" fill="none">
							<path
								d="M 9 17 L 17 9 L 9 1 M 1 9 L 17 9"
								stroke="#0D251A"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							></path>
						</svg>
					</button>
				</label>
			</form>

			<!-- Social Icons -->
			<div class="flex items-center gap-5 text-task-dark">
				<!-- Twitter/X -->
				<a
					href="https://x.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="transition-opacity hover:opacity-70"
					aria-label="X (formerly Twitter)"
				>
					<svg viewBox="0 0 16 14" class="h-4 w-4.5" fill="currentColor">
						<path
							d="M 14.957 1.866 C 14.397 2.123 13.805 2.283 13.181 2.379 C 13.805 1.995 14.301 1.387 14.52 0.649 C 13.908 1.009 13.246 1.268 12.557 1.418 C 11.997 0.809 11.186 0.425 10.314 0.425 C 8.633 0.424 7.269 1.828 7.261 3.566 C 7.261 3.824 7.291 4.047 7.354 4.272 C 4.889 4.143 2.592 2.944 1.029 0.97 C 0.222 2.413 0.645 4.257 1.994 5.17 C 1.506 5.141 1.029 5.01 0.592 4.785 L 0.592 4.818 C 0.592 6.357 1.651 7.639 3.053 7.929 C 2.788 7.994 2.516 8.026 2.243 8.025 C 2.056 8.025 1.838 7.991 1.651 7.958 C 2.056 9.211 3.178 10.141 4.518 10.141 C 3.429 11.01 2.093 11.483 0.717 11.488 C 0.467 11.488 0.218 11.488 0 11.454 C 1.371 12.353 2.96 12.866 4.704 12.866 C 10.346 12.866 13.429 8.056 13.429 3.887 L 13.429 3.47 C 14.021 3.053 14.552 2.508 14.957 1.866 Z"
						></path>
					</svg>
				</a>

				<!-- Facebook -->
				<a
					href="https://facebook.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="transition-opacity hover:opacity-70"
					aria-label="Facebook"
				>
					<svg viewBox="0 0 9 17" class="h-4.5 w-2.5" fill="currentColor">
						<path
							d="M 2.961 16.334 L 2.961 9.398 L 0.615 9.398 L 0.615 6.694 L 2.961 6.694 L 2.961 4.701 C 2.961 2.388 4.38 1.128 6.453 1.128 C 7.446 1.128 8.301 1.203 8.548 1.234 L 8.548 3.652 L 7.111 3.652 C 5.983 3.652 5.764 4.186 5.764 4.97 L 5.764 6.694 L 8.454 6.694 L 8.104 9.397 L 5.764 9.397 L 5.764 16.334 L 2.959 16.334 Z"
						></path>
					</svg>
				</a>

				<!-- Instagram -->
				<a
					href="https://instagram.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="transition-opacity hover:opacity-70"
					aria-label="Instagram"
				>
					<svg viewBox="0 0 17 16" class="h-4 w-4" fill="currentColor">
						<path
							d="M 8.407 1.335 C 10.386 1.335 10.62 1.342 11.402 1.377 C 11.873 1.384 12.337 1.469 12.777 1.632 C 13.423 1.881 13.934 2.391 14.185 3.038 C 14.348 3.478 14.433 3.944 14.44 4.412 C 14.475 5.194 14.483 5.429 14.483 7.406 C 14.483 9.381 14.475 9.616 14.44 10.398 C 14.434 10.866 14.348 11.332 14.185 11.772 C 13.935 12.419 13.424 12.93 12.777 13.177 C 12.337 13.34 11.872 13.427 11.402 13.433 C 10.62 13.468 10.386 13.476 8.407 13.476 C 6.427 13.476 6.193 13.468 5.413 13.433 C 4.942 13.427 4.477 13.341 4.036 13.178 C 3.391 12.929 2.88 12.418 2.63 11.772 C 2.467 11.332 2.381 10.867 2.375 10.398 C 2.339 9.616 2.332 9.381 2.332 7.404 C 2.332 5.429 2.338 5.194 2.375 4.412 C 2.38 3.944 2.466 3.478 2.63 3.038 C 2.879 2.391 3.39 1.881 4.036 1.633 C 4.476 1.469 4.942 1.384 5.413 1.377 C 6.193 1.342 6.429 1.335 8.407 1.335 Z M 8.407 0 C 6.395 0 6.142 0.009 5.351 0.045 C 4.736 0.058 4.128 0.173 3.552 0.389 C 3.057 0.575 2.61 0.866 2.24 1.243 C 1.863 1.613 1.571 2.06 1.385 2.555 C 1.169 3.13 1.052 3.738 1.04 4.353 C 1.004 5.141 0.996 5.394 0.996 7.404 C 0.996 9.414 1.004 9.668 1.041 10.458 C 1.054 11.072 1.169 11.679 1.385 12.256 C 1.571 12.75 1.863 13.196 2.24 13.567 C 2.61 13.943 3.057 14.236 3.553 14.42 C 4.128 14.637 4.738 14.753 5.352 14.765 C 6.142 14.801 6.395 14.81 8.407 14.81 C 10.421 14.81 10.672 14.801 11.463 14.765 C 12.078 14.752 12.686 14.637 13.263 14.421 C 14.256 14.036 15.042 13.25 15.429 12.255 C 15.645 11.679 15.762 11.071 15.773 10.457 C 15.809 9.668 15.818 9.414 15.818 7.404 C 15.818 5.396 15.809 5.142 15.773 4.352 C 15.761 3.737 15.645 3.129 15.429 2.553 C 15.243 2.059 14.951 1.611 14.574 1.242 C 14.203 0.865 13.755 0.574 13.261 0.389 C 12.685 0.173 12.077 0.057 11.462 0.045 C 10.671 0.009 10.418 0 8.407 0 Z"
						></path>
						<path
							d="M 8.406 3.602 C 7.654 3.602 6.918 3.825 6.291 4.243 C 5.343 4.871 4.727 5.895 4.615 7.03 C 4.503 8.165 4.907 9.291 5.715 10.093 C 6.804 11.183 8.44 11.508 9.861 10.917 C 10.556 10.631 11.15 10.144 11.569 9.518 C 12.578 8.011 12.38 5.997 11.097 4.717 C 10.382 4.003 9.414 3.602 8.406 3.602 Z"
						></path>
					</svg>
				</a>

				<!-- GitHub -->
				<a
					href="https://github.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="transition-opacity hover:opacity-70"
					aria-label="GitHub"
				>
					<svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor">
						<path
							d="M 8.116 0 C 6.028 -0.011 4.022 0.811 2.541 2.284 C 1.061 3.757 0.228 5.759 0.228 7.847 C 0.228 11.313 2.496 14.256 5.616 15.302 C 6.01 15.367 6.143 15.139 6.143 14.909 L 6.143 13.571 C 3.942 14.06 3.481 12.524 3.481 12.524 C 3.12 11.607 2.593 11.379 2.593 11.379 C 1.872 10.889 2.66 10.889 2.66 10.889 C 3.449 10.954 3.875 11.706 3.875 11.706 C 4.566 12.915 5.715 12.556 6.175 12.361 C 6.241 11.837 6.438 11.51 6.669 11.313 C 4.927 11.117 3.087 10.431 3.087 7.423 C 3.087 6.573 3.383 5.853 3.908 5.329 C 3.843 5.133 3.546 4.349 3.974 3.238 C 3.974 3.238 4.631 3.041 6.141 4.055 C 6.785 3.886 7.448 3.798 8.113 3.793 C 8.771 3.793 9.46 3.891 10.084 4.055 C 11.597 3.041 12.253 3.238 12.253 3.238 C 12.681 4.316 12.417 5.101 12.319 5.329 C 12.812 5.885 13.14 6.573 13.14 7.423 C 13.14 10.431 11.3 11.085 9.526 11.281 C 9.823 11.51 10.052 12 10.052 12.72 L 10.052 14.877 C 10.052 15.073 10.183 15.335 10.611 15.27 C 13.824 14.222 15.999 11.227 16 7.847 C 16 5.76 15.168 3.758 13.689 2.286 C 12.209 0.813 10.204 -0.01 8.116 0 Z"
						></path>
					</svg>
				</a>
			</div>
		</div>

		<!-- Right Column: Navigation Links Groups -->
		<div class="grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-14 lg:gap-20">
			<!-- Group 1: About -->
			<div class="flex flex-col gap-4">
				<h5 class="font-anton text-base text-task-dark">
					{t.footer.aboutTitle}
				</h5>
				<ul class="flex flex-col gap-2.5 font-outfit text-[15px] text-task-dark">
					<li><a href="#home" class="transition-colors hover:underline">{t.footer.links.home}</a></li>
					<li><a href="#services" class="transition-colors hover:underline">{t.footer.links.services}</a></li>
					<li><a href="#features" class="transition-colors hover:underline">{t.footer.links.features}</a></li>
					<li><a href="#community" class="transition-colors hover:underline">{t.footer.links.community}</a></li>
					<li><a href="#faqs" class="transition-colors hover:underline">{t.footer.links.faqs}</a></li>
				</ul>
			</div>

			<!-- Group 2: Support -->
			<div class="flex flex-col gap-4">
				<h5 class="font-anton text-base text-task-dark">
					{t.footer.supportTitle}
				</h5>
				<ul class="flex flex-col gap-2.5 font-outfit text-[15px] text-task-dark">
					<li><a href="mailto:contact@gabrielcampos.dev" class="transition-colors hover:underline">{t.footer.links.contactUs}</a></li>
					<li><a href="https://telegram.org/" target="_blank" rel="noopener noreferrer" class="transition-colors hover:underline">{t.footer.links.telegram}</a></li>
				</ul>
			</div>

			<!-- Group 3: Help -->
			<div class="flex flex-col gap-4">
				<h5 class="font-anton text-base text-task-dark">
					{t.footer.helpTitle}
				</h5>
				<ul class="flex flex-col gap-2.5 font-outfit text-[15px] text-task-dark">
					<li><a href="mailto:support@gabrielcampos.dev" class="transition-colors hover:underline">{t.footer.links.customerSupport}</a></li>
				</ul>
			</div>
		</div>
	</div>

	<!-- Bottom Copyright -->
	<div class="mx-auto mt-14 flex w-full max-w-[1080px] items-center justify-between border-t border-task-border pt-6 font-outfit text-xs text-task-gray">
		<p>© {new Date().getFullYear()} TaskAI Clone. Designed for multilingual portfolios.</p>
		<p class="font-medium text-task-dark">Astro + Tailwind CSS v4</p>
	</div>
</footer>
