---
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import {
	getContactEmail,
	getWhatsAppUrl,
	getTelegramUrl,
	WHATSAPP_PHONE,
	TELEGRAM_PHONE,
} from '../../data/contact';
import SocialLinks from '../ui/SocialLinks.astro';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();
const email = getContactEmail(lang);
const waUrl = getWhatsAppUrl(lang);
const telegramUrl = getTelegramUrl();
---

<footer class="w-full border-t border-task-border px-4 pt-20 pb-16 md:px-8">
	<div class="mx-auto flex w-full max-w-270 flex-col justify-between gap-12 lg:flex-row lg:gap-16">
		<!-- Left Column: Social Icons & Direct Contact -->
		<div class="flex max-w-110 flex-col items-start gap-6">
			<div>
				<h4 class="font-anton text-xl leading-tight text-task-dark sm:text-[22px]">
					Gabriel Campos
				</h4>
				<p class="mt-2 font-outfit text-sm text-task-gray">
					Desenvolvimento web e engenharia de software.
				</p>
			</div>

			<!-- Modern Social & Networks Section -->
			<div class="flex w-full flex-col items-start gap-3.5 pt-1">
				<div class="flex items-center gap-2">
					<span class="size-1.5 rounded-full bg-task-dark"></span>
					<span class="font-anton text-xs tracking-wider uppercase text-task-dark/70">
						{t.footer.socialTitle}
					</span>
				</div>

				<SocialLinks {lang} variant="light" />
			</div>
		</div>

		<!-- Right Column: Navigation Links Groups -->
		<div class="grid grid-cols-1 gap-8 min-[520px]:grid-cols-2 sm:grid-cols-3 sm:gap-12 lg:flex lg:gap-10 xl:gap-16">
			<!-- Group 1: About -->
			<div class="flex flex-col gap-4">
				<h5 class="font-anton text-base text-task-dark">
					{t.footer.aboutTitle}
				</h5>
				<ul class="flex flex-col gap-2.5 font-outfit text-[15px] text-task-dark">
					<li><a href="#home" class="transition-colors hover:underline">{t.footer.links.home}</a></li>
					<li><a href="#services" class="transition-colors hover:underline">{t.footer.links.services}</a></li>
					<li><a href="#features" class="transition-colors hover:underline">{t.footer.links.features}</a></li>
					<li><a href="#community" class="transition-colors hover:underline">{t.footer.links.community}</a></li>
					<li><a href="#faqs" class="transition-colors hover:underline">{t.footer.links.faqs}</a></li>
				</ul>
			</div>

			<!-- Group 2: Support & Direct Channels -->
			<div class="flex flex-col gap-4">
				<h5 class="font-anton text-base text-task-dark">
					{t.footer.supportTitle}
				</h5>
				<ul class="flex flex-col gap-2.5 font-outfit text-[15px] text-task-dark">
					<li>
						<a
							href={waUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1.5 whitespace-nowrap transition-colors hover:underline"
						>
							<span class="font-medium">WhatsApp:</span>
							<span class="font-mono text-xs">{WHATSAPP_PHONE}</span>
						</a>
					</li>
					<li>
						<a
							href={telegramUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1.5 whitespace-nowrap transition-colors hover:underline"
						>
							<span class="font-medium">Telegram:</span>
							<span class="font-mono text-xs">{TELEGRAM_PHONE}</span>
						</a>
					</li>
				</ul>
			</div>

			<!-- Group 3: Help & Professional Email -->
			<div class="flex flex-col gap-4">
				<h5 class="font-anton text-base text-task-dark">
					{t.footer.helpTitle}
				</h5>
				<ul class="flex flex-col gap-2.5 font-outfit text-[15px] text-task-dark">
					<li>
						<a
							href={`mailto:${email}`}
							class="block transition-colors hover:underline font-mono text-xs text-task-dark/90"
							title={email}
						>
							{email}
						</a>
					</li>
					<li>
						<a href={`mailto:${email}`} class="transition-colors hover:underline">
							{t.footer.links.customerSupport}
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<!-- Bottom Copyright -->
	<div class="mx-auto mt-14 flex w-full max-w-270 items-center justify-between border-t border-task-border pt-6 font-outfit text-xs text-task-gray">
		<p>© {new Date().getFullYear()} Gabriel Campos. Designed for multilingual portfolios.</p>
		<p class="font-medium text-task-dark">Astro + Tailwind CSS v4</p>
	</div>
</footer>
