---
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import {
	getContactEmail,
	getWhatsAppUrl,
	getTelegramUrl,
	WHATSAPP_PHONE,
	TELEGRAM_PHONE,
} from '../../data/contact';

export interface Props {
	lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang)();
const email = getContactEmail(lang);
const waUrl = getWhatsAppUrl(lang);
const telegramUrl = getTelegramUrl();
---

<aside
	class="fixed bottom-5 right-5 z-40 flex items-center gap-2 rounded-full border border-task-border/60 bg-task-dark/95 p-1.5 text-white shadow-2xl backdrop-blur-md transition-all hover:bg-task-dark"
	aria-label={t.quickContact.label}
>
	<!-- WhatsApp Button -->
	<a
		href={waUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="group flex items-center gap-2 rounded-full bg-[#25D366]/20 px-3.5 py-2 font-outfit text-xs font-medium text-[#4ade80] transition-all hover:bg-[#25D366] hover:text-task-dark active:scale-95"
		title={`WhatsApp: ${WHATSAPP_PHONE}`}
		aria-label={`WhatsApp: ${WHATSAPP_PHONE}`}
	>
		<svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="currentColor">
			<path
				d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c4.55 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.28-2.42 5.84a8.19 8.19 0 0 1-5.82 2.41h-.01c-1.42 0-2.82-.37-4.05-1.07l-.29-.17-3.12.82.83-3.04-.19-.3a8.194 8.194 0 0 1-1.26-4.48c0-4.55 3.7-8.24 8.25-8.24zm4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.32-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.53.61.2 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.14-1.18-.06-.1-.23-.16-.48-.28z"
			></path>
		</svg>
		<span class="hidden sm:inline">WhatsApp</span>
	</a>

	<!-- Telegram Button -->
	<a
		href={telegramUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="group flex items-center gap-2 rounded-full bg-[#229ED9]/20 px-3.5 py-2 font-outfit text-xs font-medium text-[#38bdf8] transition-all hover:bg-[#229ED9] hover:text-white active:scale-95"
		title={`Telegram: ${TELEGRAM_PHONE}`}
		aria-label={`Telegram: ${TELEGRAM_PHONE}`}
	>
		<svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="currentColor">
			<path
				d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"
			></path>
		</svg>
		<span class="hidden sm:inline">Telegram</span>
	</a>

	<!-- Email Button -->
	<a
		href={`mailto:${email}`}
		class="group flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-2 font-outfit text-xs font-medium text-white/90 transition-all hover:bg-task-yellow hover:text-task-dark active:scale-95"
		title={`Email: ${email}`}
		aria-label={`Email: ${email}`}
	>
		<svg viewBox="0 0 20 20" class="size-4 shrink-0" fill="currentColor">
			<path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
			<path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
		</svg>
		<span class="hidden md:inline font-mono text-[11px]">{email}</span>
	</a>
</aside>
