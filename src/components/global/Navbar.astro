---
import { Icon } from 'astro-icon/components';
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { getWhatsAppUrl } from '../../data/contact';

export interface Props {
	lang?: SupportedLanguage;
	class?: string;
}

const { lang = 'pt-BR', class: className = '' } = Astro.props;
const t = useTranslations(lang)();
const pathname = Astro.url.pathname;
const waUrl = getWhatsAppUrl(lang);

const languages: { code: SupportedLanguage; label: string; fullLabel: string; index: number }[] = [
	{ code: 'pt-BR', label: 'PT', fullLabel: 'Português', index: 0 },
	{ code: 'en', label: 'EN', fullLabel: 'English', index: 1 },
	{ code: 'es', label: 'ES', fullLabel: 'Español', index: 2 },
];
const currentLangIndex = languages.findIndex((l) => l.code === lang);
const activeIndex = currentLangIndex >= 0 ? currentLangIndex : 0;
---

<header class={`sticky top-0 z-50 w-full border-b border-task-border bg-task-bg/90 backdrop-blur-md ${className}`}>
	<div class="mx-auto flex h-21 w-full max-w-300 items-center justify-between px-5 md:px-8">
		<!-- Logo -->
		<a href="#home" class="relative block size-7.5 shrink-0 transition-transform hover:scale-105" aria-label="Gabriel Campos">
			<img
				src="/icons/icon.svg"
				alt="Gabriel Campos"
				class="size-full rounded-inherit object-cover"
				width="30"
				height="30"
				loading="eager"
			/>
		</a>

		<!-- Desktop Navigation Links -->
		<nav class="hidden items-center gap-8 md:flex lg:gap-12" aria-label="Main Navigation">
			<a
				href="#home"
				class="group relative flex items-center font-outfit text-base font-medium text-[#6e6e6e] transition-colors hover:text-task-dark"
			>
				<span class="absolute -left-3 size-1.5 rounded-full bg-task-dark opacity-0 transition-all duration-200 group-hover:opacity-100"></span>
				{t.nav.home}
			</a>
			<a
				href="#services"
				class="group relative flex items-center font-outfit text-base font-medium text-[#6e6e6e] transition-colors hover:text-task-dark"
			>
				<span class="absolute -left-3 size-1.5 rounded-full bg-task-dark opacity-0 transition-all duration-200 group-hover:opacity-100"></span>
				{t.nav.services}
			</a>
			<a
				href="#features"
				class="group relative flex items-center font-outfit text-base font-medium text-[#6e6e6e] transition-colors hover:text-task-dark"
			>
				<span class="absolute -left-3 size-1.5 rounded-full bg-task-dark opacity-0 transition-all duration-200 group-hover:opacity-100"></span>
				{t.nav.features}
			</a>
			<a
				href="#community"
				class="group relative flex items-center font-outfit text-base font-medium text-[#6e6e6e] transition-colors hover:text-task-dark"
			>
				<span class="absolute -left-3 size-1.5 rounded-full bg-task-dark opacity-0 transition-all duration-200 group-hover:opacity-100"></span>
				{t.nav.community}
			</a>
			<a
				href="#faqs"
				class="group relative flex items-center font-outfit text-base font-medium text-[#6e6e6e] transition-colors hover:text-task-dark"
			>
				<span class="absolute -left-3 size-1.5 rounded-full bg-task-dark opacity-0 transition-all duration-200 group-hover:opacity-100"></span>
				{t.nav.faqs}
			</a>
		</nav>

		<!-- Right Side: Language Switcher + CTA -->
		<div class="hidden items-center gap-4 md:flex">
			<!-- Language Switcher Pill -->
			<div
				class="lang-switcher relative flex items-center rounded-full border border-task-border bg-white/70 p-1 text-xs font-semibold text-task-dark backdrop-blur-sm shadow-2xs select-none"
				role="group"
				aria-label="Selecionar idioma"
			>
				<!-- Sliding Pill Indicator -->
				<span
					class="lang-indicator absolute top-1 bottom-1 left-1 h-6 w-8 rounded-full bg-task-dark shadow-xs transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
					style={`transform: translateX(${activeIndex * 100}%);`}
					aria-hidden="true"
				></span>

				{
					languages.map((item) => {
						const isActive = lang === item.code;
						return (
							<a
								href={getLocalizedPath(pathname, item.code)}
								data-index={item.index}
								class={`lang-btn relative z-10 flex h-6 w-8 items-center justify-center rounded-full text-xs font-semibold transition-colors duration-200 ${
									isActive ? 'text-white' : 'text-task-dark/70 hover:text-task-dark'
								}`}
								aria-label={item.fullLabel}
								aria-current={isActive ? 'true' : undefined}
							>
								{item.label}
							</a>
						);
					})
				}
			</div>

			<!-- CTA Button -->
			<a
				href={waUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="group flex h-12 items-center gap-2.5 rounded-full bg-task-yellow px-6 font-anton text-base tracking-wide text-task-dark transition-all duration-200 hover:brightness-105 active:scale-95"
			>
				<span>{t.nav.getInTouch}</span>
				<Icon name="lucide:arrow-right" class="size-4.5 text-task-dark transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
			</a>
		</div>

		<!-- Mobile Hamburger Button -->
		<button
			type="button"
			id="mobile-menu-toggle"
			class="flex size-11 flex-col items-center justify-center gap-1.5 rounded-[10px] bg-task-yellow p-2 transition-transform active:scale-90 md:hidden"
			aria-label="Toggle navigation menu"
			aria-expanded="false"
		>
			<span class="h-0.5 w-5 rounded-full bg-task-dark transition-all duration-300" id="hamburger-bar-1"></span>
			<span class="h-0.5 w-5 rounded-full bg-task-dark transition-all duration-300" id="hamburger-bar-2"></span>
		</button>
	</div>

	<!-- Mobile Drawer -->
	<div
		id="mobile-menu"
		class="hidden flex-col border-b border-task-border bg-task-bg px-6 pt-2 pb-6 md:hidden animate-in fade-in slide-in-from-top-2 duration-200"
	>
		<nav class="flex flex-col gap-4 py-4" aria-label="Mobile Navigation">
			<a href="#home" class="mobile-nav-link font-outfit text-lg font-medium text-task-dark hover:text-black">
				{t.nav.home}
			</a>
			<a href="#services" class="mobile-nav-link font-outfit text-lg font-medium text-task-dark hover:text-black">
				{t.nav.services}
			</a>
			<a href="#features" class="mobile-nav-link font-outfit text-lg font-medium text-task-dark hover:text-black">
				{t.nav.features}
			</a>
			<a href="#community" class="mobile-nav-link font-outfit text-lg font-medium text-task-dark hover:text-black">
				{t.nav.community}
			</a>
			<a href="#faqs" class="mobile-nav-link font-outfit text-lg font-medium text-task-dark hover:text-black">
				{t.nav.faqs}
			</a>
		</nav>

		<!-- Mobile Languages -->
		<div class="flex flex-col gap-2.5 border-t border-task-border py-4">
			<span class="font-outfit text-xs font-semibold text-task-dark/60">Idioma:</span>
			<div
				class="lang-switcher relative flex w-full max-w-xs items-center rounded-full border border-task-border bg-white/70 p-1 text-xs font-semibold text-task-dark backdrop-blur-sm shadow-2xs select-none"
				role="group"
				aria-label="Selecionar idioma"
			>
				<!-- Sliding Pill Indicator -->
				<span
					class="lang-indicator absolute top-1 bottom-1 left-1 h-7 w-[calc((100%-8px)/3)] rounded-full bg-task-dark shadow-xs transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
					style={`transform: translateX(${activeIndex * 100}%);`}
					aria-hidden="true"
				></span>

				{
					languages.map((item) => {
						const isActive = lang === item.code;
						return (
							<a
								href={getLocalizedPath(pathname, item.code)}
								data-index={item.index}
								class={`lang-btn relative z-10 flex h-7 flex-1 items-center justify-center rounded-full text-xs font-semibold transition-colors duration-200 ${
									isActive ? 'text-white' : 'text-task-dark/70 hover:text-task-dark'
								}`}
								aria-label={item.fullLabel}
								aria-current={isActive ? 'true' : undefined}
							>
								{item.fullLabel}
							</a>
						);
					})
				}
			</div>
		</div>

		<!-- Mobile CTA -->
		<a
			href={waUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="mobile-nav-link mt-2 flex h-12 w-full items-center justify-center gap-2 rounded-full bg-task-yellow font-anton text-base tracking-wide text-task-dark"
		>
			<span>{t.nav.getInTouch}</span>
			<Icon name="lucide:arrow-right" class="size-4.5 text-task-dark" />
		</a>
	</div>
</header>

<script>
	function setupNavbar() {
		// Mobile Menu
		const toggle = document.getElementById('mobile-menu-toggle');
		const menu = document.getElementById('mobile-menu');
		const bar1 = document.getElementById('hamburger-bar-1');
		const bar2 = document.getElementById('hamburger-bar-2');

		if (toggle && menu) {
			const handleToggle = () => {
				const isOpen = !menu.classList.contains('hidden');
				if (isOpen) {
					menu.classList.add('hidden');
					toggle.setAttribute('aria-expanded', 'false');
					if (bar1 && bar2) {
						bar1.style.transform = 'none';
						bar2.style.transform = 'none';
					}
				} else {
					menu.classList.remove('hidden');
					toggle.setAttribute('aria-expanded', 'true');
					if (bar1 && bar2) {
						bar1.style.transform = 'translateY(3px) rotate(45deg)';
						bar2.style.transform = 'translateY(-3px) rotate(-45deg)';
					}
				}
			};

			toggle.onclick = handleToggle;

			const links = menu.querySelectorAll('.mobile-nav-link');
			links.forEach((link) => {
				link.addEventListener('click', () => {
					menu.classList.add('hidden');
					toggle.setAttribute('aria-expanded', 'false');
					if (bar1 && bar2) {
						bar1.style.transform = 'none';
						bar2.style.transform = 'none';
					}
				});
			});
		}

		// Sliding Language Switchers
		document.querySelectorAll<HTMLElement>('.lang-switcher').forEach((switcher) => {
			const indicator = switcher.querySelector<HTMLElement>('.lang-indicator');
			const buttons = switcher.querySelectorAll<HTMLAnchorElement>('.lang-btn');
			if (!indicator) return;

			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const index = Number(btn.dataset.index);
					if (isNaN(index)) return;

					// Smoothly slide the indicator to the clicked tab
					indicator.style.transform = `translateX(${index * 100}%)`;

					// Update active styles immediately
					buttons.forEach((b) => {
						b.classList.remove('text-white');
						b.classList.add('text-task-dark/70');
						b.removeAttribute('aria-current');
					});
					btn.classList.remove('text-task-dark/70');
					btn.classList.add('text-white');
					btn.setAttribute('aria-current', 'true');
				});
			});
		});
	}

	setupNavbar();
	document.addEventListener('astro:page-load', setupNavbar);
</script>
