---
import { Icon } from 'astro-icon/components';
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { getWhatsAppUrl } from '../../data/contact';

export interface Props {
	lang?: SupportedLanguage;
	class?: string;
}

const { lang = 'pt-BR', class: className = '' } = Astro.props;
const t = useTranslations(lang)();
const pathname = Astro.url.pathname;
const waUrl = getWhatsAppUrl(lang);

const languages: { code: SupportedLanguage; label: string; fullLabel: string; index: number }[] = [
	{ code: 'pt-BR', label: 'PT', fullLabel: 'Português', index: 0 },
	{ code: 'en', label: 'EN', fullLabel: 'English', index: 1 },
	{ code: 'es', label: 'ES', fullLabel: 'Español', index: 2 },
];
const currentLangIndex = languages.findIndex((l) => l.code === lang);
const activeIndex = currentLangIndex >= 0 ? currentLangIndex : 0;
const currentLang = languages[activeIndex] ?? languages[0];

const langLabels: Record<SupportedLanguage, { select: string; language: string }> = {
	'pt-BR': { select: 'Selecionar idioma', language: 'Idioma' },
	en: { select: 'Select language', language: 'Language' },
	es: { select: 'Seleccionar idioma', language: 'Idioma' },
};
const i18nLabel = langLabels[lang] || langLabels['pt-BR'];
---

<header class={`sticky top-0 z-50 w-full border-b border-task-border bg-task-bg/90 backdrop-blur-md ${className}`}>
	<div class="mx-auto flex h-21 w-full max-w-300 items-center justify-between px-5 md:px-8">
		<!-- Logo -->
		<a href="#home" class="group flex items-center gap-2.5 transition-transform active:scale-95" aria-label="Gabriel Campos - Início">
			<span class="flex size-11 items-center justify-center rounded-lg bg-task-dark font-anton text-2xl leading-none shadow-xs transition-transform group-hover:scale-105">
				<span class="text-white">G</span>
				<span class="text-task-yellow">C</span>
			</span>
		</a>

		<!-- Desktop Navigation Links -->
		<nav class="hidden items-center gap-6 lg:gap-8 md:flex" aria-label="Main Navigation">
			<a
				href="#home"
				class="group relative flex items-center font-outfit text-sm lg:text-base font-medium text-[#6e6e6e] transition-colors hover:text-task-dark"
			>
				<span class="absolute -left-3 size-1.5 rounded-full bg-task-dark opacity-0 transition-all duration-200 group-hover:opacity-100"></span>
				{t.nav.home}
			</a>
			<a
				href="#problemas"
				class="group relative flex items-center font-outfit text-sm lg:text-base font-medium text-[#6e6e6e] transition-colors hover:text-task-dark"
			>
				<span class="absolute -left-3 size-1.5 rounded-full bg-task-dark opacity-0 transition-all duration-200 group-hover:opacity-100"></span>
				{t.nav.problems}
			</a>
			<a
				href="#servicos"
				class="group relative flex items-center font-outfit text-sm lg:text-base font-medium text-[#6e6e6e] transition-colors hover:text-task-dark"
			>
				<span class="absolute -left-3 size-1.5 rounded-full bg-task-dark opacity-0 transition-all duration-200 group-hover:opacity-100"></span>
				{t.nav.services}
			</a>
			<a
				href="#como-trabalho"
				class="group relative flex items-center font-outfit text-sm lg:text-base font-medium text-[#6e6e6e] transition-colors hover:text-task-dark"
			>
				<span class="absolute -left-3 size-1.5 rounded-full bg-task-dark opacity-0 transition-all duration-200 group-hover:opacity-100"></span>
				{t.nav.principles}
			</a>
			<a
				href="#sobre"
				class="group relative flex items-center font-outfit text-sm lg:text-base font-medium text-[#6e6e6e] transition-colors hover:text-task-dark"
			>
				<span class="absolute -left-3 size-1.5 rounded-full bg-task-dark opacity-0 transition-all duration-200 group-hover:opacity-100"></span>
				{t.nav.about}
			</a>
			<a
				href="#faqs"
				class="group relative flex items-center font-outfit text-sm lg:text-base font-medium text-[#6e6e6e] transition-colors hover:text-task-dark"
			>
				<span class="absolute -left-3 size-1.5 rounded-full bg-task-dark opacity-0 transition-all duration-200 group-hover:opacity-100"></span>
				{t.nav.faqs}
			</a>
		</nav>

		<!-- Right Side: Language Switcher + CTA -->
		<div class="hidden items-center gap-4 md:flex">
			<!-- Language Switcher Pill (Apenas em telas >= 1025px) -->
			<div
				class="lang-switcher relative hidden items-center rounded-full border border-task-border bg-white/70 p-1 text-xs font-semibold text-task-dark backdrop-blur-sm shadow-2xs select-none min-[1025px]:flex"
				role="group"
				aria-label={i18nLabel.select}
			>
				<!-- Sliding Pill Indicator -->
				<span
					class="lang-indicator absolute top-1 bottom-1 left-1 h-6 w-8 rounded-full bg-task-dark shadow-xs transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
					style={`transform: translateX(${activeIndex * 100}%);`}
					aria-hidden="true"
				></span>

				{
					languages.map((item) => {
						const isActive = lang === item.code;
						return (
							<a
								href={getLocalizedPath(pathname, item.code)}
								data-index={item.index}
								class={`lang-btn relative z-10 flex h-6 w-8 items-center justify-center rounded-full text-xs font-semibold transition-colors duration-200 ${
									isActive ? 'text-white' : 'text-task-dark/70 hover:text-task-dark'
								}`}
								aria-label={item.fullLabel}
								aria-current={isActive ? 'true' : undefined}
							>
								{item.label}
							</a>
						);
					})
				}
			</div>

			<!-- Language Dropdown (Resoluções menores de 1025px: 768px a 1024px) -->
			<div class="lang-dropdown relative flex min-[1025px]:hidden" data-dropdown-id="tablet-header">
				<button
					type="button"
					class="lang-dropdown-btn flex h-11 items-center gap-1.5 rounded-full border border-task-border bg-white/80 px-3.5 text-xs font-semibold text-task-dark shadow-2xs backdrop-blur-sm transition-all hover:bg-white active:scale-95"
					aria-haspopup="listbox"
					aria-expanded="false"
					aria-label={i18nLabel.select}
				>
					<Icon name="lucide:globe" class="size-3.5 text-task-dark/70" />
					<span class="tracking-wide">{currentLang.label}</span>
					<Icon name="lucide:chevron-down" class="lang-dropdown-chevron size-3 text-task-dark/60 transition-transform duration-200" />
				</button>

				<!-- Dropdown Panel -->
				<div
					class="lang-dropdown-menu absolute right-0 top-full mt-2 hidden min-w-36.25 flex-col overflow-hidden rounded-2xl border border-task-border bg-white/95 p-1.5 shadow-xl backdrop-blur-md z-50"
					role="listbox"
					aria-label={i18nLabel.select}
				>
					{
						languages.map((item) => {
							const isActive = lang === item.code;
							return (
								<a
									href={getLocalizedPath(pathname, item.code)}
									class={`flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold transition-colors ${
										isActive
											? 'bg-task-dark text-white'
											: 'text-task-dark/80 hover:bg-task-border/40 hover:text-task-dark'
									}`}
									role="option"
									aria-selected={isActive ? 'true' : 'false'}
								>
									<span>{item.fullLabel}</span>
									<span class={isActive ? 'text-white/70 text-[10px]' : 'text-task-dark/40 text-[10px]'}>{item.label}</span>
								</a>
							);
						})
					}
				</div>
			</div>

			<!-- CTA Button (Framer style: text pill + animated arrow circle) -->
			<a
				href={waUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="group inline-flex items-center gap-1.5 transition-transform duration-200 active:scale-95"
				aria-label={t.nav.getInTouch}
			>
				<!-- Wrapper (Text Pill) -->
				<div
					class="flex h-11 items-center justify-center gap-2 rounded-full bg-task-yellow px-5 transition-all duration-200 group-hover:brightness-105"
				>
					<Icon name="simple-icons:whatsapp" class="size-4 shrink-0 text-task-dark" />
					<span class="font-jakarta text-sm sm:text-[15px] font-semibold tracking-tight text-task-dark min-[768px]:hidden min-[1119px]:inline">
						{t.nav.getInTouch}
					</span>
					<span class="hidden font-jakarta text-sm sm:text-[15px] font-semibold tracking-tight text-task-dark min-[768px]:inline min-[1119px]:hidden">
						{t.nav.getInTouchShort}
					</span>
				</div>

				<!-- Arrow Circle -->
				<div
					class="relative flex size-11 items-center justify-center overflow-hidden rounded-full bg-task-yellow transition-all duration-200 group-hover:brightness-105"
				>
					<!-- Icon 1 (slides out top-right on hover) -->
					<svg
						class="size-4 text-task-dark transition-transform duration-300 ease-out group-hover:translate-x-6 group-hover:-translate-y-6"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M 16.167 19.217 L 19.217 7.833 L 7.833 4.783 M 4.783 16.166 L 19.217 7.833" />
					</svg>

					<!-- Icon 2 (slides in from bottom-left on hover) -->
					<svg
						class="absolute size-4 -translate-x-6 translate-y-6 text-task-dark transition-transform duration-300 ease-out group-hover:translate-x-0 group-hover:translate-y-0"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M 16.167 19.217 L 19.217 7.833 L 7.833 4.783 M 4.783 16.166 L 19.217 7.833" />
					</svg>
				</div>
			</a>
		</div>

		<!-- Mobile Controls: Language Dropdown + Hamburger (Mobile / other resolutions) -->
		<div class="flex items-center gap-2.5 md:hidden">
			<!-- Mobile Language Dropdown -->
			<div class="lang-dropdown relative" data-dropdown-id="header">
				<button
					type="button"
					class="lang-dropdown-btn flex h-11 items-center gap-1.5 rounded-full border border-task-border bg-white/80 px-3 text-xs font-semibold text-task-dark shadow-2xs backdrop-blur-sm transition-all hover:bg-white active:scale-95"
					aria-haspopup="listbox"
					aria-expanded="false"
					aria-label={i18nLabel.select}
				>
					<Icon name="lucide:globe" class="size-3.5 text-task-dark/70" />
					<span class="tracking-wide">{currentLang.label}</span>
					<Icon name="lucide:chevron-down" class="lang-dropdown-chevron size-3 text-task-dark/60 transition-transform duration-200" />
				</button>

				<!-- Dropdown Panel -->
				<div
					class="lang-dropdown-menu absolute right-0 top-full mt-2 hidden min-w-36.25 flex-col overflow-hidden rounded-2xl border border-task-border bg-white/95 p-1.5 shadow-xl backdrop-blur-md z-50"
					role="listbox"
					aria-label={i18nLabel.select}
				>
					{
						languages.map((item) => {
							const isActive = lang === item.code;
							return (
								<a
									href={getLocalizedPath(pathname, item.code)}
									class={`flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold transition-colors ${
										isActive
											? 'bg-task-dark text-white'
											: 'text-task-dark/80 hover:bg-task-border/40 hover:text-task-dark'
									}`}
									role="option"
									aria-selected={isActive ? 'true' : 'false'}
								>
									<span>{item.fullLabel}</span>
									<span class={isActive ? 'text-white/70 text-[10px]' : 'text-task-dark/40 text-[10px]'}>{item.label}</span>
								</a>
							);
						})
					}
				</div>
			</div>

			<!-- Mobile Hamburger Button -->
			<button
				type="button"
				id="mobile-menu-toggle"
				class="relative flex size-11 items-center justify-center rounded-[10px] bg-task-yellow transition-transform active:scale-90"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
			>
				<span class="absolute top-1/2 left-1/2 h-0.5 w-5 -translate-x-1/2 -translate-y-1/2 -mt-1.5">
					<span class="block h-full w-full rounded-full bg-task-dark transition-transform duration-300 ease-out" id="hamburger-bar-1"></span>
				</span>
				<span class="absolute top-1/2 left-1/2 h-0.5 w-5 -translate-x-1/2 -translate-y-1/2">
					<span class="block h-full w-full rounded-full bg-task-dark transition-all duration-300 ease-out" id="hamburger-bar-2"></span>
				</span>
				<span class="absolute top-1/2 left-1/2 h-0.5 w-5 -translate-x-1/2 -translate-y-1/2 mt-1.5">
					<span class="block h-full w-full rounded-full bg-task-dark transition-transform duration-300 ease-out" id="hamburger-bar-3"></span>
				</span>
			</button>
		</div>
	</div>

	<!-- Mobile Drawer -->
	<div
		id="mobile-menu"
		class="hidden flex-col border-b border-task-border bg-task-bg px-6 pt-2 pb-6 md:hidden animate-in fade-in slide-in-from-top-2 duration-200"
	>
		<nav class="flex flex-col gap-4 py-4" aria-label="Mobile Navigation">
			<a href="#home" class="mobile-nav-link font-outfit text-lg font-medium text-task-dark hover:text-black">
				{t.nav.home}
			</a>
			<a href="#problemas" class="mobile-nav-link font-outfit text-lg font-medium text-task-dark hover:text-black">
				{t.nav.problems}
			</a>
			<a href="#servicos" class="mobile-nav-link font-outfit text-lg font-medium text-task-dark hover:text-black">
				{t.nav.services}
			</a>
			<a href="#como-trabalho" class="mobile-nav-link font-outfit text-lg font-medium text-task-dark hover:text-black">
				{t.nav.principles}
			</a>
			<a href="#sobre" class="mobile-nav-link font-outfit text-lg font-medium text-task-dark hover:text-black">
				{t.nav.about}
			</a>
			<a href="#faqs" class="mobile-nav-link font-outfit text-lg font-medium text-task-dark hover:text-black">
				{t.nav.faqs}
			</a>
		</nav>

		<!-- Mobile Languages (Dropdown in Drawer) -->
		<div class="flex flex-col gap-2.5 border-t border-task-border py-4">
			<span class="font-outfit text-xs font-semibold text-task-dark/60">{i18nLabel.language}:</span>
			<div class="lang-dropdown relative w-full max-w-xs" data-dropdown-id="drawer">
				<button
					type="button"
					class="lang-dropdown-btn flex h-11 w-full items-center justify-between rounded-xl border border-task-border bg-white/80 px-4 text-xs font-semibold text-task-dark shadow-2xs backdrop-blur-sm transition-all hover:bg-white"
					aria-haspopup="listbox"
					aria-expanded="false"
					aria-label={i18nLabel.select}
				>
					<span class="flex items-center gap-2">
						<Icon name="lucide:globe" class="size-4 text-task-dark/70" />
						<span>{currentLang.fullLabel} ({currentLang.label})</span>
					</span>
					<Icon name="lucide:chevron-down" class="lang-dropdown-chevron size-3.5 text-task-dark/60 transition-transform duration-200" />
				</button>

				<div
					class="lang-dropdown-menu absolute left-0 right-0 top-full mt-2 hidden flex-col overflow-hidden rounded-2xl border border-task-border bg-white/95 p-1.5 shadow-xl backdrop-blur-md z-50"
					role="listbox"
					aria-label={i18nLabel.select}
				>
					{
						languages.map((item) => {
							const isActive = lang === item.code;
							return (
								<a
									href={getLocalizedPath(pathname, item.code)}
									class={`flex items-center justify-between rounded-xl px-3.5 py-2.5 text-xs font-semibold transition-colors ${
										isActive
											? 'bg-task-dark text-white'
											: 'text-task-dark/80 hover:bg-task-border/40 hover:text-task-dark'
									}`}
									role="option"
									aria-selected={isActive ? 'true' : 'false'}
								>
									<span>{item.fullLabel}</span>
									<span class={isActive ? 'text-white/70 text-[11px]' : 'text-task-dark/40 text-[11px]'}>{item.label}</span>
								</a>
							);
						})
					}
				</div>
			</div>
		</div>

		<!-- Mobile CTA (Framer style) -->
		<a
			href={waUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="mobile-nav-link mt-2 group flex items-center justify-between gap-2 transition-transform duration-200 active:scale-95"
			aria-label={t.nav.getInTouch}
		>
			<div
				class="flex h-12 flex-1 items-center justify-center rounded-full bg-task-yellow px-5 transition-all duration-200 active:brightness-105"
			>
				<span class="font-jakarta text-base font-semibold text-task-dark">
					{t.nav.getInTouch}
				</span>
			</div>
			<div
				class="relative flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-task-yellow"
			>
				<svg
					class="size-5 text-task-dark"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M 16.167 19.217 L 19.217 7.833 L 7.833 4.783 M 4.783 16.166 L 19.217 7.833" />
				</svg>
			</div>
		</a>
	</div>
</header>

<script>
	let docListenersAttached = false;

	function attachGlobalListeners() {
		if (docListenersAttached) return;
		docListenersAttached = true;

		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement | null;
			if (!target?.closest('.lang-dropdown')) {
				document.querySelectorAll<HTMLElement>('.lang-dropdown').forEach((container) => {
					container.querySelector<HTMLElement>('.lang-dropdown-menu')?.classList.add('hidden');
					container.querySelector<HTMLButtonElement>('.lang-dropdown-btn')?.setAttribute('aria-expanded', 'false');
					container.querySelector<HTMLElement>('.lang-dropdown-chevron')?.classList.remove('rotate-180');
				});
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				document.querySelectorAll<HTMLElement>('.lang-dropdown').forEach((container) => {
					container.querySelector<HTMLElement>('.lang-dropdown-menu')?.classList.add('hidden');
					container.querySelector<HTMLButtonElement>('.lang-dropdown-btn')?.setAttribute('aria-expanded', 'false');
					container.querySelector<HTMLElement>('.lang-dropdown-chevron')?.classList.remove('rotate-180');
				});
			}
		});
	}

	function setupNavbar() {
		attachGlobalListeners();

		// Mobile Menu
		const toggle = document.getElementById('mobile-menu-toggle');
		const menu = document.getElementById('mobile-menu');
		const bar1 = document.getElementById('hamburger-bar-1');
		const bar2 = document.getElementById('hamburger-bar-2');
		const bar3 = document.getElementById('hamburger-bar-3');

		const setBars = (open: boolean) => {
			if (!bar1 || !bar2 || !bar3) return;
			if (open) {
				bar1.style.transform = 'translateY(0.375rem) rotate(45deg)';
				bar2.style.transform = 'scaleX(0)';
				bar3.style.transform = 'translateY(-0.375rem) rotate(-45deg)';
			} else {
				bar1.style.transform = 'none';
				bar2.style.transform = 'none';
				bar3.style.transform = 'none';
			}
		};

		if (toggle && menu) {
			const handleToggle = () => {
				const isOpen = !menu.classList.contains('hidden');
				if (isOpen) {
					menu.classList.add('hidden');
					toggle.setAttribute('aria-expanded', 'false');
					setBars(false);
				} else {
					menu.classList.remove('hidden');
					toggle.setAttribute('aria-expanded', 'true');
					setBars(true);
				}
			};

			toggle.onclick = handleToggle;

			const links = menu.querySelectorAll('.mobile-nav-link');
			links.forEach((link) => {
				link.addEventListener('click', () => {
					menu.classList.add('hidden');
					toggle.setAttribute('aria-expanded', 'false');
					setBars(false);
				});
			});
		}

		// Sliding Language Switcher (Desktop only)
		document.querySelectorAll<HTMLElement>('.lang-switcher').forEach((switcher) => {
			const indicator = switcher.querySelector<HTMLElement>('.lang-indicator');
			const buttons = switcher.querySelectorAll<HTMLAnchorElement>('.lang-btn');
			if (!indicator) return;

			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const index = Number(btn.dataset.index);
					if (isNaN(index)) return;

					// Smoothly slide the indicator to the clicked tab
					indicator.style.transform = `translateX(${index * 100}%)`;

					// Update active styles immediately
					buttons.forEach((b) => {
						b.classList.remove('text-white');
						b.classList.add('text-task-dark/70');
						b.removeAttribute('aria-current');
					});
					btn.classList.remove('text-task-dark/70');
					btn.classList.add('text-white');
					btn.setAttribute('aria-current', 'true');
				});
			});
		});

		// Language Dropdowns (Mobile / other resolutions)
		const dropdowns: NodeListOf<HTMLElement> = document.querySelectorAll<HTMLElement>('.lang-dropdown');
		
		dropdowns.forEach((container: HTMLElement) => {
			const btn: HTMLButtonElement | null = container.querySelector<HTMLButtonElement>('.lang-dropdown-btn');
			const menuPanel: HTMLElement | null = container.querySelector<HTMLElement>('.lang-dropdown-menu');
			const chevron: HTMLElement | null = container.querySelector<HTMLElement>('.lang-dropdown-chevron');

			if (!btn || !menuPanel) return;

			const close: VoidFunction = () => {
				menuPanel.classList.add('hidden');
				btn.setAttribute('aria-expanded', 'false');
				chevron?.classList.remove('rotate-180');
			};

			const open: VoidFunction = () => {
				dropdowns.forEach((other: HTMLElement) => {
					if (other !== container) {
						other.querySelector<HTMLElement>('.lang-dropdown-menu')?.classList.add('hidden');
						other.querySelector<HTMLButtonElement>('.lang-dropdown-btn')?.setAttribute('aria-expanded', 'false');
						other.querySelector<HTMLElement>('.lang-dropdown-chevron')?.classList.remove('rotate-180');
					}
				});
				menuPanel.classList.remove('hidden');
				btn.setAttribute('aria-expanded', 'true');
				chevron?.classList.add('rotate-180');
			};

			btn.onclick = (e: PointerEvent) => {
				e.stopPropagation();
				const isExpanded: boolean = btn.getAttribute('aria-expanded') === 'true';
				if (isExpanded) {
					close();
				} else {
					open();
				}
			};
		});
	}

	setupNavbar();
	document.addEventListener('astro:page-load', setupNavbar);
</script>
