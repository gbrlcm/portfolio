---
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import Breadcrumbs from '../../../components/blog/Breadcrumbs.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	const sorted = posts.sort(
		(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
	);

	const POSTS_PER_PAGE = 6;
	const totalPages = Math.ceil(sorted.length / POSTS_PER_PAGE);

	const paths = [];
	for (let p = 2; p <= totalPages; p++) {
		const start = (p - 1) * POSTS_PER_PAGE;
		const end = start + POSTS_PER_PAGE;
		paths.push({
			params: { page: String(p) },
			props: {
				currentPage: p,
				totalPages,
				posts: sorted.slice(start, end),
			},
		});
	}
	return paths;
}

export interface Props {
	currentPage: number;
	totalPages: number;
	posts: CollectionEntry<'blog'>[];
}

const { currentPage, totalPages, posts } = Astro.props;

const title = `Blog — Página ${currentPage} — Gabriel Campos`;
const description = `Página ${currentPage} com artigos de engenharia de software e sistemas web por Gabriel Campos.`;
---

<PageLayout
	lang="pt-BR"
	title={title}
	description={description}
	ogType="website"
>
	<div class="mx-auto w-full max-w-6xl px-5 pt-10 pb-20 sm:pt-14 sm:pb-28 md:px-8">
		<Breadcrumbs
			items={[
				{ label: 'Início', href: '/' },
				{ label: 'Blog', href: '/blog' },
				{ label: `Página ${currentPage}` },
			]}
			class="mb-8"
		/>

		<header class="max-w-3xl">
			<h1 class="font-anton text-4xl uppercase tracking-tight text-task-dark sm:text-5xl">
				Blog — Página {currentPage}
			</h1>
			<p class="mt-3 font-outfit text-base text-task-gray sm:text-lg">
				Artigos técnicos anteriores sobre engenharia, arquitetura e performance.
			</p>
		</header>

		<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-2">
			{posts.map((post) => (
				<BlogCard post={post} />
			))}
		</div>

		<!-- Pagination Navigation -->
		<nav aria-label="Paginação do blog" class="mt-12 flex items-center justify-center gap-2">
			<a
				href={currentPage === 2 ? '/blog' : `/blog/page/${currentPage - 1}`}
				class="rounded-xl border border-task-border bg-white px-4 py-2 font-outfit text-sm font-semibold text-task-dark transition-colors hover:bg-task-border/40"
			>
				← Anterior
			</a>

			<span class="rounded-xl border border-task-border bg-task-dark px-4 py-2 font-outfit text-sm font-semibold text-white shadow-xs">
				{currentPage}
			</span>

			{
				currentPage < totalPages && (
					<a
						href={`/blog/page/${currentPage + 1}`}
						class="rounded-xl border border-task-border bg-white px-4 py-2 font-outfit text-sm font-semibold text-task-dark transition-colors hover:bg-task-border/40"
					>
						Próxima →
					</a>
				)
			}
		</nav>
	</div>
</PageLayout>
