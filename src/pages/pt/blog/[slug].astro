---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import PageLayout from '../../../layouts/PageLayout.astro';
import Breadcrumbs from '../../../components/blog/Breadcrumbs.astro';
import TableOfContents from '../../../components/blog/TableOfContents.astro';
import ArticleCTA from '../../../components/blog/ArticleCTA.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import authorAvatar from '../../../assets/images/avatar.webp';
import {
	getPostSlug,
	getPostUrl,
	getPostAbsoluteUrl,
	getBlogPostsByLang,
	getPostTranslations,
	getPostHreflangs,
	validateBlogCollection,
} from '../../../lib/blog';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog', ({ data }) => !data.draft);
	validateBlogCollection(allPosts);
	const ptPosts = getBlogPostsByLang(allPosts, 'pt-BR');

	return ptPosts.map((post) => ({
		params: { slug: getPostSlug(post) },
		props: { post, allPosts },
	}));
}

export interface Props {
	post: CollectionEntry<'blog'>;
	allPosts: CollectionEntry<'blog'>[];
}

const { post, allPosts } = Astro.props;
const {
	title,
	description,
	pubDate,
	updatedDate,
	author,
	cover,
	coverAlt,
	category,
	tags,
} = post.data;

const { Content, headings } = await render(post);

// Find related articles within pt-BR
const ptPosts = getBlogPostsByLang(allPosts, 'pt-BR');
const relatedPosts = ptPosts
	.filter((p) => p.id !== post.id)
	.sort((a, b) => {
		const aScore =
			(a.data.category === category ? 2 : 0) +
			a.data.tags.filter((t) => tags.includes(t)).length;
		const bScore =
			(b.data.category === category ? 2 : 0) +
			b.data.tags.filter((t) => tags.includes(t)).length;
		return bScore - aScore;
	})
	.slice(0, 2);

// Date formatting
const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('pt-BR', {
		day: '2-digit',
		month: 'long',
		year: 'numeric',
	}).format(date);

const publishedDateFormatted = formatDate(pubDate);
const updatedDateFormatted = updatedDate ? formatDate(updatedDate) : null;

const words: number = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readTimeMinutes: number = Math.max(1, Math.ceil(words / 200));

const siteUrl = 'https://gabrielcampos.dev';
const canonicalUrl: string = getPostAbsoluteUrl(post, siteUrl);
const ogImage: string = cover
	? cover.startsWith('http')
		? cover
		: `${siteUrl}${cover}`
	: `${siteUrl}/images/og-image.jpg`;

const translations = getPostTranslations(post, allPosts);
const hreflangs = getPostHreflangs(post, allPosts, siteUrl);

const customLanguageUrls = {
	'pt-BR': getPostUrl(post),
	en: translations.find((t) => t.lang === 'en')?.url ?? '/en/blog',
	es: translations.find((t) => t.lang === 'es')?.url ?? '/es/blog',
};

const schemaGraph = [
	{
		'@type': 'BlogPosting',
		'@id': `${canonicalUrl}#article`,
		isPartOf: {
			'@id': `${siteUrl}/#website`,
		},
		headline: title,
		description: description,
		inLanguage: 'pt-BR',
		mainEntityOfPage: canonicalUrl,
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate || pubDate).toISOString(),
		author: {
			'@type': 'Person',
			'@id': `${siteUrl}/#person`,
			name: author,
			url: `${siteUrl}/pt/`,
		},
		publisher: {
			'@type': 'Person',
			'@id': `${siteUrl}/#person`,
			name: 'Gabriel Campos',
		},
		image: ogImage,
		keywords: tags.join(', '),
		articleSection: category,
	},
	{
		'@type': 'BreadcrumbList',
		'@id': `${canonicalUrl}#breadcrumb`,
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Início',
				item: `${siteUrl}/pt/`,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Blog',
				item: `${siteUrl}/pt/blog`,
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: title,
				item: canonicalUrl,
			},
		],
	},
];
---

<PageLayout
	lang="pt-BR"
	title={`${title} — Gabriel Campos`}
	description={description}
	image={cover ?? '/images/og-image.jpg'}
	ogType="article"
	articleMeta={{
		publishedTime: pubDate.toISOString(),
		modifiedTime: (updatedDate || pubDate).toISOString(),
		author,
		section: category,
		tags,
	}}
	schemaGraph={schemaGraph}
	customHreflangs={hreflangs}
	customLanguageUrls={customLanguageUrls}
>
	<article class="mx-auto w-full max-w-5xl pt-10 pb-20 sm:pt-14 sm:pb-28 px-5 md:px-8">
		<!-- Breadcrumbs & Back link -->
		<div class="mb-8 flex flex-wrap items-center justify-between gap-4">
			<Breadcrumbs
				items={[
					{ label: 'Início', href: '/pt' },
					{ label: 'Blog', href: '/pt/blog' },
					{ label: title },
				]}
			/>

			<a
				href="/pt/blog"
				class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-outfit font-medium text-task-gray transition-colors hover:text-task-dark"
			>
				<Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
				<span>Voltar para o blog</span>
			</a>
		</div>

		<!-- Article Header -->
		<header>
			<!-- Meta badge, reading time & optional translations -->
			<div class="flex flex-wrap items-center gap-2.5 text-xs sm:text-sm">
				<span class="relative inline-flex items-center pl-2.5 py-1 uppercase tracking-wider font-bold">
					<span
						class="absolute left-0 bottom-1 h-3 w-1 rounded-full bg-task-yellow"
						aria-hidden="true"
					></span>
					{category}
				</span>
				<span class="text-task-gray/60">·</span>
				<span class="font-outfit text-task-gray font-medium">
					{readTimeMinutes} min de leitura
				</span>
			</div>

			{
				translations.length > 0 && (
					<div class="mt-3 inline-flex flex-wrap items-center gap-2 rounded-xl border border-task-border/80 bg-white/70 px-3.5 py-1.5 text-xs font-outfit text-task-gray">
						<Icon name="lucide:languages" class="size-3.5 text-task-dark" aria-hidden="true" />
						<span>Disponível também em:</span>
						<div class="flex items-center gap-1.5 font-medium">
							{translations.map((tr) => (
								<a
									href={tr.url}
									class="inline-flex items-center gap-1 rounded-md border border-task-border bg-task-bg px-2 py-0.5 text-task-dark transition-colors hover:bg-task-yellow hover:text-black"
								>
									<span>{tr.label}</span>
									<span class="text-[10px] text-task-gray/80">({tr.lang.toUpperCase()})</span>
								</a>
							))}
						</div>
					</div>
				)
			}

			<!-- Title -->
			<h1 class="mt-4 font-anton text-3xl sm:text-4xl lg:text-5xl uppercase tracking-tight text-task-dark leading-tight">
				{title}
			</h1>

			<!-- Description / Subtitle -->
			{
				description && (
					<p class="mt-4 font-outfit text-base sm:text-lg text-task-gray leading-relaxed">
						{description}
					</p>
				)
			}

			<!-- Author + Date bar -->
			<div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-y border-task-border py-4">
				<div class="flex items-center gap-3">
					<Image
						src={authorAvatar}
						alt={author}
						width={44}
						height={44}
						class="size-11 rounded-full object-cover border border-task-border shadow-2xs"
					/>
					<div>
						<div class="font-outfit text-sm font-semibold text-task-dark">
							{author}
						</div>
						<div class="font-outfit text-xs text-task-gray">
							Engenheiro de Software
						</div>
					</div>
				</div>

				<div class="flex flex-col text-right font-outfit text-xs text-task-gray">
					<time datetime={pubDate.toISOString()}>
						Publicado em {publishedDateFormatted}
					</time>
					{
						updatedDate && updatedDateFormatted && (
							<time datetime={updatedDate.toISOString()} class="text-task-gray/70">
								Atualizado em {updatedDateFormatted}
							</time>
						)
					}
				</div>
			</div>
		</header>

		<!-- Cover Image -->
		{
			cover && (
				<div class="mt-8 overflow-hidden rounded-2xl border border-task-border shadow-sm">
					<img
						src={cover}
						alt={coverAlt || title}
						class="w-full max-h-120 object-cover"
						loading="eager"
					/>
				</div>
			)
		}

		<!-- Article Layout with Sidebar TOC -->
		<div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-[1fr_260px]">
			<!-- Main Content -->
			<div class="min-w-0">
				<!-- Mobile Table of Contents -->
				{
					headings.length > 0 && (
						<div class="mb-8 block lg:hidden">
							<TableOfContents headings={headings} lang="pt-BR" />
						</div>
					)
				}

				<!-- Article Body -->
				<div class="prose prose-neutral max-w-none font-outfit text-task-dark
					prose-headings:font-anton prose-headings:uppercase prose-headings:tracking-tight prose-headings:text-task-dark
					prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pt-4 prose-h2:border-t prose-h2:border-task-border/50
					prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
					prose-p:text-base prose-p:leading-relaxed prose-p:text-task-gray prose-p:my-4
					prose-li:text-task-gray prose-li:my-1
					prose-strong:text-task-dark prose-strong:font-semibold
					prose-a:text-task-dark prose-a:font-medium prose-a:underline prose-a:underline-offset-4 hover:prose-a:text-task-yellow
					prose-code:rounded prose-code:bg-task-bg prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-xs prose-code:text-task-dark prose-code:border prose-code:border-task-border/60
					prose-pre:rounded-xl prose-pre:border prose-pre:border-task-border prose-pre:bg-task-dark prose-pre:p-4
					prose-blockquote:border-l-4 prose-blockquote:border-task-yellow prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-task-gray"
				>
					<Content />
				</div>

				<!-- Tags -->
				{
					tags.length > 0 && (
						<div class="mt-12 flex flex-wrap items-center gap-2 border-t border-task-border pt-6">
							<span class="font-outfit text-xs font-semibold uppercase tracking-wider text-task-gray">
								Tags:
							</span>
							{tags.map((tag) => (
								<span class="rounded-lg border border-task-border bg-white px-2.5 py-1 font-outfit text-xs text-task-gray">
									#{tag}
								</span>
							))}
						</div>
					)
				}

				<!-- Article CTA Section -->
				<div class="mt-14">
					<ArticleCTA category={category} lang="pt-BR" />
				</div>
			</div>

			<!-- Desktop Sticky Sidebar -->
			<aside class="hidden lg:block">
				<div class="sticky top-28 space-y-6">
					{headings.length > 0 && (
						<TableOfContents headings={headings} lang="pt-BR" />
					)}

					<!-- Mini Author Bio Card -->
					<div class="rounded-2xl border border-task-border bg-white/70 p-5 shadow-2xs">
						<div class="flex items-center gap-3">
							<Image
								src={authorAvatar}
								alt="Gabriel Campos"
								width={40}
								height={40}
								class="size-10 rounded-full object-cover border border-task-border"
							/>
							<div>
								<div class="font-outfit text-xs font-bold text-task-dark uppercase">
									Gabriel Campos
								</div>
								<div class="font-outfit text-[11px] text-task-gray">
									Engenharia de Software
								</div>
							</div>
						</div>
						<p class="mt-3 font-outfit text-xs text-task-gray leading-relaxed">
							Engenheiro de software especializado em sistemas web de alta performance, arquitetura escalável e integrações sob medida.
						</p>
						<a
							href="/pt/#contato"
							class="mt-4 block rounded-lg bg-task-dark py-2 text-center font-outfit text-xs font-semibold text-white transition-colors hover:bg-black"
						>
							Entrar em contato
						</a>
					</div>
				</div>
			</aside>
		</div>

		<!-- Related Articles Section -->
		{
			relatedPosts.length > 0 && (
				<section class="mt-20 border-t border-task-border pt-12" aria-labelledby="related-heading">
					<div class="flex items-center justify-between">
						<div>
							<div class="font-mono text-xs uppercase tracking-wider text-task-gray">
								CONTINUE LENDO
							</div>
							<h2 id="related-heading" class="mt-1 font-anton text-2xl uppercase tracking-tight text-task-dark sm:text-3xl">
								Artigos Relacionados
							</h2>
						</div>
						<a
							href="/pt/blog"
							class="hidden sm:inline-flex items-center gap-1 font-outfit text-sm font-semibold text-task-dark hover:underline"
						>
							Ver todos →
						</a>
					</div>

					<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
						{relatedPosts.map((related) => (
							<BlogCard post={related} />
						))}
					</div>
				</section>
			)
		}
	</article>
</PageLayout>
