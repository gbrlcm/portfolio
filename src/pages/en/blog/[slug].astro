---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import PageLayout from '../../../layouts/PageLayout.astro';
import Breadcrumbs from '../../../components/blog/Breadcrumbs.astro';
import TableOfContents from '../../../components/blog/TableOfContents.astro';
import ArticleCTA from '../../../components/blog/ArticleCTA.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import authorAvatar from '../../../assets/images/avatar.webp';
import {
	getPostSlug,
	getPostUrl,
	getPostAbsoluteUrl,
	getBlogPostsByLang,
	getPostTranslations,
	getPostHreflangs,
	validateBlogCollection,
} from '../../../lib/blog';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog', ({ data }) => !data.draft);
	validateBlogCollection(allPosts);
	const enPosts = getBlogPostsByLang(allPosts, 'en');

	return enPosts.map((post) => ({
		params: { slug: getPostSlug(post) },
		props: { post, allPosts },
	}));
}

export interface Props {
	post: CollectionEntry<'blog'>;
	allPosts: CollectionEntry<'blog'>[];
}

const { post, allPosts } = Astro.props;
const {
	title,
	description,
	pubDate,
	updatedDate,
	author,
	cover,
	coverAlt,
	category,
	tags,
} = post.data;

const { Content, headings } = await render(post);

// Find related articles within English
const enPosts = getBlogPostsByLang(allPosts, 'en');
const relatedPosts = enPosts
	.filter((p) => p.id !== post.id)
	.sort((a, b) => {
		const aScore =
			(a.data.category === category ? 2 : 0) +
			a.data.tags.filter((t) => tags.includes(t)).length;
		const bScore =
			(b.data.category === category ? 2 : 0) +
			b.data.tags.filter((t) => tags.includes(t)).length;
		return bScore - aScore;
	})
	.slice(0, 2);

// Date formatting in English
const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('en-US', {
		day: '2-digit',
		month: 'long',
		year: 'numeric',
	}).format(date);

const publishedDateFormatted = formatDate(pubDate);
const updatedDateFormatted = updatedDate ? formatDate(updatedDate) : null;

const words: number = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readTimeMinutes: number = Math.max(1, Math.ceil(words / 200));

const siteUrl = 'https://gabrielcampos.dev';
const canonicalUrl: string = getPostAbsoluteUrl(post, siteUrl);
const ogImage: string = cover
	? cover.startsWith('http')
		? cover
		: `${siteUrl}${cover}`
	: `${siteUrl}/images/og-image.jpg`;

const translations = getPostTranslations(post, allPosts);
const hreflangs = getPostHreflangs(post, allPosts, siteUrl);

const customLanguageUrls = {
	'pt-BR': translations.find((t) => t.lang === 'pt-BR')?.url ?? '/blog',
	en: getPostUrl(post),
	es: translations.find((t) => t.lang === 'es')?.url ?? '/es/blog',
};

const schemaGraph = [
	{
		'@type': 'BlogPosting',
		'@id': `${canonicalUrl}#article`,
		isPartOf: {
			'@id': `${siteUrl}/#website`,
		},
		headline: title,
		description: description,
		inLanguage: 'en',
		mainEntityOfPage: canonicalUrl,
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate || pubDate).toISOString(),
		author: {
			'@type': 'Person',
			'@id': `${siteUrl}/#person`,
			name: author,
			url: `${siteUrl}/en/`,
		},
		publisher: {
			'@type': 'Person',
			'@id': `${siteUrl}/#person`,
			name: 'Gabriel Campos',
		},
		image: ogImage,
		keywords: tags.join(', '),
		articleSection: category,
	},
	{
		'@type': 'BreadcrumbList',
		'@id': `${canonicalUrl}#breadcrumb`,
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: `${siteUrl}/en/`,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Blog',
				item: `${siteUrl}/en/blog`,
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: title,
				item: canonicalUrl,
			},
		],
	},
];
---

<PageLayout
	lang="en"
	title={`${title} — Gabriel Campos`}
	description={description}
	image={cover ?? '/images/og-image.jpg'}
	ogType="article"
	articleMeta={{
		publishedTime: pubDate.toISOString(),
		modifiedTime: (updatedDate || pubDate).toISOString(),
		author,
		section: category,
		tags,
	}}
	schemaGraph={schemaGraph}
	customHreflangs={hreflangs}
	customLanguageUrls={customLanguageUrls}
>
	<article class="mx-auto w-full max-w-6xl px-5 pt-8 pb-20 sm:pt-12 sm:pb-28 md:px-8 lg:px-2">
		<!-- Top Navigation & Breadcrumbs -->
		<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<Breadcrumbs
				items={[
					{ label: 'Home', href: '/en/' },
					{ label: 'Blog', href: '/en/blog' },
					{ label: title },
				]}
			/>

			<a
				href="/en/blog"
				class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-outfit font-medium text-task-gray transition-colors hover:text-task-dark"
			>
				<Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
				<span>Back to blog</span>
			</a>
		</div>

		<!-- Article Header -->
		<header>
			<!-- Meta badge, reading time & optional translations -->
			<div class="flex flex-wrap items-center gap-2.5 text-xs sm:text-sm">
				<span class="relative inline-flex items-center pl-2.5 py-1 uppercase tracking-wider font-bold">
					<span
						class="absolute left-0 bottom-1 h-3 w-1 rounded-full bg-task-yellow"
						aria-hidden="true"
					></span>
					{category}
				</span>
				<span class="text-task-gray/60">·</span>
				<span class="font-outfit text-task-gray font-medium">
					{readTimeMinutes} min read
				</span>
			</div>

			{
				translations.length > 0 && (
					<div class="mt-3 inline-flex flex-wrap items-center gap-2 rounded-xl border border-task-border/80 bg-white/70 px-3.5 py-1.5 text-xs font-outfit text-task-gray">
						<Icon name="lucide:languages" class="size-3.5 text-task-dark" aria-hidden="true" />
						<span>Also available in:</span>
						<div class="flex items-center gap-1.5 font-medium">
							{translations.map((tr) => (
								<a
									href={tr.url}
									class="inline-flex items-center gap-1 rounded-md border border-task-border bg-task-bg px-2 py-0.5 text-task-dark transition-colors hover:bg-task-yellow hover:text-black"
								>
									<span>{tr.label}</span>
									<span class="text-[10px] text-task-gray/80">({tr.lang.toUpperCase()})</span>
								</a>
							))}
						</div>
					</div>
				)
			}

			<!-- Main Title -->
			<h1 class="mt-4 font-anton text-3xl uppercase tracking-tight text-task-dark sm:text-5xl lg:text-6xl leading-[1.1]">
				{title}
			</h1>

			<!-- Description Lead -->
			<p class="mt-4 font-outfit text-lg sm:text-xl text-task-gray leading-relaxed">
				{description}
			</p>

			<!-- Author and Publish Date Bar -->
			<div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-4 text-xs sm:text-sm font-outfit">
				<div class="flex items-center gap-3.5">
					<Image
						src={authorAvatar}
						alt={author}
						width={56}
						height={56}
						densities={[1, 2]}
						class="size-13 sm:size-14 rounded-full object-cover shadow-xs border border-task-border/60"
						loading="eager"
						decoding="async"
					/>
					<div>
						<div class="text-sm sm:text-base font-semibold text-task-dark">{author}</div>
						<div class="text-task-gray text-xs">Software Engineer</div>
					</div>
				</div>

				<div class="flex flex-col sm:items-end text-task-gray text-xs sm:text-sm">
					<div>
						Published on <time datetime={pubDate.toISOString()} class="font-medium text-task-dark">{publishedDateFormatted}</time>
					</div>
					{
						updatedDateFormatted && (
							<div class="text-[11px] sm:text-xs text-task-gray/80">
								Updated on {updatedDateFormatted}
							</div>
						)
					}
				</div>
			</div>
		</header>

		<!-- Article Hero Cover -->
		{
			cover && (
				<div class="mt-8 overflow-hidden rounded-2xl sm:rounded-3xl border border-task-border bg-task-border/30 shadow-md">
					<img
						src={cover}
						alt={coverAlt ?? title}
						width="1200"
						height="630"
						loading="eager"
						decoding="async"
						class="w-full h-auto max-h-125 object-cover"
					/>
				</div>
			)
		}

		<!-- Main Layout: Content Body + Sidebar TOC -->
		<div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-10">
			<!-- Article Body -->
			<div class="lg:col-span-8 min-w-0">
				<!-- Mobile TOC (when headings exist) -->
				{
					headings.length > 0 && (
						<div class="mb-8 lg:hidden">
							<TableOfContents headings={headings} lang="en" />
						</div>
					)
				}

				<!-- Prose Content rendered from Markdown -->
				<div class="prose-blog">
					<Content />
				</div>

				<!-- Tags & Category Footer -->
				{
					tags.length > 0 && (
						<div class="mt-12 flex flex-wrap items-center gap-2 border-t border-task-border pt-6">
							<span class="font-outfit text-xs font-semibold uppercase tracking-wider text-task-gray">
								Tags:
							</span>
							{tags.map((tag) => (
								<span class="rounded-lg border border-task-border bg-white px-3 py-1 font-outfit text-xs font-medium text-task-dark shadow-2xs">
									#{tag}
								</span>
							))}
						</div>
					)
				}

				<!-- Contextual High-Converting CTA -->
				<div class="mt-12">
					<ArticleCTA category={category} lang="en" />
				</div>

				<!-- Return Link -->
				<div class="mt-10 flex items-center justify-between pt-6">
					<a
						href="/en/blog"
						class="inline-flex items-center gap-2 font-outfit text-sm font-semibold text-task-dark transition-colors hover:text-[#184a34]"
					>
						<Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
						<span>Back to all articles</span>
					</a>
				</div>
			</div>

			<!-- Desktop Sticky Sidebar -->
			<aside class="hidden lg:col-span-4 lg:block">
				<div class="sticky top-28 space-y-6">
					<TableOfContents headings={headings} lang="en" />

					<!-- Quick Contact Author Card -->
					<div class="rounded-2xl border border-task-border bg-white p-6 shadow-2xs">
						<div class="flex items-center gap-3">
							<span class="flex size-11 items-center justify-center rounded-xl bg-task-dark font-anton text-lg text-task-yellow">
								GC
							</span>
							<div>
								<h3 class="font-anton text-base uppercase text-task-dark">
									Gabriel Campos
								</h3>
								<p class="font-outfit text-xs text-task-gray">
									Software Engineering & Systems
								</p>
							</div>
						</div>
						<p class="mt-3 font-outfit text-xs text-task-gray leading-relaxed">
							Custom web software engineering, API integrations, and operational stability.
						</p>
						<a
							href="/en/#services"
							class="mt-4 inline-flex w-full items-center justify-center gap-1.5 rounded-xl border border-task-border bg-task-bg px-4 py-2 font-outfit text-xs font-semibold text-task-dark transition-colors hover:bg-task-border/40"
						>
							<span>View services</span>
							<Icon name="lucide:arrow-up-right" class="size-3.5" />
						</a>
					</div>
				</div>
			</aside>
		</div>

		<!-- Related Articles Section -->
		{
			relatedPosts.length > 0 && (
				<section class="mt-20 border-t border-task-border pt-12" aria-labelledby="related-heading">
					<div class="flex items-center justify-between">
						<div>
							<div class="font-mono text-xs uppercase tracking-wider text-task-gray">
								CONTINUE READING
							</div>
							<h2 id="related-heading" class="mt-1 font-anton text-2xl uppercase tracking-tight text-task-dark sm:text-3xl">
								Related Articles
							</h2>
						</div>
						<a
							href="/en/blog"
							class="hidden sm:inline-flex items-center gap-1 font-outfit text-sm font-semibold text-task-dark hover:underline"
						>
							View all →
						</a>
					</div>

					<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
						{relatedPosts.map((related) => (
							<BlogCard post={related} />
						))}
					</div>
				</section>
			)
		}
	</article>
</PageLayout>
